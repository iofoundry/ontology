		<iof-av:wasMovedOn>2026-07-10T12:41:00</iof-av:wasMovedOn>
	</owl:Axiom>
	<owl:Axiom>
		<owl:annotatedProperty rdf:resource="&iof-av;wasDefinedBy"/>
		<owl:annotatedSource rdf:resource="&iof-construct;ProvenAcceptableRangeValueExpression"/>
		<owl:annotatedTarget></owl:annotatedTarget>
		<iof-av:wasMovedFrom>https://spec.industrialontologies.org/ontology/biopharma/BiopharmaParameter/</iof-av:wasMovedFrom>
