<https://spec.industrialontologies.org/ontology/tea/core#EngineeredSystemRequirementSpecification>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/core/Core/RequirementSpecification>;
  <http://purl.org/dc/terms/title> "engineered system requirement specification";
  <http://www.w3.org/2004/02/skos/core#altLabel> "SysRS";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "A formal document that defines a system's functional capabilities, performance levels, quality attributes, and operational constraints. It acts as a clear agreement and technical blueprint for hardware, software, and human processes before design begins.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://sebokwiki.org/wiki/System_Requirements_Definition" .

<https://spec.industrialontologies.org/ontology/tea/core#EnergyIntensity> a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/tea/core#ImpactIndicator>;
  <http://purl.org/dc/terms/title> "energy intensity";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "total energy consumed divided by total product produced";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://www.energy.gov/cmei/energy-intensity-indicators" .

<https://spec.industrialontologies.org/ontology/tea/core#MaterialEfficiency> a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/tea/core#ImpactIndicator>;
  <http://purl.org/dc/terms/title> "material efficiency";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "the ratio of output of products to input of raw materials";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://www.iec.ch/blog/circular-economy-understanding-material-efficiency" .

<https://spec.industrialontologies.org/ontology/tea/core#WaterConsumption> a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/tea/core#ImpactIndicator>;
  <http://purl.org/dc/terms/title> "water consumption";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "Quantifying a product's total freshwater footprint, including direct and indirect water use and impacts on water availability and quality across its entire lifecycle";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://www.sciencedirect.com/topics/engineering/water-footprint" .

<https://spec.industrialontologies.org/ontology/tea/core#FunctionalUnit> a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/core/Core/ValueExpression>;
  <http://purl.org/dc/terms/title> "functional unit";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "A quantitative expression of the product being studied, addressing the function, the quantity, the performance, and the time. The functional unit is the same across alternatives being studied.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://consequential-lca.org/clca/the-functional-unit/define-the-functional-unit/" .

<https://spec.industrialontologies.org/ontology/tea/core#ProgramOperatorRole> a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/core/Core/AgentRole>;
  <http://purl.org/dc/terms/title> "program operator role";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "Role of the entity that manages environmental labeling, product certification standards, or specific software automation tasks depending on the industry context.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://www.nsf.org/knowledge-library/nsf-trusted-pcr-lca-epd-program-operator" .

