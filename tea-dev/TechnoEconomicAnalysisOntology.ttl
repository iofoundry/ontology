    "https://www.iso.org/obp/ui#iso:std:iso:ts:14076:ed-1:v1:en" .

<https://spec.industrialontologies.org/ontology/mpdo/core#BasisOfProduction> a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/core/Core/ValueExpression>;
  <http://purl.org/dc/terms/title> "basis of production";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "A quantified performance of a process system, reflecting its specific scale, size or rate";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://www.iso.org/obp/ui#iso:std:iso:ts:14076:ed-1:v1:en" .

<https://spec.industrialontologies.org/ontology/mpdo/core#ProcessSystemSpecification>
  <http://purl.org/dc/terms/title> "process system" .

<https://spec.industrialontologies.org/ontology/mpdo/core#ReferenceFlowRole> a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/lca/core#FlowRole>;
  <http://purl.org/dc/terms/title> "reference flow role";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "Measure of the outputs from processes in a given product system required to fulfill the function expressed by the functional unit";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://www.sciencedirect.com/topics/engineering/reference-flow" .

<https://spec.industrialontologies.org/ontology/mpdo/core#ReferenceFlowIdentification>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/tea/core#FlowIdentification>;
  <http://purl.org/dc/terms/title> "reference flow identification";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "Identification of abstractions of product flows from an abstract functional unit, to allow for comparisons between product alternatives";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://pmc.ncbi.nlm.nih.gov/articles/PMC5812692/" .

<https://spec.industrialontologies.org/ontology/mpdo/core#ProcessSystemProcess> a
    <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/core/Core/BusinessProcess>,
    _:genid-9628c04a10984111bb105497106a75ac136-C9AACE4502D73B1C2B1FE88182A2D84A;
  <http://purl.org/dc/terms/title> "process system process";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "System of one or more interlinked unit processes over which the business unit has control";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://www.iso.org/obp/ui#iso:std:iso:ts:14076:ed-1:v1:en" .

<https://spec.industrialontologies.org/ontology/mpdo/core#ProductSystemProcess> a
    <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/core/Core/BusinessProcess>;
  <http://purl.org/dc/terms/title> "product system process";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "collection of unit processes with elementary and product flows, performing one or more defined functions, and which models the production of a product ";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://www.iso.org/obp/ui#iso:std:iso:ts:14076:ed-1:v1:en";
  <http://www.w3.org/2002/07/owl#equivalentClass> <https://spec.industrialontologies.org/ontology/core/Core/ProductProductionProcess> .

<https://spec.industrialontologies.org/ontology/mpdo/core#TechnosphereFlowIdentification>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/tea/core#FlowIdentification>;
  <http://purl.org/dc/terms/title> "technosphere flow identification";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "The process of mapping and categorizing internal material, energy, and product exchanges that occur entirely within human-made industrial, economic, and product systems";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://pmc.ncbi.nlm.nih.gov/articles/PMC5812692/" .

<https://spec.industrialontologies.org/ontology/mpdo/core#ElementaryFlowIdentification>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/tea/core#FlowIdentification>;
  <http://purl.org/dc/terms/title> "elementary flow identification";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "Identifying material or energy inputs from or releases to the environment (such as carbon dioxide emissions or water extraction) without prior human transformation";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://pmc.ncbi.nlm.nih.gov/articles/PMC5812692/" .

<https://spec.industrialontologies.org/ontology/mpdo/core#ElementaryFlowRole> a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/lca/core#FlowRole>;
  <http://purl.org/dc/terms/title> "elementary flow role";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "Raw resources drawn directly from the environment without prior human transformation (like crude oil in the ground) or emissions released directly back into environmental media (like carbon dioxide into the air) without subsequent treatment.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://helpcenter.ecochain.com/en/articles/9952608-explained-elementary-flows" .

<https://spec.industrialontologies.org/ontology/mpdo/core#TechnosphereFlowRole> a
    <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/lca/core#FlowRole>;
  <http://purl.org/dc/terms/title> "technosphere flow role";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "Role of an entity in an internal exchange of goods, materials, or energy between human-made industrial, economic, or technological processes within a life cycle assessment model.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://pmc.ncbi.nlm.nih.gov/articles/PMC5812692/" .

<https://spec.industrialontologies.org/ontology/mpdo/core#RateOfReturn> a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/core/Core/ValueExpression>;
  <http://purl.org/dc/terms/title> "rate of return";
  <http://www.w3.org/2004/02/skos/core#altLabel> "RoR";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "net gain or loss on an investment over a specified time period, expressed as a percentage of the investment's initial cost or value as of a specific point in time";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/RateOfReturn" .

<https://spec.industrialontologies.org/ontology/mpdo/core#InternalRateOfReturn> a
    <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/mpdo/core#RateOfReturn>;
  <http://purl.org/dc/terms/title> "internal rate of return";
  <http://www.w3.org/2004/02/skos/core#altLabel> "IRR";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "discount rate that results in a net present value (NPV) of zero for a series of future cash flows ";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/InternalRateOfReturn" .

<https://spec.industrialontologies.org/ontology/mpdo/core#PresentValue> a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/core/Core/ValueExpression>;
  <http://purl.org/dc/terms/title> "present value";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "value of an asset today, which may be calculated from reference data and may based on its expected future value";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/PresentValue" .

<https://spec.industrialontologies.org/ontology/mpdo/core#NetPresentValue> a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/mpdo/core#PresentValue>;
  <http://purl.org/dc/terms/title> "net present value";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "The current value of all future cash flows from a project or investment minus the initial cost";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://www.investopedia.com/terms/n/npv.asp" .

<https://spec.industrialontologies.org/ontology/mpdo/core#TechnicalRequirementsSpecification>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/core/Core/RequirementSpecification>;
  <http://purl.org/dc/terms/title> "technical requirements specification";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "A formal document that explains how a system, product, or software feature will be built. It bridges business goals and engineering execution, serving as a clear blueprint for developers, testers, and project managers.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://ecss.nl/standard/ecss-e-st-10-06c-technical-requirements-specification/" .

<https://spec.industrialontologies.org/ontology/mpdo/core#RiskAnalysisSpecification>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/tea/core#AnalysisSpecification>,
    _:genid-9628c04a10984111bb105497106a75ac136-BFEB17EE4244E59569A0EA952015D2F0, _:genid-9628c04a10984111bb105497106a75ac136-8906D125F74023AEC00B2B69CC7B3E38;
  <http://purl.org/dc/terms/title> "risk analysis specification";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "A formal document outlining how an organization identifies, evaluates, and measures potential threats and vulnerabilities. It defines the scope, criteria, methods (qualitative or quantitative), and assigned responsibilities needed to determine risk levels and guide mitigation.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://csrc.nist.gov/glossary/term/risk_analysis" .

<https://spec.industrialontologies.org/ontology/mpdo/core#Income> a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/core/Core/ValueExpression>;
  <http://purl.org/dc/terms/title> "income";
  <http://www.w3.org/2004/02/skos/core#altLabel> "revenue stream";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "revenue received during a period of time";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/AccountingEquity/Income" .

<https://spec.industrialontologies.org/ontology/mpdo/core#RiskAssessmentProcess> a
    <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/tea/core#AssessmentProcess>,
    _:genid-9628c04a10984111bb105497106a75ac136-4213918E3B77391105AD6F4F249C5E12;
  <http://purl.org/dc/terms/title> "risk assessment process";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "An evaluation of the plan specification laid out in the risk analysis specification.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://csrc.nist.gov/glossary/term/risk_analysis" .

<https://spec.industrialontologies.org/ontology/mpdo/core#RiskMitigationSpecification>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/tea/core#AnalysisSpecification>,
    _:genid-9628c04a10984111bb105497106a75ac136-8296D7794CDFCFEAFD5605909586F9F5, _:genid-9628c04a10984111bb105497106a75ac136-317D6D345D1B6FF8AA8921194C361D57;
  <http://purl.org/dc/terms/title> "risk mitigation specification";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "A formal document that defines how a project or organization will identify, evaluate, and reduce threats to an acceptable level. It outlines specific controls, actionable tasks, assigned owners, and tracking procedures required to protect operations.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://softcomply.com/write-risk-mitigation-requirement/" .

<https://spec.industrialontologies.org/ontology/mpdo/core#RiskMitigationAssessmentProcess>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/tea/core#AssessmentProcess>,
    _:genid-9628c04a10984111bb105497106a75ac136-5D8D00873BF5F2172D5D51EC0BE30E8C;
  <http://purl.org/dc/terms/title> "risk mitigation assessment process";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "An evaluation of the plan specification laid out in the risk mitigation specification.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://softcomply.com/write-risk-mitigation-requirement/" .

<https://spec.industrialontologies.org/ontology/mpdo/core#FinancialViabilityAnalysisSpecification>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/tea/core#AnalysisSpecification>,
    _:genid-9628c04a10984111bb105497106a75ac136-7B56D992E388C65419AB312CB47B0BE1, _:genid-9628c04a10984111bb105497106a75ac136-AA1571E3435B87D54D9DA610B0FBA239;
  <http://purl.org/dc/terms/title> "financial viability analysis specification";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "The criteria, metrics, and thresholds used to evaluate whether a project, business, or contractor has sufficient financial resources, liquidity, and profit potential to survive long-term and fulfill its obligations. It sets the standards for solvency, cash flow, and risk management.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://www.finance.gov.au/government/procurement/buying-australian-government/assessing-financial-viability" .

<https://spec.industrialontologies.org/ontology/mpdo/core#FinancialAchievabilityAssessmentProcess>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/tea/core#AssessmentProcess>;
  <http://purl.org/dc/terms/title> "financial achievability assessment process";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "An evaluation of the plan specification laid out in the financial achievability specification.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://rosap.ntl.bts.gov/view/dot/72276" .

<https://spec.industrialontologies.org/ontology/mpdo/core#ExpenseAnalysisSpecification>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/tea/core#AnalysisSpecification>,
    _:genid-9628c04a10984111bb105497106a75ac136-2090F96782109482BDD9A7237989FF50;
  <http://purl.org/dc/terms/title> "expense analysis specification";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "A formal document outlining how an organization collects, categorizes, evaluates, and reports its financial costs. It sets rules for tracking cash flow, finding spending patterns, measuring variances against budgets, and ensuring data consistency across business units.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://www.hyperbots.com/glossary/expense-analysis" .

<https://spec.industrialontologies.org/ontology/mpdo/core#ExpenseAssessmentProcess>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/tea/core#AssessmentProcess>,
    _:genid-9628c04a10984111bb105497106a75ac136-88B065DE51B7B038E24CAEF303482CFB;
  <http://purl.org/dc/terms/title> "expense assessment process";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "An evaluation of the plan specification laid out in the expense analysis specification.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://www.hyperbots.com/glossary/expense-analysis" .

<https://spec.industrialontologies.org/ontology/mpdo/core#ProblemDefintion> a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/tea/core#AnalysisObjectiveSpecification>,
    _:genid-9628c04a10984111bb105497106a75ac136-841906ADCB83303E7C7EDE531C41A1B3, _:genid-9628c04a10984111bb105497106a75ac136-FD22CBF5637EAE4A12ABE36B77F7FED4;
  <http://purl.org/dc/terms/title> "problem defintion";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "Clear and formal document that defines what is broken, who it affects, and what a successful outcome looks like, setting precise project boundaries and metrics before any design or engineering work begins.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://highbridgeacademy.com/a-primer-on-defining-problems-the-foundation-of-effective-problem-solving/" .

<https://spec.industrialontologies.org/ontology/mpdo/core#GapObjectiveSpecification>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/tea/core#AnalysisObjectiveSpecification>;
  <http://purl.org/dc/terms/title> "gap objective specification";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "The target goals, current operational baseline, and specific variances between an organization’s present performance and its strategic ambitions. ";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://en.wikipedia.org/wiki/Gap_analysis" .

<https://spec.industrialontologies.org/ontology/mpdo/core#GapAnalysisSpecification>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/tea/core#AnalysisSpecification>,
    _:genid-9628c04a10984111bb105497106a75ac136-B32DE888B2D35D1C5E1AF5E943D8EE87, _:genid-9628c04a10984111bb105497106a75ac136-04D5C705DB0B500D4A43D58F1B004778,
    _:genid-9628c04a10984111bb105497106a75ac136-1683325860B3A85AAB7B83BF49B5D16C;
  <http://purl.org/dc/terms/title> "gap analysis specification";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "A formal document outlining how an organization will compare its current performance, capabilities, or compliance levels against a desired future target or standard. It defines the scope, metrics, data sources, and procedures needed to identify shortfalls and build a corrective action plan.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://en.wikipedia.org/wiki/Gap_analysis" .

<https://spec.industrialontologies.org/ontology/mpdo/core#ProblemDefinitionAssessmentProcess>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/tea/core#AssessmentProcess>,
    _:genid-9628c04a10984111bb105497106a75ac136-EEA1E78552DB2D340C5491C0FAC4C2B6;
  <http://purl.org/dc/terms/title> "problem definition assessment process";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "An evaluation of the plan specification laid out in the problem definition analysis objectve specification.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://highbridgeacademy.com/a-primer-on-defining-problems-the-foundation-of-effective-problem-solving/" .

<https://spec.industrialontologies.org/ontology/mpdo/core#GapAssessmentProcess> a
    <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/tea/core#AssessmentProcess>,
    _:genid-9628c04a10984111bb105497106a75ac136-7FE8519BABFC77E80DEE0680269953FA;
  <http://purl.org/dc/terms/title> "gap assessment process";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "An evaluation of the plan specification laid out in the gap analysis specification.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://en.wikipedia.org/wiki/Gap_analysis" .

<https://spec.industrialontologies.org/ontology/mpdo/core#prescribedToPrecede> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
  <http://purl.org/dc/terms/title> "prescribed to precede";
  <http://www.w3.org/2000/01/rdf-schema#range> <http://purl.obolibrary.org/obo/BFO_0000002>;
  <http://www.w3.org/2000/01/rdf-schema#domain> <http://purl.obolibrary.org/obo/BFO_0000002> .

<https://spec.industrialontologies.org/ontology/mpdo/core#FinancialAchievabilitySpecification>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/tea/core#AnalysisSpecification>,
    _:genid-9628c04a10984111bb105497106a75ac136-A62DFFE2D740416EFCC45AD49B4A2D2A;
  <http://purl.org/dc/terms/title> "financial achievability specification";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "The metrics, costs, and funding criteria used to prove a project, contract, or goal is realistic and affordable. It defines minimum capital requirements, expected cash flows, and risk boundaries to verify that an individual or business can fully fund commitments without defaulting.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://rosap.ntl.bts.gov/view/dot/72276" .

<https://spec.industrialontologies.org/ontology/mpdo/core#FinancialViabilityAssessmentProcess>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/tea/core#AssessmentProcess>,
    _:genid-9628c04a10984111bb105497106a75ac136-A3F8A90EED79EC6731F9870E651CD816;
  <http://purl.org/dc/terms/title> "financial viability assessment process";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "An evaluation of the plan specification laid out in the financial viability specification.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://www.finance.gov.au/government/procurement/buying-australian-government/assessing-financial-viability" .

<https://spec.industrialontologies.org/ontology/mpdo/core#MinimumSellingPrice> a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/core/Core/ValueExpression>;
  <http://purl.org/dc/terms/title> "minimum selling price";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "The lowest amount a seller will accept for a product or service. It covers all production, operational, and marketplace fees so the business avoids a loss. In auctions, this concept functions as a hidden reserve price.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://www.channelengine.com/en/blog/how-to-set-minimum-price-marketplaces" .

<https://spec.industrialontologies.org/ontology/mpdo/core#MinimumEthanolSellingPrice>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/mpdo/core#MinimumSellingPrice>;
  <http://purl.org/dc/terms/title> "minimum ethanol selling price";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "The lowest amount a seller will accept for a liter of ethanol.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://link.springer.com/article/10.1186/1754-6834-5-69" .

<https://spec.industrialontologies.org/ontology/mpdo/core#CapitalInvestment> a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/core/Core/ValueExpression>;
  <http://purl.org/dc/terms/title> "capital investment";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "Money a business or individual spends to acquire, upgrade, or maintain long-term physical assets—such as buildings, machinery, land, or technology—with the goal of boosting future growth, efficiency, and profits";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://www.investopedia.com/terms/c/capital-investment.asp" .

<https://spec.industrialontologies.org/ontology/mpdo/core#FixedCapitalInvestment>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/mpdo/core#CapitalInvestment>;
  <http://purl.org/dc/terms/title> "fixed capital investment";
  <http://www.w3.org/2004/02/skos/core#altLabel> "FCI";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "Money a business spends on long-term physical assets like land, buildings, and machinery to build and grow its operations. These durable items are not used up during daily production";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://corporatefinanceinstitute.com/resources/accounting/fixed-capital/" .

<https://spec.industrialontologies.org/ontology/mpdo/core#WorkingCapitalInvestment>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/mpdo/core#CapitalInvestment>;
  <http://purl.org/dc/terms/title> "working capital investment";
  <http://www.w3.org/2004/02/skos/core#altLabel> "WCI";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "Money a business puts into its short-term assets like inventory and cash to fund daily operations, calculated by subtracting current liabilities from current assets.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://corporatefinanceinstitute.com/resources/accounting/working-capital-vs-investing-capital/" .

<https://spec.industrialontologies.org/ontology/mpdo/core#TotalCapitalInvestment>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/mpdo/core#CapitalInvestment>,
    _:genid-9628c04a10984111bb105497106a75ac136-AF6FA0A2030A01AD97E98C6C440B3862, _:genid-9628c04a10984111bb105497106a75ac136-D0397E7B466DF1F0528993072AF9EE6B;
  <http://purl.org/dc/terms/title> "total capital investment";
  <http://www.w3.org/2004/02/skos/core#altLabel> "TCI";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/explanatoryNote>
    "total capital investment = fixed capital investment      working capital investment";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "The total amount of money needed to build, start, and run a new project or business asset until it begins normal work." .

<https://spec.industrialontologies.org/ontology/mpdo/core#CoproductIncome> a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/mpdo/core#Income>;
  <http://purl.org/dc/terms/title> "co-product income";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "Revenue generated from selling secondary, valuable items produced simultaneously during the creation of a primary product.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://consequential-lca.org/clca/determining-or-dependent-co-products/" .

<https://spec.industrialontologies.org/ontology/mpdo/core#ProductionCost> a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/core/Core/ValueExpression>;
  <http://purl.org/dc/terms/title> "production cost";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "The total of all direct and indirect expenses a business incurs to manufacture a product or deliver a service";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://www.investopedia.com/terms/p/production-cost.asp" .

<https://spec.industrialontologies.org/ontology/mpdo/core#AnnualizedCapitalProductionCost>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/mpdo/core#ProductionCost>;
  <http://purl.org/dc/terms/title> "annualized capital production cost";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "The yearly equivalent expense of purchasing, financing, and maintaining long-term physical assets or equipment used in production.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://www.investopedia.com/terms/c/capitalexpenditure.asp" .

<https://spec.industrialontologies.org/ontology/mpdo/core#AnnualizedOperatingProductionCost>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/mpdo/core#ProductionCost>;
  <http://purl.org/dc/terms/title> "annualized operating production cost";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "The total yearly expense required to manufacture a product or run a production facility, combining both annual operating expenses and annualized capital costs";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://www.sciencedirect.com/topics/engineering/annual-operational-cost" .

<https://spec.industrialontologies.org/ontology/mpdo/core#ProductProduced> a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/core/Core/ValueExpression>;
  <http://purl.org/dc/terms/title> "product produced";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    " Tangible goods or intangible services for the market created from the systematic process of combining raw materials, labor, capital, and technology";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://www.jot.fm/issues/issue_2004_11/column7/" .

<https://spec.industrialontologies.org/ontology/mpdo/core#AnnualizedEthanolProduced>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/mpdo/core#ProductProduced>;
  <http://purl.org/dc/terms/title> "annualized ethanol produced";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "Annualized quantity for ethanol created from the systematic process of combining raw materials, labor, capital, and technology";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://ethanolrfa.org/markets-and-statistics/annual-ethanol-production" .

<https://spec.industrialontologies.org/ontology/mpdo/core#ChemcadProcessDesignEvaluationProcess>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/core/Core/ComputingProcess>;
  <http://purl.org/dc/terms/title> "chemcad process design evaluation process";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "Evaluation that uses a software tool (ChemCAD) to build a steady-state or dynamic chemical simulation. Engineers select components and thermodynamic models, map out process flow diagrams (PFDs), specify equipment and stream parameters, run convergence checks, and evaluate system economics, energy efficiency, and safety constraints.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://www.datacor.com/products/chemcad" .

<https://spec.industrialontologies.org/ontology/mpdo/core#AspenPlusProcessDesignEvaluationProcess>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/core/Core/ComputingProcess>;
  <http://purl.org/dc/terms/title> "aspen plus process design evaluation process";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "Evaluation that uses a software tool (Aspen Plus) to build a steady-state simulation, mapping unit operations to equipment, and running integrated economic and energy assessments using tools like the Aspen Process Economic Analyzer to determine capital costs (CAPEX), operating costs (OPEX), and overall project profitability.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://www.aspentech.com/en" .

<https://spec.industrialontologies.org/ontology/mpdo/core#SuperproDesignerProcessDesignEvaluationProcess>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/core/Core/ComputingProcess>;
  <http://purl.org/dc/terms/title> "superpro designer process design evaluation process";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "Evaluation that uses a software tool (SuperPro Designer) to model, evaluate, and optimize batch and continuous processes in industries like biotech, pharma, food, and water treatment. It combines material and energy balancing, equipment sizing, project economic evaluation, and environmental impact assessment into one platform.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://www.intelligen.com/products/superpro-overview/" .

<https://spec.industrialontologies.org/ontology/mpdo/core#SensitivityProcessDesignAssessmentProcess>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/tea/core#AssessmentProcess>,
    _:genid-9628c04a10984111bb105497106a75ac136-138CE5C52C6FDF5A1BB00D0CC7F35736;
  <http://purl.org/dc/terms/title> "sensitivity process design assessment process";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "An evaluation of the plan specification laid out in the sensitivity analysis specification.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://design.cbe.cornell.edu/index.php?title=Sensitivity_analysis_and_design_optimization" .

<https://spec.industrialontologies.org/ontology/mpdo/core#SensitivityProcessDesignAnalysisSpecification>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/tea/core#AnalysisSpecification>,
    _:genid-9628c04a10984111bb105497106a75ac136-D4C1765C6699038391BB249B5D1EB93D, _:genid-9628c04a10984111bb105497106a75ac136-19D14844786902559EFA3BE7F97D5110,
    _:genid-9628c04a10984111bb105497106a75ac136-0C2E688EC8E95D6D8A7EBE9EFE1DD9A7;
  <http://purl.org/dc/terms/title> "sensitivity process design analysis specification";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "Analysis specification with systematic variance in inputs over a range to observe and graph the resulting changes in system outputs.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://design.cbe.cornell.edu/index.php?title=Sensitivity_analysis_and_design_optimization" .

