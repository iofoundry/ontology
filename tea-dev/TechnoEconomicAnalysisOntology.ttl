<https://spec.industrialontologies.org/ontology/mpdo/core#ProductYield> a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/core/Core/ValueExpression>;
  <http://purl.org/dc/terms/title> "product yield";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "percentage of the total raw materials or components that are successfully converted into finished products.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://umbrex.com/resources/industry-analyses/how-to-analyze-a-manufacturing-company/product-yield-and-scrap-rate-analysis/" .

<https://spec.industrialontologies.org/ontology/mpdo/core#ProductYieldCalculationFormula>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/core/Core/Algorithm>;
  <http://purl.org/dc/terms/title> "product yield calculation formula";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/explanatoryNote>
    "(Number of Good Units Produced / Total Units Started) x 100", "Formulate a stoichiometric equation and compute theoretical value for the mass of the output";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "Calculate the yield as a percentage of the total raw materials or components that are successfully converted into finished products. A high yield indicates that most of the raw material is being efficiently used to produce salable products.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://umbrex.com/resources/industry-analyses/how-to-analyze-a-manufacturing-company/product-yield-and-scrap-rate-analysis/" .

<https://spec.industrialontologies.org/ontology/mpdo/core#ProductYieldComputingProcess>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/core/Core/ComputingProcess>,
    _:genid-9628c04a10984111bb105497106a75ac136-3D849FAEF8B7BEF7362C958A934C3AD1;
  <http://purl.org/dc/terms/title> "product yield computing process";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "A computing process that concretizes the product yield calculation formula.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://umbrex.com/resources/industry-analyses/how-to-analyze-a-manufacturing-company/product-yield-and-scrap-rate-analysis/" .

<https://spec.industrialontologies.org/ontology/mpdo/core#CradletoCradleSystemBoundary>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/mpdo/core#SystemBoundaryProcess>,
    _:genid-9628c04a10984111bb105497106a75ac136-D8639E58B7049AADB9248511FC6ED9B2;
  <http://www.w3.org/2002/07/owl#disjointWith> <https://spec.industrialontologies.org/ontology/mpdo/core#CradletoGraveProcessBoundary>;
  <http://purl.org/dc/terms/title> "cradle-to-cradle system boundary";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "A system boundary process that evaluates a product from raw material extraction through its use and eventual recycling or repurposing into a new cycle, closing the loop instead of ending at disposal.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://go.ipoint-systems.com/blog/cradle-to-cradle" .

<https://spec.industrialontologies.org/ontology/mpdo/core#CradletoGateSystemBoundary>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/mpdo/core#SystemBoundaryProcess>;
  <http://purl.org/dc/terms/title> "cradle-to-gate system boundary";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "A system boundary process that measures a product's environmental impact from raw material extraction (the \"cradle\") up to the point it leaves the factory floor (the \"gate\")";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://go.ipoint-systems.com/blog/cradle-to-gate" .

<https://spec.industrialontologies.org/ontology/mpdo/core#SystemBoundaryProcess> a
    <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/core/Core/PlannedProcess>,
    _:genid-9628c04a10984111bb105497106a75ac136-6C523C4A44EF0D92517F28AE27A7DCD4, _:genid-9628c04a10984111bb105497106a75ac136-5A2500EA21A3B557C28A406D527A00D9;
  <http://purl.org/dc/terms/title> "system boundary process";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "A planned process with the delineation that defines what elements are included within a system and what elements are external to it. These boundaries help to focus on the relevant aspects of a system while treating external influences as remote phenomena.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://www.sciencedirect.com/topics/agricultural-and-biological-sciences/system-boundary" .

