<https://spec.industrialontologies.org/ontology/mpdo/core#EthanolCapacityImpactAssessment>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/tea/core#ImpactAssessment>,
    _:genid-9628c04a10984111bb105497106a75ac136-3F7268AC6199B85ED1979D623BCA9833;
  <http://purl.org/dc/terms/title> "ethanol capacity impact assessment";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "An impact assessment for the ethanol capacity of a parameter permutation evaluation";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "chrome-extension://efaidnbmnnnibpcajpcglclefindmkaj/https://ethanolrfa.org/file/2911/Economic Contribution of the Ethanol Industry in 2024 - WEB.pdf" .

<https://spec.industrialontologies.org/ontology/mpdo/core#Capacity> a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/core/Core/ValueExpression>;
  <http://purl.org/dc/terms/title> "capacity";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "The largest amount that something can hold or contain, or a person's mental and physical ability to do a task. It can also describe a specific job, role, or position";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://dictionary.cambridge.org/us/dictionary/english/capacity" .

<https://spec.industrialontologies.org/ontology/mpdo/core#EthanolCapacity> a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/mpdo/core#Capacity>;
  <http://purl.org/dc/terms/title> "ethanol capacity";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "The largest amount of ethanol that something can hold or contain. It can describe the level of production that a manufacturing facility can produce.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://en.wikipedia.org/wiki/Ethanol_fuel_in_the_United_States" .

<https://spec.industrialontologies.org/ontology/mpdo/core#ManufacturingFacilityLifetime>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/core/Core/TemporalDurationValueExpression>;
  <http://purl.org/dc/terms/title> "manufacturing facility lifetime";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "The lifespan of the manufacturing facility that involves the physical structure and the contents within. While the structure itself can last for a long time, the contents within need to change more rapidly due to functional obsolesence.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://xtdsteel.com/steel-structure-building/steel-building-service-life/" .

<https://spec.industrialontologies.org/ontology/mpdo/core#manufacturingFacility> a
    <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/physical/PhysicalSite>;
  <http://purl.org/dc/terms/title> "manufacturing facility";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "An industrial building or plant where raw materials or components are transformed into finished tangible goods through manual labor, machinery, or chemical processing";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://www.ornl.gov/advancedmanufacturing" .

<https://spec.industrialontologies.org/ontology/mpdo/core#manufacturingFacilityLifetimeAssessment>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/tea/core#ImpactAssessment>,
    _:genid-9628c04a10984111bb105497106a75ac136-05E1E515A2A34661F25DE212E5227B30;
  <http://purl.org/dc/terms/title> "manufacturing facility lifetime assessment";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "An impact assessment for the manufacturing facility lifetime of a parameter permutation evaluation";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://www.tunley-environmental.com/en/insights/life-cycle-assessment-in-manufacturing" .

<https://spec.industrialontologies.org/ontology/mpdo/core#manufacturingFacilityMaintenanceIntervalAssessment>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/tea/core#ImpactAssessment>,
    _:genid-9628c04a10984111bb105497106a75ac136-09BAED3BF44067B5BA6FDBA4B9F268A8;
  <http://purl.org/dc/terms/title> "manufacturing facility maintenance interval assessment";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "An impact assessment for the manufacturing facility maintenance interval of a parameter permutation evaluation";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://tractian.com/en/glossary/maintenance-interval" .

<https://spec.industrialontologies.org/ontology/mpdo/core#ParameterPermutationProcessDesign>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/core/Core/PlanSpecification>;
  <http://purl.org/dc/terms/title> "parameter permutation process design";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "A plan specification capturing performance metrics across an exhaustive grid of parameter variations. Instead of discarding non-optimal test results, it aggregates all simulation outputs to build statistical distribution profiles, mitigating data-mining bias and quantifying operational risk.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://papers.ssrn.com/sol3/papers.cfm?abstract_id=2423187";
  <http://www.w3.org/2002/07/owl#equivalentClass> _:genid-9628c04a10984111bb105497106a75ac136-E1B720642B9EBB473A4E65EA54AC5818 .

<https://spec.industrialontologies.org/ontology/mpdo/core#ParameterPermutationProcessDesignEvaluation>
  a <http://www.w3.org/2002/07/owl#Class>;
  <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://spec.industrialontologies.org/ontology/core/Core/PlannedProcess>,
    _:genid-9628c04a10984111bb105497106a75ac136-225D91FF9662BEA72F02F687D49B1D83;
  <http://purl.org/dc/terms/title> "parameter permutation process design evaluation ";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/naturalLanguageDefinition>
    "A planned process prescribed by a plan specification capturing performance metrics across an exhaustive grid of parameter variations. Instead of discarding non-optimal test results, it aggregates all simulation outputs to build statistical distribution profiles, mitigating data-mining bias and quantifying operational risk.";
  <https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/adaptedFrom>
    "https://papers.ssrn.com/sol3/papers.cfm?abstract_id=2423187" .

