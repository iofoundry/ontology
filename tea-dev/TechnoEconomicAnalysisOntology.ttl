<https://spec.industrialontologies.org/ontology/mpdo/core#hasCountry> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
  <http://purl.org/dc/terms/title> "hasCountry";
  <http://www.w3.org/2000/01/rdf-schema#range> <http://www.ontologyrepository.com/CommonCoreOntologies/Country>;
