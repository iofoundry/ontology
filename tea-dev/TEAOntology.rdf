	<BFO_0000117 xmlns="http://purl.obolibrary.org/obo/" rdf:resource="https://spec.industrialontologies.org/ontology/mpdo/core#SemiContinuousUnitProcedureDerivationProcess1"/>
	<BFO_0000117 xmlns="http://purl.obolibrary.org/obo/" rdf:resource="https://spec.industrialontologies.org/ontology/tea/core#SemiContinuousManufacturingExecution1"/>
