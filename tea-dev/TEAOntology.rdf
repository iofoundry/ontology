<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/tea/core#NetWasteCalculationFormula">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/Algorithm"/>
