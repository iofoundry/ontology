	<title xmlns="http://purl.org/dc/terms/">total capital investment assessment</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">An impact assessment for the total capital investment of a parameter permutation evaluation</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://www.sciencedirect.com/science/article/abs/pii/S1364032115004025</adaptedFrom>
</rdf:Description>

