	<title xmlns="http://purl.org/dc/terms/">minimum ethanol selling price impact assessment</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">An impact assessment for the minimum ethanol selling price of a parameter permutation evaluation</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://www.sciencedirect.com/science/article/abs/pii/S1364032122006037</adaptedFrom>
</rdf:Description>

