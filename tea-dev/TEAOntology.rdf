</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#ProductYield">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ValueExpression"/>
	<title xmlns="http://purl.org/dc/terms/">product yield</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">percentage of the total raw materials or components that are successfully converted into finished products.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://umbrex.com/resources/industry-analyses/how-to-analyze-a-manufacturing-company/product-yield-and-scrap-rate-analysis/</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#ProductYieldCalculationFormula">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/Algorithm"/>
	<title xmlns="http://purl.org/dc/terms/">product yield calculation formula</title>
	<explanatoryNote xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">(Number of Good Units Produced / Total Units Started) x 100</explanatoryNote>
	<explanatoryNote xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">Formulate a stoichiometric equation and compute theoretical value for the mass of the output</explanatoryNote>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">Calculate the yield as a percentage of the total raw materials or components that are successfully converted into finished products. A high yield indicates that most of the raw material is being efficiently used to produce salable products.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://umbrex.com/resources/industry-analyses/how-to-analyze-a-manufacturing-company/product-yield-and-scrap-rate-analysis/</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#ProductYieldComputingProcess">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ComputingProcess"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-3D849FAEF8B7BEF7362C958A934C3AD1"/>
	<title xmlns="http://purl.org/dc/terms/">product yield computing process</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">A computing process that concretizes the product yield calculation formula.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://umbrex.com/resources/industry-analyses/how-to-analyze-a-manufacturing-company/product-yield-and-scrap-rate-analysis/</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#CradletoCradleSystemBoundary">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/mpdo/core#SystemBoundaryProcess"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-D8639E58B7049AADB9248511FC6ED9B2"/>
	<disjointWith xmlns="http://www.w3.org/2002/07/owl#" rdf:resource="https://spec.industrialontologies.org/ontology/mpdo/core#CradletoGraveProcessBoundary"/>
	<title xmlns="http://purl.org/dc/terms/">cradle-to-cradle system boundary</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">A system boundary process that evaluates a product from raw material extraction through its use and eventual recycling or repurposing into a new cycle, closing the loop instead of ending at disposal.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://go.ipoint-systems.com/blog/cradle-to-cradle</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#CradletoGateSystemBoundary">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/mpdo/core#SystemBoundaryProcess"/>
	<title xmlns="http://purl.org/dc/terms/">cradle-to-gate system boundary</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">A system boundary process that measures a product's environmental impact from raw material extraction (the "cradle") up to the point it leaves the factory floor (the "gate")</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://go.ipoint-systems.com/blog/cradle-to-gate</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#SystemBoundaryProcess">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/PlannedProcess"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-6C523C4A44EF0D92517F28AE27A7DCD4"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-5A2500EA21A3B557C28A406D527A00D9"/>
	<title xmlns="http://purl.org/dc/terms/">system boundary process</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">A planned process with the delineation that defines what elements are included within a system and what elements are external to it. These boundaries help to focus on the relevant aspects of a system while treating external influences as remote phenomena.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://www.sciencedirect.com/topics/agricultural-and-biological-sciences/system-boundary</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#StoichiometricYieldCalculationFormula">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/Algorithm"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-09B3F63EC740078A3A85934119058B4A"/>
	<title xmlns="http://purl.org/dc/terms/">stoichiometric yield calculation formula</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">The maximum amount of product that could be formed from the given amounts of reactants.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://chem.libretexts.org/Bookshelves/Introductory_Chemistry/Introductory_Chemistry_(CK-12)/12:_Stoichiometry/12.09:_Theoretical_Yield_and_Percent_Yield</adaptedFrom>
</rdf:Description>

