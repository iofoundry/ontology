<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#ProcessYield">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ProcessCharacteristic"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-84FF5378CAC6B8F9464CE155933C0846"/>
	<title xmlns="http://purl.org/dc/terms/">process yield</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">A vital quality and manufacturing metric measuring the percentage of total input units or raw materials successfully converted into defect-free, saleable output</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://www.sciencedirect.com/topics/engineering/process-yield</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#StoichiometricYieldComputingProcess">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ComputingProcess"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-3DC29D581651B558A59C42E2FBDEB7F6"/>
	<title xmlns="http://purl.org/dc/terms/">stoichiometric yield computing process</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">A computing process that concretizes the stoichiometic yield calculation formula.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://chem.libretexts.org/Bookshelves/Introductory_Chemistry/Introductory_Chemistry_(CK-12)/12:_Stoichiometry/12.09:_Theoretical_Yield_and_Percent_Yield</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#CradletoGraveProcessBoundary">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/mpdo/core#SystemBoundaryProcess"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-EB00514032384056BD9C4C4EEE7EDB0E"/>
	<disjointWith xmlns="http://www.w3.org/2002/07/owl#" rdf:resource="https://spec.industrialontologies.org/ontology/mpdo/core#CradletoCradleSystemBoundary"/>
	<title xmlns="http://purl.org/dc/terms/">cradle-to-grave system boundary</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">A system boundary process that tracks a product's environmental impact from raw material extraction ("cradle") through manufacturing, distribution, consumer use, and final waste disposal or landfill ("grave")</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://go.ipoint-systems.com/blog/cradle-to-grave</adaptedFrom>
</rdf:Description>

