</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#EthanolCapacityImpactAssessment">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/tea/core#ImpactAssessment"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-3F7268AC6199B85ED1979D623BCA9833"/>
	<title xmlns="http://purl.org/dc/terms/">ethanol capacity impact assessment</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">An impact assessment for the ethanol capacity of a parameter permutation evaluation</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">chrome-extension://efaidnbmnnnibpcajpcglclefindmkaj/https://ethanolrfa.org/file/2911/Economic Contribution of the Ethanol Industry in 2024 - WEB.pdf</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#Capacity">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ValueExpression"/>
	<title xmlns="http://purl.org/dc/terms/">capacity</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">The largest amount that something can hold or contain, or a person's mental and physical ability to do a task. It can also describe a specific job, role, or position</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://dictionary.cambridge.org/us/dictionary/english/capacity</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#EthanolCapacity">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/mpdo/core#Capacity"/>
	<title xmlns="http://purl.org/dc/terms/">ethanol capacity</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">The largest amount of ethanol that something can hold or contain. It can describe the level of production that a manufacturing facility can produce.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://en.wikipedia.org/wiki/Ethanol_fuel_in_the_United_States</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#ManufacturingFacilityLifetime">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/TemporalDurationValueExpression"/>
	<title xmlns="http://purl.org/dc/terms/">manufacturing facility lifetime</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">The lifespan of the manufacturing facility that involves the physical structure and the contents within. While the structure itself can last for a long time, the contents within need to change more rapidly due to functional obsolesence.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://xtdsteel.com/steel-structure-building/steel-building-service-life/</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#manufacturingFacility">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/physical/PhysicalSite"/>
	<title xmlns="http://purl.org/dc/terms/">manufacturing facility</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">An industrial building or plant where raw materials or components are transformed into finished tangible goods through manual labor, machinery, or chemical processing</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://www.ornl.gov/advancedmanufacturing</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#manufacturingFacilityLifetimeAssessment">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/tea/core#ImpactAssessment"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-05E1E515A2A34661F25DE212E5227B30"/>
	<title xmlns="http://purl.org/dc/terms/">manufacturing facility lifetime assessment</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">An impact assessment for the manufacturing facility lifetime of a parameter permutation evaluation</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://www.tunley-environmental.com/en/insights/life-cycle-assessment-in-manufacturing</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#manufacturingFacilityMaintenanceIntervalAssessment">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/tea/core#ImpactAssessment"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-09BAED3BF44067B5BA6FDBA4B9F268A8"/>
	<title xmlns="http://purl.org/dc/terms/">manufacturing facility maintenance interval assessment</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">An impact assessment for the manufacturing facility maintenance interval of a parameter permutation evaluation</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://tractian.com/en/glossary/maintenance-interval</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#ParameterPermutationProcessDesign">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/PlanSpecification"/>
	<title xmlns="http://purl.org/dc/terms/">parameter permutation process design</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">A plan specification capturing performance metrics across an exhaustive grid of parameter variations. Instead of discarding non-optimal test results, it aggregates all simulation outputs to build statistical distribution profiles, mitigating data-mining bias and quantifying operational risk.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://papers.ssrn.com/sol3/papers.cfm?abstract_id=2423187</adaptedFrom>
	<equivalentClass xmlns="http://www.w3.org/2002/07/owl#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-E1B720642B9EBB473A4E65EA54AC5818"/>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#ParameterPermutationProcessDesignEvaluation">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/PlannedProcess"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-225D91FF9662BEA72F02F687D49B1D83"/>
	<title xmlns="http://purl.org/dc/terms/">parameter permutation process design evaluation </title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">A planned process prescribed by a plan specification capturing performance metrics across an exhaustive grid of parameter variations. Instead of discarding non-optimal test results, it aggregates all simulation outputs to build statistical distribution profiles, mitigating data-mining bias and quantifying operational risk.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://papers.ssrn.com/sol3/papers.cfm?abstract_id=2423187</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#ManufacturingFacilityRunningTime">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/TemporalInstantValueExpression"/>
	<title xmlns="http://purl.org/dc/terms/">manufacturing facility running time</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">The actual period when a factory or machine actively produces goods</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://excellerant-mfg.com/feeds/blog/how-to-track-manufacturing-efficiency</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#ManufacturingFacilityMaintenanceInterval">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/TemporalDurationValueExpression"/>
	<title xmlns="http://purl.org/dc/terms/">manufacturing facility maintenance interval</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">The set amount of time, equipment usage, or machine condition that passes between scheduled servicing tasks</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://tractian.com/en/glossary/maintenance-interval</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#ManufacturingFacilityRunningTimeAssessment">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/tea/core#ImpactAssessment"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-C0186B3E0FE8F2CA88E462B8DD9FFF46"/>
	<title xmlns="http://purl.org/dc/terms/">manufacturing facility running time assessment</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">An impact assessment for the manufacturing facility running time of a parameter permutation evaluation</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://tractian.com/en/glossary/factory-time</adaptedFrom>
</rdf:Description>

