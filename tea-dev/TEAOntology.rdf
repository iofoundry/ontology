</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/tea/core#EngineeredSystemRequirementSpecification">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/RequirementSpecification"/>
	<title xmlns="http://purl.org/dc/terms/">engineered system requirement specification</title>
	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#">SysRS</altLabel>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">A formal document that defines a system's functional capabilities, performance levels, quality attributes, and operational constraints. It acts as a clear agreement and technical blueprint for hardware, software, and human processes before design begins.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://sebokwiki.org/wiki/System_Requirements_Definition</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/tea/core#EnergyIntensity">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/tea/core#ImpactIndicator"/>
	<title xmlns="http://purl.org/dc/terms/">energy intensity</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">total energy consumed divided by total product produced</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://www.energy.gov/cmei/energy-intensity-indicators</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/tea/core#MaterialEfficiency">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/tea/core#ImpactIndicator"/>
	<title xmlns="http://purl.org/dc/terms/">material efficiency</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">the ratio of output of products to input of raw materials</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://www.iec.ch/blog/circular-economy-understanding-material-efficiency</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/tea/core#WaterConsumption">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/tea/core#ImpactIndicator"/>
	<title xmlns="http://purl.org/dc/terms/">water consumption</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">Quantifying a product's total freshwater footprint, including direct and indirect water use and impacts on water availability and quality across its entire lifecycle</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://www.sciencedirect.com/topics/engineering/water-footprint</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/tea/core#FunctionalUnit">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ValueExpression"/>
	<title xmlns="http://purl.org/dc/terms/">functional unit</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">A quantitative expression of the product being studied, addressing the function, the quantity, the performance, and the time. The functional unit is the same across alternatives being studied.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://consequential-lca.org/clca/the-functional-unit/define-the-functional-unit/</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/tea/core#ProgramOperatorRole">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/AgentRole"/>
	<title xmlns="http://purl.org/dc/terms/">program operator role</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">Role of the entity that manages environmental labeling, product certification standards, or specific software automation tasks depending on the industry context.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://www.nsf.org/knowledge-library/nsf-trusted-pcr-lca-epd-program-operator</adaptedFrom>
</rdf:Description>

