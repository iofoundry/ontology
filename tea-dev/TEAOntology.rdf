<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/tea/core#StoichiometricYield">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ValueExpression"/>
	<title xmlns="http://purl.org/dc/terms/">stoichiometric yield</title>
	<example xmlns="http://www.w3.org/2004/02/skos/core#">The stoichiometric yield was evaluated by calculating the moles of acetic acid produced per mole of ethanol consumed in the liquid
medium.</example>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">A theoretical yield based upon the stoichiometry of the experiment.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://chem.libretexts.org/Bookshelves/Introductory_Chemistry/Introductory_Chemistry_(CK-12)/12:_Stoichiometry/12.09:_Theoretical_Yield_and_Percent_Yield

Ndoye, B., Shafiei, R., Sanaei, N. S., Cleenwerck, I., Somda, M. K., Dicko, M. H., Tounkara, L. S., Guiro, A. T., Delvigne, F., &amp; Thonart, P. (2022). Acetobacter senegalensis            isolated from mango fruits: Its polyphasic characterization and adaptation to protect against stressors in the industrial production of vinegar: A Review. Journal of Applied Microbiology, 132(6), 4130–4149. https://doi.org/10.1111/jam.15495</adaptedFrom>
	<equivalentClass xmlns="http://www.w3.org/2002/07/owl#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-04C611CC01CE1CCEE34E4E988E90DE12"/>
</rdf:Description>

