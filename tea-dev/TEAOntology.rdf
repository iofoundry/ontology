<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#RecipeElementCreationProcess">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/PlannedProcess"/>
	<title xmlns="http://purl.org/dc/terms/">recipe element creation process</title>
	<equivalentClass xmlns="http://www.w3.org/2002/07/owl#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-6660F43B1767FDD615495E0B6A1C24C0"/>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#RecipeElementDerivationProcess">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/mpdo/core#RecipeElementCreationProcess"/>
	<title xmlns="http://purl.org/dc/terms/">recipe element derivation process</title>
	<equivalentClass xmlns="http://www.w3.org/2002/07/owl#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-F57EF079C47C67EEBCD467D46E6794EE"/>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#TechnoeconomicAnalysis">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/PlannedProcess"/>
	<title xmlns="http://purl.org/dc/terms/">techno-economic analysis</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">Compilation and evaluation of technological parameters and economic performance of a process system</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://www.iso.org/obp/ui#iso:std:iso:ts:14076:ed-1:v1:en</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#BasisOfProduction">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ValueExpression"/>
	<title xmlns="http://purl.org/dc/terms/">basis of production</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">A quantified performance of a process system, reflecting its specific scale, size or rate</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://www.iso.org/obp/ui#iso:std:iso:ts:14076:ed-1:v1:en</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#ProcessSystemSpecification">
	<title xmlns="http://purl.org/dc/terms/">process system</title>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#ReferenceFlowRole">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/lca/core#FlowRole"/>
	<title xmlns="http://purl.org/dc/terms/">reference flow role</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">Measure of the outputs from processes in a given product system required to fulfill the function expressed by the functional unit</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://www.sciencedirect.com/topics/engineering/reference-flow</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#ReferenceFlowIdentification">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/tea/core#FlowIdentification"/>
	<title xmlns="http://purl.org/dc/terms/">reference flow identification</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">Identification of abstractions of product flows from an abstract functional unit, to allow for comparisons between product alternatives</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://pmc.ncbi.nlm.nih.gov/articles/PMC5812692/</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#ProcessSystemProcess">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/BusinessProcess"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-C9AACE4502D73B1C2B1FE88182A2D84A"/>
	<title xmlns="http://purl.org/dc/terms/">process system process</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">System of one or more interlinked unit processes over which the business unit has control</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://www.iso.org/obp/ui#iso:std:iso:ts:14076:ed-1:v1:en</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#ProductSystemProcess">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/BusinessProcess"/>
	<title xmlns="http://purl.org/dc/terms/">product system process</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">collection of unit processes with elementary and product flows, performing one or more defined functions, and which models the production of a product </naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://www.iso.org/obp/ui#iso:std:iso:ts:14076:ed-1:v1:en</adaptedFrom>
	<equivalentClass xmlns="http://www.w3.org/2002/07/owl#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ProductProductionProcess"/>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#TechnosphereFlowIdentification">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/tea/core#FlowIdentification"/>
	<title xmlns="http://purl.org/dc/terms/">technosphere flow identification</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">The process of mapping and categorizing internal material, energy, and product exchanges that occur entirely within human-made industrial, economic, and product systems</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://pmc.ncbi.nlm.nih.gov/articles/PMC5812692/</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#ElementaryFlowIdentification">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/tea/core#FlowIdentification"/>
	<title xmlns="http://purl.org/dc/terms/">elementary flow identification</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">Identifying material or energy inputs from or releases to the environment (such as carbon dioxide emissions or water extraction) without prior human transformation</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://pmc.ncbi.nlm.nih.gov/articles/PMC5812692/</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#ElementaryFlowRole">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/lca/core#FlowRole"/>
	<title xmlns="http://purl.org/dc/terms/">elementary flow role</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">Raw resources drawn directly from the environment without prior human transformation (like crude oil in the ground) or emissions released directly back into environmental media (like carbon dioxide into the air) without subsequent treatment.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://helpcenter.ecochain.com/en/articles/9952608-explained-elementary-flows</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#TechnosphereFlowRole">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/lca/core#FlowRole"/>
	<title xmlns="http://purl.org/dc/terms/">technosphere flow role</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">Role of an entity in an internal exchange of goods, materials, or energy between human-made industrial, economic, or technological processes within a life cycle assessment model.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://pmc.ncbi.nlm.nih.gov/articles/PMC5812692/</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#RateOfReturn">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ValueExpression"/>
	<title xmlns="http://purl.org/dc/terms/">rate of return</title>
	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#">RoR</altLabel>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">net gain or loss on an investment over a specified time period, expressed as a percentage of the investment's initial cost or value as of a specific point in time</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/RateOfReturn</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#InternalRateOfReturn">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/mpdo/core#RateOfReturn"/>
	<title xmlns="http://purl.org/dc/terms/">internal rate of return</title>
	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#">IRR</altLabel>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">discount rate that results in a net present value (NPV) of zero for a series of future cash flows </naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/InstrumentPricing/InternalRateOfReturn</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#PresentValue">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ValueExpression"/>
	<title xmlns="http://purl.org/dc/terms/">present value</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">value of an asset today, which may be calculated from reference data and may based on its expected future value</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/PresentValue</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#NetPresentValue">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/mpdo/core#PresentValue"/>
	<title xmlns="http://purl.org/dc/terms/">net present value</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">The current value of all future cash flows from a project or investment minus the initial cost</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://www.investopedia.com/terms/n/npv.asp</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#TechnicalRequirementsSpecification">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/RequirementSpecification"/>
	<title xmlns="http://purl.org/dc/terms/">technical requirements specification</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">A formal document that explains how a system, product, or software feature will be built. It bridges business goals and engineering execution, serving as a clear blueprint for developers, testers, and project managers.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://ecss.nl/standard/ecss-e-st-10-06c-technical-requirements-specification/</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#RiskAnalysisSpecification">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/tea/core#AnalysisSpecification"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-BFEB17EE4244E59569A0EA952015D2F0"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-8906D125F74023AEC00B2B69CC7B3E38"/>
	<title xmlns="http://purl.org/dc/terms/">risk analysis specification</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">A formal document outlining how an organization identifies, evaluates, and measures potential threats and vulnerabilities. It defines the scope, criteria, methods (qualitative or quantitative), and assigned responsibilities needed to determine risk levels and guide mitigation.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://csrc.nist.gov/glossary/term/risk_analysis</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#Income">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ValueExpression"/>
	<title xmlns="http://purl.org/dc/terms/">income</title>
	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#">revenue stream</altLabel>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">revenue received during a period of time</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/AccountingEquity/Income</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#RiskAssessmentProcess">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/tea/core#AssessmentProcess"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-4213918E3B77391105AD6F4F249C5E12"/>
	<title xmlns="http://purl.org/dc/terms/">risk assessment process</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">An evaluation of the plan specification laid out in the risk analysis specification.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://csrc.nist.gov/glossary/term/risk_analysis</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#RiskMitigationSpecification">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/tea/core#AnalysisSpecification"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-8296D7794CDFCFEAFD5605909586F9F5"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-317D6D345D1B6FF8AA8921194C361D57"/>
	<title xmlns="http://purl.org/dc/terms/">risk mitigation specification</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">A formal document that defines how a project or organization will identify, evaluate, and reduce threats to an acceptable level. It outlines specific controls, actionable tasks, assigned owners, and tracking procedures required to protect operations.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://softcomply.com/write-risk-mitigation-requirement/</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#RiskMitigationAssessmentProcess">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/tea/core#AssessmentProcess"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-5D8D00873BF5F2172D5D51EC0BE30E8C"/>
	<title xmlns="http://purl.org/dc/terms/">risk mitigation assessment process</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">An evaluation of the plan specification laid out in the risk mitigation specification.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://softcomply.com/write-risk-mitigation-requirement/</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#FinancialViabilityAnalysisSpecification">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/tea/core#AnalysisSpecification"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-7B56D992E388C65419AB312CB47B0BE1"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-AA1571E3435B87D54D9DA610B0FBA239"/>
	<title xmlns="http://purl.org/dc/terms/">financial viability analysis specification</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">The criteria, metrics, and thresholds used to evaluate whether a project, business, or contractor has sufficient financial resources, liquidity, and profit potential to survive long-term and fulfill its obligations. It sets the standards for solvency, cash flow, and risk management.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://www.finance.gov.au/government/procurement/buying-australian-government/assessing-financial-viability</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#FinancialAchievabilityAssessmentProcess">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/tea/core#AssessmentProcess"/>
	<title xmlns="http://purl.org/dc/terms/">financial achievability assessment process</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">An evaluation of the plan specification laid out in the financial achievability specification.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://rosap.ntl.bts.gov/view/dot/72276</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#ExpenseAnalysisSpecification">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/tea/core#AnalysisSpecification"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-2090F96782109482BDD9A7237989FF50"/>
	<title xmlns="http://purl.org/dc/terms/">expense analysis specification</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">A formal document outlining how an organization collects, categorizes, evaluates, and reports its financial costs. It sets rules for tracking cash flow, finding spending patterns, measuring variances against budgets, and ensuring data consistency across business units.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://www.hyperbots.com/glossary/expense-analysis</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#ExpenseAssessmentProcess">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/tea/core#AssessmentProcess"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-88B065DE51B7B038E24CAEF303482CFB"/>
	<title xmlns="http://purl.org/dc/terms/">expense assessment process</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">An evaluation of the plan specification laid out in the expense analysis specification.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://www.hyperbots.com/glossary/expense-analysis</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#ProblemDefintion">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/tea/core#AnalysisObjectiveSpecification"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-841906ADCB83303E7C7EDE531C41A1B3"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-FD22CBF5637EAE4A12ABE36B77F7FED4"/>
	<title xmlns="http://purl.org/dc/terms/">problem defintion</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">Clear and formal document that defines what is broken, who it affects, and what a successful outcome looks like, setting precise project boundaries and metrics before any design or engineering work begins.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://highbridgeacademy.com/a-primer-on-defining-problems-the-foundation-of-effective-problem-solving/</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#GapObjectiveSpecification">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/tea/core#AnalysisObjectiveSpecification"/>
	<title xmlns="http://purl.org/dc/terms/">gap objective specification</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">The target goals, current operational baseline, and specific variances between an organization’s present performance and its strategic ambitions. </naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://en.wikipedia.org/wiki/Gap_analysis</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#GapAnalysisSpecification">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/tea/core#AnalysisSpecification"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-B32DE888B2D35D1C5E1AF5E943D8EE87"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-04D5C705DB0B500D4A43D58F1B004778"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-1683325860B3A85AAB7B83BF49B5D16C"/>
	<title xmlns="http://purl.org/dc/terms/">gap analysis specification</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">A formal document outlining how an organization will compare its current performance, capabilities, or compliance levels against a desired future target or standard. It defines the scope, metrics, data sources, and procedures needed to identify shortfalls and build a corrective action plan.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://en.wikipedia.org/wiki/Gap_analysis</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#ProblemDefinitionAssessmentProcess">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/tea/core#AssessmentProcess"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-EEA1E78552DB2D340C5491C0FAC4C2B6"/>
	<title xmlns="http://purl.org/dc/terms/">problem definition assessment process</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">An evaluation of the plan specification laid out in the problem definition analysis objectve specification.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://highbridgeacademy.com/a-primer-on-defining-problems-the-foundation-of-effective-problem-solving/</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#GapAssessmentProcess">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/tea/core#AssessmentProcess"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-7FE8519BABFC77E80DEE0680269953FA"/>
	<title xmlns="http://purl.org/dc/terms/">gap assessment process</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">An evaluation of the plan specification laid out in the gap analysis specification.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://en.wikipedia.org/wiki/Gap_analysis</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#prescribedToPrecede">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
	<title xmlns="http://purl.org/dc/terms/">prescribed to precede</title>
	<range xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
	<domain xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#FinancialAchievabilitySpecification">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/tea/core#AnalysisSpecification"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-A62DFFE2D740416EFCC45AD49B4A2D2A"/>
	<title xmlns="http://purl.org/dc/terms/">financial achievability specification</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">The metrics, costs, and funding criteria used to prove a project, contract, or goal is realistic and affordable. It defines minimum capital requirements, expected cash flows, and risk boundaries to verify that an individual or business can fully fund commitments without defaulting.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://rosap.ntl.bts.gov/view/dot/72276</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#FinancialViabilityAssessmentProcess">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/tea/core#AssessmentProcess"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-A3F8A90EED79EC6731F9870E651CD816"/>
	<title xmlns="http://purl.org/dc/terms/">financial viability assessment process</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">An evaluation of the plan specification laid out in the financial viability specification.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://www.finance.gov.au/government/procurement/buying-australian-government/assessing-financial-viability</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#MinimumSellingPrice">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ValueExpression"/>
	<title xmlns="http://purl.org/dc/terms/">minimum selling price</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">The lowest amount a seller will accept for a product or service. It covers all production, operational, and marketplace fees so the business avoids a loss. In auctions, this concept functions as a hidden reserve price.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://www.channelengine.com/en/blog/how-to-set-minimum-price-marketplaces</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#MinimumEthanolSellingPrice">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/mpdo/core#MinimumSellingPrice"/>
	<title xmlns="http://purl.org/dc/terms/">minimum ethanol selling price</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">The lowest amount a seller will accept for a liter of ethanol.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://link.springer.com/article/10.1186/1754-6834-5-69</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#CapitalInvestment">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ValueExpression"/>
	<title xmlns="http://purl.org/dc/terms/">capital investment</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">Money a business or individual spends to acquire, upgrade, or maintain long-term physical assets—such as buildings, machinery, land, or technology—with the goal of boosting future growth, efficiency, and profits</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://www.investopedia.com/terms/c/capital-investment.asp</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#FixedCapitalInvestment">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/mpdo/core#CapitalInvestment"/>
	<title xmlns="http://purl.org/dc/terms/">fixed capital investment</title>
	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#">FCI</altLabel>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">Money a business spends on long-term physical assets like land, buildings, and machinery to build and grow its operations. These durable items are not used up during daily production</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://corporatefinanceinstitute.com/resources/accounting/fixed-capital/</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#WorkingCapitalInvestment">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/mpdo/core#CapitalInvestment"/>
	<title xmlns="http://purl.org/dc/terms/">working capital investment</title>
	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#">WCI</altLabel>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">Money a business puts into its short-term assets like inventory and cash to fund daily operations, calculated by subtracting current liabilities from current assets.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://corporatefinanceinstitute.com/resources/accounting/working-capital-vs-investing-capital/</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#TotalCapitalInvestment">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/mpdo/core#CapitalInvestment"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-AF6FA0A2030A01AD97E98C6C440B3862"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-D0397E7B466DF1F0528993072AF9EE6B"/>
	<title xmlns="http://purl.org/dc/terms/">total capital investment</title>
	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#">TCI</altLabel>
	<explanatoryNote xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">total capital investment = fixed capital investment      working capital investment</explanatoryNote>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">The total amount of money needed to build, start, and run a new project or business asset until it begins normal work.</naturalLanguageDefinition>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#CoproductIncome">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/mpdo/core#Income"/>
	<title xmlns="http://purl.org/dc/terms/">co-product income</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">Revenue generated from selling secondary, valuable items produced simultaneously during the creation of a primary product.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://consequential-lca.org/clca/determining-or-dependent-co-products/</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#ProductionCost">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ValueExpression"/>
	<title xmlns="http://purl.org/dc/terms/">production cost</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">The total of all direct and indirect expenses a business incurs to manufacture a product or deliver a service</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://www.investopedia.com/terms/p/production-cost.asp</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#AnnualizedCapitalProductionCost">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/mpdo/core#ProductionCost"/>
	<title xmlns="http://purl.org/dc/terms/">annualized capital production cost</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">The yearly equivalent expense of purchasing, financing, and maintaining long-term physical assets or equipment used in production.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://www.investopedia.com/terms/c/capitalexpenditure.asp</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#AnnualizedOperatingProductionCost">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/mpdo/core#ProductionCost"/>
	<title xmlns="http://purl.org/dc/terms/">annualized operating production cost</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">The total yearly expense required to manufacture a product or run a production facility, combining both annual operating expenses and annualized capital costs</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://www.sciencedirect.com/topics/engineering/annual-operational-cost</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#ProductProduced">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ValueExpression"/>
	<title xmlns="http://purl.org/dc/terms/">product produced</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/"> Tangible goods or intangible services for the market created from the systematic process of combining raw materials, labor, capital, and technology</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://www.jot.fm/issues/issue_2004_11/column7/</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#AnnualizedEthanolProduced">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/mpdo/core#ProductProduced"/>
	<title xmlns="http://purl.org/dc/terms/">annualized ethanol produced</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">Annualized quantity for ethanol created from the systematic process of combining raw materials, labor, capital, and technology</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://ethanolrfa.org/markets-and-statistics/annual-ethanol-production</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#ChemcadProcessDesignEvaluationProcess">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ComputingProcess"/>
	<title xmlns="http://purl.org/dc/terms/">chemcad process design evaluation process</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">Evaluation that uses a software tool (ChemCAD) to build a steady-state or dynamic chemical simulation. Engineers select components and thermodynamic models, map out process flow diagrams (PFDs), specify equipment and stream parameters, run convergence checks, and evaluate system economics, energy efficiency, and safety constraints.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://www.datacor.com/products/chemcad</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#AspenPlusProcessDesignEvaluationProcess">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ComputingProcess"/>
	<title xmlns="http://purl.org/dc/terms/">aspen plus process design evaluation process</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">Evaluation that uses a software tool (Aspen Plus) to build a steady-state simulation, mapping unit operations to equipment, and running integrated economic and energy assessments using tools like the Aspen Process Economic Analyzer to determine capital costs (CAPEX), operating costs (OPEX), and overall project profitability.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://www.aspentech.com/en</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#SuperproDesignerProcessDesignEvaluationProcess">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/ComputingProcess"/>
	<title xmlns="http://purl.org/dc/terms/">superpro designer process design evaluation process</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">Evaluation that uses a software tool (SuperPro Designer) to model, evaluate, and optimize batch and continuous processes in industries like biotech, pharma, food, and water treatment. It combines material and energy balancing, equipment sizing, project economic evaluation, and environmental impact assessment into one platform.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://www.intelligen.com/products/superpro-overview/</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#SensitivityProcessDesignAssessmentProcess">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/tea/core#AssessmentProcess"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-138CE5C52C6FDF5A1BB00D0CC7F35736"/>
	<title xmlns="http://purl.org/dc/terms/">sensitivity process design assessment process</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">An evaluation of the plan specification laid out in the sensitivity analysis specification.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://design.cbe.cornell.edu/index.php?title=Sensitivity_analysis_and_design_optimization</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#SensitivityProcessDesignAnalysisSpecification">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:resource="https://spec.industrialontologies.org/ontology/tea/core#AnalysisSpecification"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-D4C1765C6699038391BB249B5D1EB93D"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-19D14844786902559EFA3BE7F97D5110"/>
	<subClassOf xmlns="http://www.w3.org/2000/01/rdf-schema#" rdf:nodeID="genid-9628c04a10984111bb105497106a75ac136-0C2E688EC8E95D6D8A7EBE9EFE1DD9A7"/>
	<title xmlns="http://purl.org/dc/terms/">sensitivity process design analysis specification</title>
	<naturalLanguageDefinition xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">Analysis specification with systematic variance in inputs over a range to observe and graph the resulting changes in system outputs.</naturalLanguageDefinition>
	<adaptedFrom xmlns="https://spec.industrialontologies.org/ontology/core/meta/AnnotationVocabulary/">https://design.cbe.cornell.edu/index.php?title=Sensitivity_analysis_and_design_optimization</adaptedFrom>
</rdf:Description>

<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/mpdo/core#MinimumEthanolSellingPriceAssessment">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
