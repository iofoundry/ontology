##
# Literal values.
#
# Checks on the literal values of any property of any IOF term. SHACL Core paths name a
# single predicate, so these checks, which range over every predicate of a resource,
# use SPARQL constraints with the iof-h:NamedSubjects target. ?path in each result is
# the property whose value is at fault.

@prefix iof-h: <https://spec.industrialontologies.org/ontology/hygiene/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xs: <http://www.w3.org/2001/XMLSchema#> .

# ======================================================================================
# Whitespace and empty values
#
# Stray whitespace is invisible in most editors but shows up in the portal and makes
# otherwise identical labels and definitions compare as different.
# ======================================================================================

##
# Holds the four literal checks below and gives them their severity (warning):
# pySHACL takes a SPARQL constraint's severity from the shape that holds it.

iof-h:LiteralValues
	a sh:NodeShape ;
	sh:severity sh:Warning ;
	sh:sparql
		iof-h:LiteralLeadingBlanks ,
		iof-h:LiteralMultipleBlanks ,
		iof-h:LiteralNullValue ,
		iof-h:LiteralTrailingBlanks
		;
	sh:target iof-h:NamedSubjects ;
	.

##
# An empty literal. iof-av:wasDefinedBy is exempt.

iof-h:LiteralNullValue
	a sh:SPARQLConstraint ;
	rdfs:label "null literal values" ;
	sh:message "A resource {$this} has a null value for property {?path}" ;
	sh:prefixes <https://spec.industrialontologies.org/ontology/hygiene/> ;
	sh:select """
        SELECT DISTINCT $this ?path WHERE {
            $this ?path ?value .
            FILTER (?path != iof-av:wasDefinedBy)
            FILTER (isLiteral(?value) && STRLEN(STR(?value)) = 0)
        }
    """ ;
	.

##
# Spaces or tabs before the first character.

iof-h:LiteralLeadingBlanks
	a sh:SPARQLConstraint ;
	rdfs:label "literals leading blanks" ;
	sh:message "Resource {$this} has property {?path} whose value contains leading space(s)." ;
	sh:prefixes <https://spec.industrialontologies.org/ontology/hygiene/> ;
	sh:select '''
        SELECT DISTINCT $this ?path WHERE {
            $this ?path ?value .
            FILTER (isLiteral(?value) && REGEX(STR(?value), "^[ \\t]+."))
        }
    ''' ;
	.

##
# Spaces or tabs after the last character.

iof-h:LiteralTrailingBlanks
	a sh:SPARQLConstraint ;
	rdfs:label "literals trailing blanks" ;
	sh:message "Resource {$this} has property {?path} whose value contains trailing space(s)." ;
	sh:prefixes <https://spec.industrialontologies.org/ontology/hygiene/> ;
	sh:select '''
        SELECT DISTINCT $this ?path WHERE {
            $this ?path ?value .
            FILTER (isLiteral(?value) && REGEX(STR(?value), ".[ \\t]+$"))
        }
    ''' ;
	.

##
# Two or more spaces or tabs between two other characters. A run that touches a line
# break is not counted, so indentation in multi-line notes is allowed.

iof-h:LiteralMultipleBlanks
	a sh:SPARQLConstraint ;
	rdfs:label "literals multiple blanks" ;
	sh:message "Resource {$this} has property {?path} whose value contains multiple embedded spaces." ;
	sh:prefixes <https://spec.industrialontologies.org/ontology/hygiene/> ;
	sh:select '''
        SELECT DISTINCT $this ?path WHERE {
            $this ?path ?value .
            FILTER (isLiteral(?value) && REGEX(STR(?value), "[^ \\t\\r\\n][ \\t][ \\t]+[^ \\t\\r\\n]"))
        }
    ''' ;
	.

# ======================================================================================
# Language tags
# ======================================================================================

##
# IOF writes American English as "en-US". sh:languageIn compares language tags
# case-insensitively (BCP 47), so the label and definition checks accept "en-us";
# this check keeps the spelling consistent.

iof-h:LanguageTagCase
	a sh:NodeShape ;
	rdfs:label "language tag case" ;
	sh:severity sh:Violation ;
	sh:sparql [
		sh:message 'Resource {$this} has property {?path} with language tag "{?lang}" instead of "en-US".' ;
		sh:prefixes <https://spec.industrialontologies.org/ontology/hygiene/> ;
		sh:select '''
            SELECT DISTINCT $this ?path ?lang WHERE {
                $this ?path ?value .
                BIND (LANG(?value) AS ?lang)
                FILTER (LCASE(?lang) = "en-us" && ?lang != "en-US")
            }
        ''' ;
	] ;
	sh:target iof-h:NamedSubjects ;
	.

##
# Every annotation should have a language tag.
#
# Deactivated: the original SPARQL test could never match (it required a
# rdf:langString without a language tag), and the check as intended flags ~5,500
# untagged literals -- skos:example, FOL axioms, rationales, etc. Remove
# sh:deactivated to enable it.

iof-h:AnnotationLanguageTag
	a sh:NodeShape ;
	rdfs:label "annotations language tag" ;
	sh:deactivated "true"^^xs:boolean ;
	sh:severity sh:Warning ;
	sh:sparql [
		sh:message "Annotation {?value} of {$this} does not have a language tag in property: {?path}" ;
		sh:prefixes <https://spec.industrialontologies.org/ontology/hygiene/> ;
		sh:select """
            SELECT DISTINCT $this ?path ?value WHERE {
                ?path a owl:AnnotationProperty .
                $this ?path ?value .
                FILTER (isLiteral(?value) && DATATYPE(?value) = xsd:string)
            }
        """ ;
	] ;
	sh:target iof-h:NamedSubjects ;
	.
