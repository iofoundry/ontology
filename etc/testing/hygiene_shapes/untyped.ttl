##
# Undeclared terms.
#
# Every term used in a triple should have its type explicitly declared (owl:Class,
# owl:ObjectProperty, owl:NamedIndividual, ...). An undeclared term is usually a typo in
# an IRI, a term from a module that is not imported, or a term that was renamed or
# removed. Each position in the triple is checked separately so the message says how
# the term is used. All are warnings.
#
# The targets are the SPARQL targets in common.ttl; the runner's focus filter limits
# the results to IOF IRIs.

@prefix iof-h: <https://spec.industrialontologies.org/ontology/hygiene/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xs: <http://www.w3.org/2001/XMLSchema#> .

##
# Terms used as the subject of a triple.

iof-h:UntypedSubject
	a sh:NodeShape ;
	sh:property [
		rdfs:label "untyped triple subjects" ;
		sh:message "Resource {$this} is the subject of a triple but has no type declared." ;
		sh:minCount "1"^^xs:integer ;
		sh:path rdf:type ;
		sh:severity sh:Warning ;
	] ;
	sh:target iof-h:NamedSubjects ;
	.

##
# Properties used as the predicate of a triple.

iof-h:UntypedPredicate
	a sh:NodeShape ;
	sh:property [
		rdfs:label "untyped triple properties" ;
		sh:message "Property {$this} is the predicate of a triple but has no type declared." ;
		sh:minCount "1"^^xs:integer ;
		sh:path rdf:type ;
		sh:severity sh:Warning ;
	] ;
	sh:target iof-h:NamedPredicates ;
	.

##
# Terms used as the object of a triple (other than version IRIs), e.g. a superclass
# or the filler of a restriction.

iof-h:UntypedObject
	a sh:NodeShape ;
	sh:property [
		rdfs:label "untyped triple objects" ;
		sh:message "Resource {$this} is the object of a triple but has no type declared." ;
		sh:minCount "1"^^xs:integer ;
		sh:path rdf:type ;
		sh:severity sh:Warning ;
	] ;
	sh:target iof-h:NamedObjects ;
	.
