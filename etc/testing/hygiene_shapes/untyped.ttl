@prefix iof-h: <https://spec.industrialontologies.org/ontology/hygiene/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xs: <http://www.w3.org/2001/XMLSchema#> .

iof-h:UntypedObject
	a sh:NodeShape ;
	sh:property [
		rdfs:label "untyped triple objects" ;
		sh:message "Resource {$this} is the object of a triple but has no type declared." ;
		sh:minCount "1"^^xs:integer ;
		sh:path rdf:type ;
		sh:severity sh:Warning ;
	] ;
	sh:target iof-h:NamedObjects ;
	.

iof-h:UntypedPredicate
	a sh:NodeShape ;
	sh:property [
		rdfs:label "untyped triple properties" ;
		sh:message "Property {$this} is the predicate of a triple but has no type declared." ;
		sh:minCount "1"^^xs:integer ;
		sh:path rdf:type ;
		sh:severity sh:Warning ;
	] ;
	sh:target iof-h:NamedPredicates ;
	.

iof-h:UntypedSubject
	a sh:NodeShape ;
	sh:property [
		rdfs:label "untyped triple subjects" ;
		sh:message "Resource {$this} is the subject of a triple but has no type declared." ;
		sh:minCount "1"^^xs:integer ;
		sh:path rdf:type ;
		sh:severity sh:Warning ;
	] ;
	sh:target iof-h:NamedSubjects ;
	.

