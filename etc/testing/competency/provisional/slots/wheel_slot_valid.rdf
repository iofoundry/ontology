            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en-us">wheel specification</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/wheel-slot//Hatchback-car-design -->

    <owl:Class rdf:about="https://example.org/wheel-slot//Hatchback-car-design">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/DesignSpecification"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasSlot"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">4</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="https://example.org/wheel-slot/SmallWheelSlot"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ComponentSlot -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ComponentSlot">
