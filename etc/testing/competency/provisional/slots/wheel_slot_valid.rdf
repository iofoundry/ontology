    <!-- https://example.org/wheel-slot/BigWheelSpecification -->

    <owl:Class rdf:about="https://example.org/wheel-slot/BigWheelSpecification">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/prescribes"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://example.org/wheel-slot/Wheel"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://example.org/wheel-slot/hasRimDiameterInInches"/>
                                <owl:someValuesFrom>
                                    <rdfs:Datatype>
                                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                        <owl:withRestrictions rdf:parseType="Collection">
                                            <rdf:Description>
                                                <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">18</xsd:minInclusive>
                                            </rdf:Description>
                                        </owl:withRestrictions>
                                    </rdfs:Datatype>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://example.org/wheel-slot/WheelSpecification"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isAbout"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://example.org/wheel-slot/Wheel"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://example.org/wheel-slot/hasRimDiameterInInches"/>
                                <owl:allValuesFrom>
                                    <rdfs:Datatype>
                                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                        <owl:withRestrictions rdf:parseType="Collection">
                                            <rdf:Description>
                                                <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">18</xsd:minInclusive>
                                            </rdf:Description>
                                        </owl:withRestrictions>
                                    </rdfs:Datatype>
                                </owl:allValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en-us">BigWheelSpecification</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/wheel-slot/SmallWheelSlot -->

    <owl:Class rdf:about="https://example.org/wheel-slot/SmallWheelSlot">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ComponentSlot"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasFiller"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://example.org/wheel-slot/WheelSpecification"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isAbout"/>
                                <owl:allValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="https://example.org/wheel-slot/Wheel"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="https://example.org/wheel-slot/hasRimDiameterInInches"/>
                                                <owl:allValuesFrom>
                                                    <rdfs:Datatype>
                                                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                                        <owl:withRestrictions rdf:parseType="Collection">
                                                            <rdf:Description>
                                                                <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">17</xsd:maxInclusive>
                                                            </rdf:Description>
                                                        </owl:withRestrictions>
                                                    </rdfs:Datatype>
                                                </owl:allValuesFrom>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:allValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en-us">small wheel slot</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-us">component slot that can be filled only by a wheel specification about wheels with rim diameters no greater than 17 inches</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


