    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/InformationContentEntity -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity">
        <owl:disjointWith rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationSlot"/>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/InformationSlot -->

