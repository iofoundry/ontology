@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix bfo:      <http://purl.obolibrary.org/obo/> .
@prefix iof:      <https://spec.industrialontologies.org/ontology/construct/> .
@prefix qudt:     <http://qudt.org/schema/qudt/> .
@prefix unit:     <http://qudt.org/vocab/unit/> .
@prefix fst:      <https://spec.industrialontologies.org/example/Fastener/> .
@prefix ex:       <https://spec.industrialontologies.org/example/FastenerExample/> .

# ---------------------------------------------------------------------------
# Example: one bolt from a WYLWLS M6 x 25 mm hex socket cap bolt set, sold as
# "flat head". The size drawing measures L from under the head, and the head is
# low and domed with a flat bearing face, so the bolt is modelled as a button
# head hex socket cap bolt, not a countersunk (flat head) one.
# Amazon ASIN B0FFG4R3KW: 10 bolts + 1 hex key, alloy steel, black oxide,
# full thread. M6 x 1.0 thread (D 6 mm, P 1 mm), 25 mm shank length (L),
# 2.7 mm head height (K), 12.5 mm head diameter (DK), 4 mm drive (S).
#
# Dimension values are the listing's nominal values, from its size drawing.
# L is measured from under the head to the end of the shank, so it is the
# shank's length; the head's height and diameter are separate qualities.
# 
# Taken from https://a.co/d/011fxOUB
# ---------------------------------------------------------------------------

<https://spec.industrialontologies.org/example/FastenerExample/>
    a owl:Ontology ;
    rdfs:label "Fastener Example"@en-US ;
    dcterms:abstract "Example individuals for one M6 x 25 mm button head hex socket cap bolt, its hex key, and the design specifications for the bolt, the hex key, and the bolt set they are sold in, built with information slots."@en-US ;
    owl:imports <https://spec.industrialontologies.org/example/Fastener/> ,
                <https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/> .

# QUDT unit link, declared locally so the file stays OWL DL without importing QUDT.
qudt:hasUnit a owl:ObjectProperty ; rdfs:label "has unit"@en .
unit:MilliM  a owl:NamedIndividual ; rdfs:label "millimetre"@en .
unit:CCY_EUR a owl:NamedIndividual ; rdfs:label "euro"@en .

# ===========================================================================
# Bolt design specification and the Amazon product identifier
# ===========================================================================

ex:M6x25ButtonHeadSocketCapBoltSpec
    a owl:NamedIndividual , fst:ButtonHeadSocketCapBoltSpecification ;
    rdfs:label "WYLWLS M6 x 25 mm button head hex socket cap bolt design specification"@en-US ;
    rdfs:comment "Prescribes a button head hex socket cap bolt (sold as 'flat head') with a 2.7 mm high, 12.5 mm diameter head and a 25 mm long shank with an M6 x 1.0 external thread. Its slots are filled by the head, shank, material and coating specifications. The head specification's slots are filled by the head height and head diameter specifications; the shank specification's slots are filled by the shank length and thread specifications, and the thread specification's by the diameter and pitch specifications."@en-US ;
    iof:hasSlot ex:BoltSpecHeadSlot , ex:BoltSpecShankSlot , ex:BoltSpecMaterialSlot , ex:BoltSpecCoatingSlot .

# --- Material: alloy steel; coating: black oxide ---------------------------------

ex:BoltSpecMaterialSlot
    a owl:NamedIndividual , fst:MaterialSlot ;
    rdfs:label "material slot of the bolt specification"@en-US ;
    iof:hasFiller ex:AlloySteelSpec .
ex:AlloySteelSpec
    a owl:NamedIndividual , fst:AlloySteelSpecification ;
    rdfs:label "alloy steel specification"@en-US .

ex:BoltSpecCoatingSlot
    a owl:NamedIndividual , fst:ProperPartSlot ;
    rdfs:label "coating slot of the bolt specification"@en-US ;
    iof:hasFiller ex:BlackOxideCoatingSpec .
ex:BlackOxideCoatingSpec
    a owl:NamedIndividual , fst:BlackOxideCoatingSpecification ;
    rdfs:label "black oxide coating specification"@en-US .

# --- Head: 2.7 mm high (K), 12.5 mm diameter (DK) ------------------------------

ex:BoltSpecHeadSlot
    a owl:NamedIndividual , fst:ProperPartSlot ;
    rdfs:label "head slot of the bolt specification"@en-US ;
    iof:hasFiller ex:BoltHeadSpec .
ex:BoltHeadSpec
    a owl:NamedIndividual , fst:FastenerHeadSpecification ;
    rdfs:label "bolt head specification"@en-US ;
    iof:hasSlot ex:HeadHeightSlot , ex:HeadDiameterSlot .

ex:HeadHeightSlot
    a owl:NamedIndividual , iof:QualitySlot ;
    rdfs:label "height slot of the head specification"@en-US ;
    iof:hasFiller ex:HeadHeight2_7Spec .
ex:HeadHeight2_7Spec
    a owl:NamedIndividual , fst:HeadHeightSpecification ;
    rdfs:label "2.7 mm head height specification"@en-US ;
    iof:hasSlot ex:HeadHeight2_7ValueSlot .
ex:HeadHeight2_7ValueSlot
    a owl:NamedIndividual , iof:ValueSlot ;
    rdfs:label "value slot of the 2.7 mm head height specification"@en-US ;
    iof:hasFiller ex:Height2_7mm .
ex:Height2_7mm
    a owl:NamedIndividual , iof:ValueExpression ;
    rdfs:label "2.7 mm (specified)"@en-US ;
    iof:hasSimpleExpressionValue "2.7"^^xsd:decimal ;
    qudt:hasUnit unit:MilliM .

ex:HeadDiameterSlot
    a owl:NamedIndividual , iof:QualitySlot ;
    rdfs:label "diameter slot of the head specification"@en-US ;
    iof:hasFiller ex:HeadDiameter12_5Spec .
ex:HeadDiameter12_5Spec
    a owl:NamedIndividual , fst:HeadDiameterSpecification ;
    rdfs:label "12.5 mm head diameter specification"@en-US ;
    iof:hasSlot ex:HeadDiameter12_5ValueSlot .
ex:HeadDiameter12_5ValueSlot
    a owl:NamedIndividual , iof:ValueSlot ;
    rdfs:label "value slot of the 12.5 mm head diameter specification"@en-US ;
    iof:hasFiller ex:Diameter12_5mm .
ex:Diameter12_5mm
    a owl:NamedIndividual , iof:ValueExpression ;
    rdfs:label "12.5 mm (specified)"@en-US ;
    iof:hasSimpleExpressionValue "12.5"^^xsd:decimal ;
    qudt:hasUnit unit:MilliM .

# --- Shank: 25 mm long (L), with an M6 x 1.0 external thread ------------------

ex:BoltSpecShankSlot
    a owl:NamedIndividual , fst:ProperPartSlot ;
    rdfs:label "shank slot of the bolt specification"@en-US ;
    iof:hasFiller ex:BoltShankSpec .
ex:BoltShankSpec
    a owl:NamedIndividual , fst:ShankSpecification ;
    rdfs:label "25 mm fully threaded shank specification"@en-US ;
    iof:hasSlot ex:ShankLengthSlot , ex:ShankThreadSlot .

ex:ShankLengthSlot
    a owl:NamedIndividual , iof:QualitySlot ;
    rdfs:label "length slot of the shank specification"@en-US ;
    iof:hasFiller ex:ShankLength25Spec .
ex:ShankLength25Spec
    a owl:NamedIndividual , fst:ShankLengthSpecification ;
    rdfs:label "25 mm shank length specification"@en-US ;
    iof:hasSlot ex:ShankLength25ValueSlot .
ex:ShankLength25ValueSlot
    a owl:NamedIndividual , iof:ValueSlot ;
    rdfs:label "value slot of the 25 mm shank length specification"@en-US ;
    iof:hasFiller ex:Length25mm .
ex:Length25mm
    a owl:NamedIndividual , iof:ValueExpression ;
    rdfs:label "25 mm (specified)"@en-US ;
    iof:hasSimpleExpressionValue "25.0"^^xsd:decimal ;
    qudt:hasUnit unit:MilliM .

ex:ShankThreadSlot
    a owl:NamedIndividual , fst:ProperPartSlot ;
    rdfs:label "thread slot of the shank specification"@en-US ;
    iof:hasFiller ex:M6x1ThreadSpec .
ex:M6x1ThreadSpec
    a owl:NamedIndividual , fst:ExternalThreadSpecification ;
    rdfs:label "M6 x 1.0 external thread specification"@en-US ;
    iof:hasSlot ex:ThreadDiameterSlot , ex:ThreadPitchSlot .

ex:ThreadDiameterSlot
    a owl:NamedIndividual , iof:QualitySlot ;
    rdfs:label "major diameter slot of the thread specification"@en-US ;
    iof:hasFiller ex:ThreadMajorDiameter6Spec .
ex:ThreadMajorDiameter6Spec
    a owl:NamedIndividual , fst:ThreadMajorDiameterSpecification ;
    rdfs:label "6 mm thread major diameter specification"@en-US ;
    iof:hasSlot ex:ThreadMajorDiameter6ValueSlot .
ex:ThreadMajorDiameter6ValueSlot
    a owl:NamedIndividual , iof:ValueSlot ;
    rdfs:label "value slot of the 6 mm thread major diameter specification"@en-US ;
    iof:hasFiller ex:Diameter6mm .
ex:Diameter6mm
    a owl:NamedIndividual , iof:ValueExpression ;
    rdfs:label "6 mm (specified)"@en-US ;
    iof:hasSimpleExpressionValue "6.0"^^xsd:decimal ;
    qudt:hasUnit unit:MilliM .

ex:ThreadPitchSlot
    a owl:NamedIndividual , iof:QualitySlot ;
    rdfs:label "pitch slot of the thread specification"@en-US ;
    iof:hasFiller ex:ThreadPitch1Spec .
ex:ThreadPitch1Spec
    a owl:NamedIndividual , fst:ThreadPitchSpecification ;
    rdfs:label "1.0 mm thread pitch specification"@en-US ;
    iof:hasSlot ex:ThreadPitch1ValueSlot .
ex:ThreadPitch1ValueSlot
    a owl:NamedIndividual , iof:ValueSlot ;
    rdfs:label "value slot of the 1.0 mm thread pitch specification"@en-US ;
    iof:hasFiller ex:Pitch1mm .
ex:Pitch1mm
    a owl:NamedIndividual , iof:ValueExpression ;
    rdfs:label "1.0 mm (specified)"@en-US ;
    iof:hasSimpleExpressionValue "1.0"^^xsd:decimal ;
    qudt:hasUnit unit:MilliM .

ex:ASIN_B0FFG4R3KW
    a owl:NamedIndividual , iof:Identifier ;
    rdfs:label "Amazon ASIN B0FFG4R3KW"@en-US ;
    rdfs:comment "Identifies the product sold on Amazon, which is the set of 10 bolts and 1 hex key, so it designates the bolt set specification."@en-US ;
    skos:notation "B0FFG4R3KW" .

# ===========================================================================
# Bolt set design specification (a 10-bolt slot + 1 hex key slot), and the hex key
# ===========================================================================

ex:M6x25BoltSetSpec
    a owl:NamedIndividual , fst:FastenerSetSpecification ;
    rdfs:label "WYLWLS M6 x 25 mm bolt set design specification (10 bolts and 1 hex key)"@en-US ;
    rdfs:comment "The ten bolts are one aggregate part slot, filled by a quantity specification whose member part slot is filled by the bolt specification and whose count slot is filled by 10. The hex key is a member part slot. The count is a value, not a cardinality restriction, so a reasoner does not build ten anonymous bolts; SetCount.rq checks it. Members are related 'at some time' because a bolt stops being a member of the set once it is taken out and installed."@en-US ;
    iof:designatedBy ex:ASIN_B0FFG4R3KW ;
    iof:hasSlot ex:BoltSetBoltsSlot , ex:BoltSetHexKeySlot .

ex:BoltSetBoltsSlot
    a owl:NamedIndividual , fst:AggregatePartSlot ;
    rdfs:label "bolts slot of the bolt set specification"@en-US ;
    iof:hasFiller ex:TenBoltsSpec .
ex:TenBoltsSpec
    a owl:NamedIndividual , fst:FastenerQuantitySpecification ;
    rdfs:label "10 M6 x 25 mm bolts specification"@en-US ;
    iof:hasSlot ex:TenBoltsMemberSlot , ex:TenBoltsCountSlot .
ex:TenBoltsMemberSlot
    a owl:NamedIndividual , fst:MemberPartSlot ;
    rdfs:label "member slot of the 10 bolts specification"@en-US ;
    iof:hasFiller ex:M6x25ButtonHeadSocketCapBoltSpec .
ex:TenBoltsCountSlot
    a owl:NamedIndividual , fst:CountSlot ;
    rdfs:label "count slot of the 10 bolts specification"@en-US ;
    iof:hasFiller ex:Count10 .
ex:Count10
    a owl:NamedIndividual , fst:CountExpression ;
    rdfs:label "10 (specified)"@en-US ;
    iof:hasSimpleExpressionValue "10"^^xsd:integer .

ex:BoltSetHexKeySlot
    a owl:NamedIndividual , fst:MemberPartSlot ;
    rdfs:label "hex key slot of the bolt set specification"@en-US ;
    iof:hasFiller ex:HexKey4mmSpec .

ex:BoltBox01
    a owl:NamedIndividual , fst:BoltSet ;
    rdfs:label "M6 x 25 mm bolt box 01"@en-US ;
    rdfs:comment "One physical box of the bolt set. Only Bolt01 and HexKey01 are described; the bolt set specification implies the other nine bolts."@en-US ;
    iof:prescribedBy ex:M6x25BoltSetSpec ;
    iof:hasRole ex:BoltBox01ProductRole ;
    bfo:BFO_0000115 ex:Bolt01 , ex:HexKey01 .   # has member part at some time

ex:BoltBox01ProductRole
    a owl:NamedIndividual , iof:MaterialProductRole ;
    rdfs:label "material product role of bolt box 01"@en-US .

ex:HexKey4mmSpec
    a owl:NamedIndividual , fst:HexKeySpecification ;
    rdfs:label "4 mm hex key design specification"@en-US ;
    iof:hasSlot ex:HexKeySpecSizeSlot .

ex:HexKeySpecSizeSlot
    a owl:NamedIndividual , iof:QualitySlot ;
    rdfs:label "size slot of the hex key specification"@en-US ;
    iof:hasFiller ex:HexKeySize4Spec .
ex:HexKeySize4Spec
    a owl:NamedIndividual , fst:HexKeySizeSpecification ;
    rdfs:label "4 mm hex key size specification"@en-US ;
    iof:hasSlot ex:HexKeySize4ValueSlot .
ex:HexKeySize4ValueSlot
    a owl:NamedIndividual , iof:ValueSlot ;
    rdfs:label "value slot of the 4 mm hex key size specification"@en-US ;
    iof:hasFiller ex:Size4mm .
ex:Size4mm
    a owl:NamedIndividual , iof:ValueExpression ;
    rdfs:label "4 mm (specified)"@en-US ;
    iof:hasSimpleExpressionValue "4.0"^^xsd:decimal ;
    qudt:hasUnit unit:MilliM .

ex:HexKey01
    a owl:NamedIndividual , fst:HexKey ;
    rdfs:label "4 mm hex key 01"@en-US ;
    iof:prescribedBy ex:HexKey4mmSpec ;
    iof:hasFunction ex:HexKey01DrivingFunction ;
    iof:hasQuality ex:HexKey01Size .

ex:HexKey01Size
    a owl:NamedIndividual , fst:HexKeySize ;
    iof:prescribedBy ex:HexKeySize4Spec ;
    rdfs:label "size of hex key 01"@en-US ;
    iof:hasValueExpressionAtAllTimes ex:HexKey01SizeValue .
ex:HexKey01SizeValue
    a owl:NamedIndividual , iof:ValueExpression ;
    rdfs:label "4 mm"@en-US ;
    iof:hasSimpleExpressionValue "4.0"^^xsd:decimal ;
    qudt:hasUnit unit:MilliM .

ex:HexKey01DrivingFunction
    a owl:NamedIndividual , fst:DrivingFunction ;
    rdfs:label "driving function of hex key 01"@en-US .

# ===========================================================================
# One bolt
#
# Bolt01 is asserted only as a material artifact. Its function and parts let
# a reasoner classify it as a fastener, a bolt, a hex socket bolt, and a
# button head hex socket cap bolt.
# ===========================================================================

ex:Bolt01
    a owl:NamedIndividual , iof:MaterialArtifact ;
    rdfs:label "M6 x 25 mm button head hex socket cap bolt 01"@en-US ;
    iof:prescribedBy ex:M6x25ButtonHeadSocketCapBoltSpec ;
    iof:hasFunction ex:Bolt01FasteningFunction ;
    iof:isMadeOfAtAllTimes ex:Bolt01Steel ;
    bfo:BFO_0000111 ex:Bolt01Head , ex:Bolt01Shank , ex:Bolt01Coating .   # has proper continuant part at all times

ex:Bolt01FasteningFunction
    a owl:NamedIndividual , fst:FasteningFunction ;
    rdfs:label "fastening function of bolt 01"@en-US .

ex:Bolt01Steel
    a owl:NamedIndividual , fst:PortionOfAlloySteel ;
    iof:prescribedBy ex:AlloySteelSpec ;
    rdfs:label "alloy steel of bolt 01"@en-US .

# --- Parts -----------------------------------------------------------------

ex:Bolt01Head
    a owl:NamedIndividual , fst:ButtonHead ;
    iof:prescribedBy ex:BoltHeadSpec ;
    rdfs:label "button head of bolt 01"@en-US ;
    fst:hasRecess ex:Bolt01Socket ;
    iof:hasQuality ex:Bolt01HeadHeight , ex:Bolt01HeadDiameter .

ex:Bolt01Socket
    a owl:NamedIndividual , fst:HexSocketRecess ;
    rdfs:label "hex socket of bolt 01"@en-US ;
    iof:hasQuality ex:Bolt01DriveSize .

ex:Bolt01Shank
    a owl:NamedIndividual , fst:Shank ;
    iof:prescribedBy ex:BoltShankSpec ;
    rdfs:label "shank of bolt 01"@en-US ;
    rdfs:comment "Fully threaded: the thread runs the full length of the shank."@en-US ;
    bfo:BFO_0000111 ex:Bolt01Thread ;
    iof:hasQuality ex:Bolt01ShankLength .

ex:Bolt01Thread
    a owl:NamedIndividual , fst:ExternalThread ;
    iof:prescribedBy ex:M6x1ThreadSpec ;
    rdfs:label "M6 x 1.0 external thread of bolt 01"@en-US ;
    iof:hasQuality ex:Bolt01ThreadDiameter , ex:Bolt01ThreadPitch .

ex:Bolt01Coating
    a owl:NamedIndividual , fst:BlackOxideCoating ;
    iof:prescribedBy ex:BlackOxideCoatingSpec ;
    rdfs:label "black oxide coating of bolt 01"@en-US .

# --- Dimensional qualities and their nominal value expressions -------------

ex:Bolt01ShankLength
    a owl:NamedIndividual , fst:ShankLength ;
    iof:prescribedBy ex:ShankLength25Spec ;
    rdfs:label "shank length of bolt 01"@en-US ;
    iof:hasValueExpressionAtAllTimes ex:Bolt01ShankLengthValue .
ex:Bolt01ShankLengthValue
    a owl:NamedIndividual , iof:ValueExpression ;
    rdfs:label "25 mm"@en-US ;
    iof:hasSimpleExpressionValue "25.0"^^xsd:decimal ;
    qudt:hasUnit unit:MilliM .

ex:Bolt01ThreadDiameter
    a owl:NamedIndividual , fst:ThreadMajorDiameter ;
    iof:prescribedBy ex:ThreadMajorDiameter6Spec ;
    rdfs:label "thread major diameter of bolt 01"@en-US ;
    iof:hasValueExpressionAtAllTimes ex:Bolt01ThreadDiameterValue .
ex:Bolt01ThreadDiameterValue
    a owl:NamedIndividual , iof:ValueExpression ;
    rdfs:label "6 mm (M6)"@en-US ;
    iof:hasSimpleExpressionValue "6.0"^^xsd:decimal ;
    qudt:hasUnit unit:MilliM .

ex:Bolt01ThreadPitch
    a owl:NamedIndividual , fst:ThreadPitch ;
    iof:prescribedBy ex:ThreadPitch1Spec ;
    rdfs:label "thread pitch of bolt 01"@en-US ;
    iof:hasValueExpressionAtAllTimes ex:Bolt01ThreadPitchValue .
ex:Bolt01ThreadPitchValue
    a owl:NamedIndividual , iof:ValueExpression ;
    rdfs:label "1.0 mm"@en-US ;
    iof:hasSimpleExpressionValue "1.0"^^xsd:decimal ;
    qudt:hasUnit unit:MilliM .

ex:Bolt01HeadHeight
    a owl:NamedIndividual , fst:HeadHeight ;
    iof:prescribedBy ex:HeadHeight2_7Spec ;
    rdfs:label "head height of bolt 01"@en-US ;
    iof:hasValueExpressionAtAllTimes ex:Bolt01HeadHeightValue .
ex:Bolt01HeadHeightValue
    a owl:NamedIndividual , iof:ValueExpression ;
    rdfs:label "2.7 mm"@en-US ;
    iof:hasSimpleExpressionValue "2.7"^^xsd:decimal ;
    qudt:hasUnit unit:MilliM .

ex:Bolt01HeadDiameter
    a owl:NamedIndividual , fst:HeadDiameter ;
    iof:prescribedBy ex:HeadDiameter12_5Spec ;
    rdfs:label "head diameter of bolt 01"@en-US ;
    iof:hasValueExpressionAtAllTimes ex:Bolt01HeadDiameterValue .
ex:Bolt01HeadDiameterValue
    a owl:NamedIndividual , iof:ValueExpression ;
    rdfs:label "12.5 mm"@en-US ;
    iof:hasSimpleExpressionValue "12.5"^^xsd:decimal ;
    qudt:hasUnit unit:MilliM .

ex:Bolt01DriveSize
    a owl:NamedIndividual , fst:DriveSize ;
    rdfs:label "drive size of bolt 01"@en-US ;
    iof:hasValueExpressionAtAllTimes ex:Bolt01DriveSizeValue .
ex:Bolt01DriveSizeValue
    a owl:NamedIndividual , iof:ValueExpression ;
    rdfs:label "4 mm"@en-US ;
    iof:hasSimpleExpressionValue "4.0"^^xsd:decimal ;
    qudt:hasUnit unit:MilliM .

# ===========================================================================
# Manufacturer, purchase order, price and delivery schedule
# (IOF Core and IOF Supply Chain terms)
#
#   WYLWLS --participates in--> WYLWLSProduction01 --specified output--> BoltBox01, Bolt01
#   PurchaseOrder01 --is about--> BoltBox01
#     has part: PurchaseOrder01Price (EUR 5.38, for the whole set)
#     has part: PurchaseOrder01DeliverySchedule --has part--> delivery date 2026-11-13
# ===========================================================================

# --- Manufacturer ----------------------------------------------------------

ex:WYLWLS
    a owl:NamedIndividual , iof:BusinessOrganization ;
    rdfs:label "WYLWLS"@en-US ;
    rdfs:comment "Brand and seller of the bolt set on Amazon; modeled as the manufacturer and the supplier."@en-US ;
    iof:designatedBy ex:WYLWLSName ;
    iof:hasRole ex:WYLWLSManufacturerRole , ex:WYLWLSSupplierRole .

ex:WYLWLSName
    a owl:NamedIndividual , iof:OrganizationIdentifier ;
    rdfs:label "WYLWLS (brand name)"@en-US ;
    skos:notation "WYLWLS" .

ex:WYLWLSManufacturerRole
    a owl:NamedIndividual , iof:ManufacturerRole ;
    rdfs:label "manufacturer role of WYLWLS"@en-US .

ex:WYLWLSSupplierRole
    a owl:NamedIndividual , iof:SupplierRole ;
    rdfs:label "supplier role of WYLWLS"@en-US .

ex:WYLWLSProduction01
    a owl:NamedIndividual , iof:ProductProductionProcess ;
    rdfs:label "WYLWLS production of bolt box 01"@en-US ;
    bfo:BFO_0000057 ex:WYLWLS ;                         # has participant at some time
    iof:hasSpecifiedOutput ex:BoltBox01 , ex:Bolt01 , ex:HexKey01 .

# --- Purchase order --------------------------------------------------------

ex:PurchaseOrder01
    a owl:NamedIndividual , iof:PurchaseOrder ;
    rdfs:label "purchase order 01 for one WYLWLS M6 x 25 mm bolt set"@en-US ;
    iof:isAbout ex:BoltBox01 ;
    bfo:BFO_0000110 ex:PurchaseOrder01Price ,           # has continuant part at all times
                    ex:PurchaseOrder01DeliverySchedule .

ex:PurchaseOrder01Price
    a owl:NamedIndividual , iof:ValueExpression ;
    rdfs:label "EUR 5.38"@en-US ;
    rdfs:comment "Agreed price for the whole bolt set (10 bolts and 1 hex key), not for a single bolt."@en-US ;
    iof:hasSimpleExpressionValue "5.38"^^xsd:decimal ;
    qudt:hasUnit unit:CCY_EUR .

ex:PurchaseOrder01DeliverySchedule
    a owl:NamedIndividual , iof:ShipmentPlanSpecification ;
    rdfs:label "delivery schedule of purchase order 01"@en-US ;
    iof:isAbout ex:BoltBox01 ;
    bfo:BFO_0000110 ex:PurchaseOrder01DeliveryDate .    # has continuant part at all times

ex:PurchaseOrder01DeliveryDate
    a owl:NamedIndividual , iof:TemporalInstantValueExpression ;
    rdfs:label "planned delivery date 2026-11-13"@en-US ;
    iof:hasDateTimeInstantValue "2026-11-13T00:00:00"^^xsd:dateTime .
