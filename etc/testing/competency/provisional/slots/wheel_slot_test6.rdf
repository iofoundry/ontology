<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
 xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:iof="https://spec.industrialontologies.org/ontology/construct/"
 xmlns:ex="https://example.org/wheel-slot/" xmlns:iof-av="https://spec.industrialontologies.org/ontology/annotation/">
  <owl:Ontology rdf:about="https://example.org/wheel-slot/invalid">
    <rdfs:label xml:lang="en-US">Wheel slot invalid filler example</rdfs:label>
    <rdfs:comment xml:lang="en-US">Standalone offline demonstration with a minimal IOF vocabulary fragment. Expected consistency: inconsistent. Load separately from the other case.</rdfs:comment>
  </owl:Ontology>
  
  <!-- A minimal offline IOF vocabulary fragment, not a replacement for Core. -->
  <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
  <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/InformationSlot">
    <owl:disjointWith rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
    <rdfs:subClassOf><owl:Restriction>
      <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isSlotOf"/>
      <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
    </owl:Restriction></rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ComponentSlot">
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationSlot"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/isSlotOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationSlot"/>
    <rdfs:range rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/hasFiller">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationSlot"/>
    <rdfs:range rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/isAbout">
    <rdfs:domain rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
  </owl:ObjectProperty>

  <owl:Class rdf:about="https://example.org/wheel-slot/ProductSpecification">
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
    <rdfs:label xml:lang="en-US">product specification</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/wheel-slot/Wheel">
    <rdfs:label xml:lang="en-US">wheel</rdfs:label>
    <!-- Existence closes the empty-diameter loophole. -->
    <rdfs:subClassOf><owl:Restriction>
      <owl:onProperty rdf:resource="https://example.org/wheel-slot/hasRimDiameterInInches"/>
      <owl:someValuesFrom><rdfs:Datatype>
      <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <owl:withRestrictions rdf:parseType="Collection">
        <rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0</xsd:minInclusive></rdf:Description>
      </owl:withRestrictions>
    </rdfs:Datatype></owl:someValuesFrom>
    </owl:Restriction></rdfs:subClassOf>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://example.org/wheel-slot/hasRimDiameterInInches">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://example.org/wheel-slot/Wheel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en-US">has rim diameter in inches</rdfs:label>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://example.org/wheel-slot/WheelSpecification">
    <rdfs:subClassOf rdf:resource="https://example.org/wheel-slot/ProductSpecification"/>
    <rdfs:label xml:lang="en-US">wheel specification</rdfs:label>
    <!-- Existence closes the empty-aboutness loophole. -->
    <rdfs:subClassOf><owl:Restriction>
      <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isAbout"/>
      <owl:someValuesFrom rdf:resource="https://example.org/wheel-slot/Wheel"/>
    </owl:Restriction></rdfs:subClassOf>
    <rdfs:subClassOf><owl:Restriction>
      <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isAbout"/>
      <owl:allValuesFrom rdf:resource="https://example.org/wheel-slot/Wheel"/>
    </owl:Restriction></rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/wheel-slot/SmallWheelSpecification">
      <rdfs:subClassOf rdf:resource="https://example.org/wheel-slot/WheelSpecification"/>
      <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isAbout"/>
        <owl:allValuesFrom><owl:Class><owl:intersectionOf rdf:parseType="Collection">
      <rdf:Description rdf:about="https://example.org/wheel-slot/Wheel"/>
      <owl:Restriction><owl:onProperty rdf:resource="https://example.org/wheel-slot/hasRimDiameterInInches"/>
        <owl:allValuesFrom><rdfs:Datatype>
      <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <owl:withRestrictions rdf:parseType="Collection">
        <rdf:Description><xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">16</xsd:maxInclusive></rdf:Description>
      </owl:withRestrictions>
    </rdfs:Datatype></owl:allValuesFrom>
      </owl:Restriction>
    </owl:intersectionOf></owl:Class></owl:allValuesFrom>
      </owl:Restriction></rdfs:subClassOf>
      <rdfs:label xml:lang="en-US">SmallWheelSpecification</rdfs:label>
    </owl:Class>
  <owl:Class rdf:about="https://example.org/wheel-slot/BigWheelSpecification">
      <rdfs:subClassOf rdf:resource="https://example.org/wheel-slot/WheelSpecification"/>
      <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isAbout"/>
        <owl:allValuesFrom><owl:Class><owl:intersectionOf rdf:parseType="Collection">
      <rdf:Description rdf:about="https://example.org/wheel-slot/Wheel"/>
      <owl:Restriction><owl:onProperty rdf:resource="https://example.org/wheel-slot/hasRimDiameterInInches"/>
        <owl:allValuesFrom><rdfs:Datatype>
      <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <owl:withRestrictions rdf:parseType="Collection">
        <rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">18</xsd:minInclusive></rdf:Description>
      </owl:withRestrictions>
    </rdfs:Datatype></owl:allValuesFrom>
      </owl:Restriction>
    </owl:intersectionOf></owl:Class></owl:allValuesFrom>
      </owl:Restriction></rdfs:subClassOf>
      <rdfs:label xml:lang="en-US">BigWheelSpecification</rdfs:label>
    </owl:Class>
  <owl:Class rdf:about="https://example.org/wheel-slot/SmallWheelSlot">
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ComponentSlot"/>
    <rdfs:label xml:lang="en-US">small wheel slot</rdfs:label>
    <iof-av:naturalLanguageDefinition xml:lang="en-US">component slot that can be filled only by a wheel specification about wheels with rim diameters no greater than 17 inches</iof-av:naturalLanguageDefinition>
    <rdfs:subClassOf><owl:Restriction>
      <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasFiller"/>
      <owl:allValuesFrom><owl:Class><owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="https://example.org/wheel-slot/WheelSpecification"/>
        <owl:Restriction><owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isAbout"/>
          <owl:allValuesFrom><owl:Class><owl:intersectionOf rdf:parseType="Collection">
      <rdf:Description rdf:about="https://example.org/wheel-slot/Wheel"/>
      <owl:Restriction><owl:onProperty rdf:resource="https://example.org/wheel-slot/hasRimDiameterInInches"/>
        <owl:allValuesFrom><rdfs:Datatype>
      <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
      <owl:withRestrictions rdf:parseType="Collection">
        <rdf:Description><xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">17</xsd:maxInclusive></rdf:Description>
      </owl:withRestrictions>
    </rdfs:Datatype></owl:allValuesFrom>
      </owl:Restriction>
    </owl:intersectionOf></owl:Class></owl:allValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf></owl:Class></owl:allValuesFrom>
    </owl:Restriction></rdfs:subClassOf>
  </owl:Class>

  <owl:NamedIndividual rdf:about="https://example.org/wheel-slot/rs1-hatchback-car-design">
    <rdf:type rdf:resource="https://example.org/wheel-slot/ProductSpecification"/>
    <rdfs:label xml:lang="en-US">RS1 hatchback car design</rdfs:label>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://example.org/wheel-slot/rs1-front-left-wheel-slot">
    <rdf:type rdf:resource="https://example.org/wheel-slot/SmallWheelSlot"/>
    <iof:isSlotOf rdf:resource="https://example.org/wheel-slot/rs1-hatchback-car-design"/>
    <iof:hasFiller rdf:resource="https://example.org/wheel-slot/big-wheel-spec"/>
    <rdfs:label xml:lang="en-US">RS1 front-left wheel slot</rdfs:label>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://example.org/wheel-slot/big-wheel-spec">
    <rdf:type rdf:resource="https://example.org/wheel-slot/BigWheelSpecification"/>
    <rdfs:label xml:lang="en-US">big-wheel-spec</rdfs:label>
  </owl:NamedIndividual>
</rdf:RDF>
