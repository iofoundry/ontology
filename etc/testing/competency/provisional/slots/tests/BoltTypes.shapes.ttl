@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix iof:  <https://spec.industrialontologies.org/ontology/construct/> .
@prefix fst:  <https://spec.industrialontologies.org/example/Fastener/> .
@prefix ex:   <https://spec.industrialontologies.org/example/FastenerExample/> .
@prefix t:    <https://spec.industrialontologies.org/example/FastenerExample/tests/> .

# Bolt01 is asserted only as an iof:MaterialArtifact; its bolt type has to be inferred
# from its parts (head shape and drive) through the defined classes in Fastener.ttl.
t:Bolt01IsButtonHeadSocketCapBolt
    a sh:NodeShape ;
    rdfs:label "Bolt01 is inferred to be a button head socket cap bolt" ;
    sh:targetNode ex:Bolt01 ;
    sh:class fst:ButtonHeadSocketCapBolt ;
    sh:message "ex:Bolt01 should be inferred to be a fst:ButtonHeadSocketCapBolt" .

t:ValueSlotsAreFilled
    a sh:NodeShape ;
    rdfs:label "Every value slot has a filler" ;
    sh:targetClass iof:ValueSlot ;
    sh:property [
        sh:path iof:hasFiller ;
        sh:minCount 1 ;
        sh:message "A value slot must be filled by the specified value" ;
    ] .
