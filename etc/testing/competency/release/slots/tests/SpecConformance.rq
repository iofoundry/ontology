# Value conformance check for slot-based design specifications.
#
# For every quality that is prescribed by a quality specification, compare the
# quality's value expression with the value expression in the specification's
# value slot. Returns one row per quality with status "ok", "value mismatch",
# "unit mismatch" or "no value".
#
#   quality ──prescribed by──▶ spec ──has slot──▶ value slot ──has filler──▶ specified value
#   quality ──has value expression at all times──────────────────────────▶ actual value
#
# Run over the asserted triples of Fastener.ttl, FastenerExample.ttl and any
# file with prescribed qualities, e.g. with rdflib:
#   g.query(open("fastener/SpecConformance.rq").read())

PREFIX iof:  <https://spec.industrialontologies.org/ontology/construct/>
PREFIX qudt: <http://qudt.org/schema/qudt/>

SELECT ?quality ?spec ?specified ?specifiedUnit ?actual ?actualUnit ?status
WHERE {
  ?quality iof:prescribedBy ?spec .
  ?spec iof:hasSlot ?valueSlot .
  ?valueSlot a iof:ValueSlot ;
             iof:hasFiller ?specValue .
  ?specValue iof:hasSimpleExpressionValue ?specified .
  OPTIONAL { ?specValue qudt:hasUnit ?specifiedUnit }
  OPTIONAL {
    ?quality iof:hasValueExpressionAtAllTimes ?value .
    ?value iof:hasSimpleExpressionValue ?actual .
    OPTIONAL { ?value qudt:hasUnit ?actualUnit }
  }
  BIND (IF(!BOUND(?actual), "no value",
        IF(?actual != ?specified, "value mismatch",
        IF(COALESCE(STR(?actualUnit), "") != COALESCE(STR(?specifiedUnit), ""), "unit mismatch", "ok"))) AS ?status)
}
ORDER BY ?status ?quality
