@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix bfo:      <http://purl.obolibrary.org/obo/> .
@prefix iof:      <https://spec.industrialontologies.org/ontology/construct/> .
@prefix iof-av:   <https://spec.industrialontologies.org/ontology/annotation/> .
@prefix fst:      <https://spec.industrialontologies.org/example/Fastener/> .

# ---------------------------------------------------------------------------
# Fastener ontology
# A domain extension of IOF Core: fasteners as material artifacts, their
# parts (head, shank, thread, drive recess, coating), and a taxonomy of bolts
# defined by head shape and drive.
#
# IOF Core term IRIs follow the local checkout in ../ontology
# (namespace https://spec.industrialontologies.org/ontology/construct/).
#
# Part relation used throughout:
#   bfo:BFO_0000111  has proper continuant part at all times
# ---------------------------------------------------------------------------

<https://spec.industrialontologies.org/example/Fastener/>
    a owl:Ontology ;
    rdfs:label "Fastener Ontology"@en-US ;
    dcterms:title "ConnectSpec Fastener Ontology" ;
    dcterms:abstract "Extends the IOF Core Ontology with fasteners, treated as material artifacts that bear a fastening function, their parts, and a taxonomy of bolts defined by head shape and drive type. Fastener design specifications use the IOF information slot pattern: a specification has slots filled by the specifications of its parts and qualities."@en-US ;
    dcterms:creator "Will Sobel" ;
    dcterms:license "http://opensource.org/licenses/MIT"^^xsd:anyURI ;
    owl:imports <https://spec.industrialontologies.org/ontology/core/Core/> ,
                <https://spec.industrialontologies.org/ontology/biopharma/BiopharmaReferenceOntologyAttributes/> ,
                <https://spec.industrialontologies.org/ontology/biopharma/BiopharmaMaterial/> ;
    owl:versionInfo "0.7.0" .

# ===========================================================================
# Object properties
# ===========================================================================

fst:hasRecess
    a owl:ObjectProperty ;
    rdfs:domain bfo:BFO_0000040 ;
    rdfs:range bfo:BFO_0000029 ;
    owl:inverseOf fst:recessOf ;
    rdfs:label "has recess"@en-US ;
    iof-av:naturalLanguageDefinition "relation from a material entity to a site that is a cavity open to the surface of that material entity and bounded by it"@en-US ;
    iof-av:explanatoryNote "BFO 2020 has no relation between a material entity and a site it partly surrounds, so this is introduced locally. Candidates for replacement if IOF Core adds one."@en-US ;
    skos:example "the head of a socket bolt has recess its hexagonal drive socket"@en-US .

fst:recessOf
    a owl:ObjectProperty ;
    rdfs:domain bfo:BFO_0000029 ;
    rdfs:range bfo:BFO_0000040 ;
    rdfs:label "recess of"@en-US ;
    iof-av:naturalLanguageDefinition "inverse of 'has recess'"@en-US .

fst:hasThreadMajorDiameter
    a owl:ObjectProperty ;
    rdfs:range fst:ThreadMajorDiameter ;
    owl:propertyChainAxiom (
        bfo:BFO_0000111            # has proper continuant part at all times (e.g. bolt -> shank)
        bfo:BFO_0000111            # has proper continuant part at all times (e.g. shank -> external thread)
        iof:hasQuality             # thread -> its qualities
        fst:isThreadMajorDiameter  # keep only the thread major diameter
    ) ;
    rdfs:label "has thread major diameter"@en-US ;
    iof-av:naturalLanguageDefinition "relation from a material entity to the thread major diameter of a screw thread that is a part of a part of that material entity"@en-US ;
    iof-av:explanatoryNote "Shortcut inferred from the chain: has proper continuant part at all times, has proper continuant part at all times, has quality, is thread major diameter. Assert the full path in data and let a reasoner infer this relation; do not assert it directly. Because it is defined by a property chain it is not a simple property, so it cannot be used in cardinality restrictions."@en-US ;
    skos:example "a bolt has thread major diameter the 6 mm major diameter of the external thread on its shank"@en-US .

fst:isThreadMajorDiameter
    a owl:ObjectProperty ;
    rdfs:domain fst:ThreadMajorDiameter ;
    rdfs:range fst:ThreadMajorDiameter ;
    rdfs:label "is thread major diameter"@en-US ;
    iof-av:naturalLanguageDefinition "helper relation that holds only from a thread major diameter to itself"@en-US ;
    iof-av:explanatoryNote "Technical helper for the property chain of 'has thread major diameter'. OWL property chains cannot filter by class, so this self relation, asserted on every thread major diameter by a hasSelf restriction, ends the chain only at thread major diameters. Not intended for use in data."@en-US .

# ===========================================================================
# Functions
# ===========================================================================

fst:FasteningFunction
    a owl:Class ;
    rdfs:subClassOf iof:DesignedFunction ;
    rdfs:label "fastening function"@en-US ;
    iof-av:naturalLanguageDefinition "designed function of a material artifact that is realized in a process in which two or more material entities are mechanically joined and held together"@en-US ;
    skos:example "the fastening function of a bolt that clamps a table leg to a table top; the fastening function of a rivet that joins two sheet-metal panels"@en-US .

fst:DrivingFunction
    a owl:Class ;
    rdfs:subClassOf iof:DesignedFunction ;
    rdfs:label "driving function"@en-US ;
    iof-av:naturalLanguageDefinition "designed function of a tool that is realized in a process in which the tool engages the drive feature of a fastener and transmits torque to it to tighten or loosen it"@en-US ;
    skos:example "the driving function of a hex key; the driving function of a screwdriver bit; the driving function of a socket wrench"@en-US .

# ===========================================================================
# Fastener parts
# ===========================================================================

# --- Heads -----------------------------------------------------------------

fst:FastenerHead
    a owl:Class ;
    rdfs:subClassOf bfo:BFO_0000024 ,
        [ a owl:Restriction ;
          owl:onProperty iof:hasQuality ;
          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass fst:HeadHeight ] ,
        [ a owl:Restriction ;
          owl:onProperty iof:hasQuality ;
          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass fst:HeadDiameter ] ;
    rdfs:label "fastener head"@en-US ;
    iof-av:naturalLanguageDefinition "fiat object part of a fastener, at one end of it, that is enlarged relative to the shank and transmits clamping load to the fastened parts"@en-US .

fst:CountersunkHead
    a owl:Class ;
    rdfs:subClassOf fst:FastenerHead ;
    rdfs:label "countersunk head"@en-US ;
    iof-av:naturalLanguageDefinition "fastener head with a flat top and a conical underside designed to sit in a countersunk hole flush with the surface"@en-US ;
    iof-av:synonym "flat head"@en-US .

fst:CylindricalHead
    a owl:Class ;
    rdfs:subClassOf fst:FastenerHead ;
    rdfs:label "cylindrical head"@en-US ;
    iof-av:naturalLanguageDefinition "fastener head shaped as a right circular cylinder"@en-US ;
    iof-av:synonym "cap head"@en-US .

fst:ButtonHead
    a owl:Class ;
    rdfs:subClassOf fst:FastenerHead ;
    rdfs:label "button head"@en-US ;
    iof-av:naturalLanguageDefinition "low fastener head with a flat bearing face and a domed top"@en-US .

fst:HexagonalHead
    a owl:Class ;
    rdfs:subClassOf fst:FastenerHead ;
    rdfs:label "hexagonal head"@en-US ;
    iof-av:naturalLanguageDefinition "fastener head shaped as a hexagonal prism, designed to be turned by an external wrench"@en-US .

fst:DomedHead
    a owl:Class ;
    rdfs:subClassOf fst:FastenerHead ;
    rdfs:label "domed head"@en-US ;
    iof-av:naturalLanguageDefinition "smooth, rounded fastener head with no drive feature"@en-US ;
    iof-av:synonym "mushroom head"@en-US .

[ a owl:AllDisjointClasses ;
  owl:members ( fst:CountersunkHead fst:CylindricalHead fst:ButtonHead fst:HexagonalHead fst:DomedHead ) ] .

# --- Shank and thread ------------------------------------------------------

fst:Shank
    a owl:Class ;
    rdfs:subClassOf bfo:BFO_0000024 ,
        [ a owl:Restriction ;
          owl:onProperty iof:hasQuality ;
          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass fst:ShankLength ] ;
    rdfs:label "shank"@en-US ;
    iof-av:naturalLanguageDefinition "fiat object part of a fastener that is the elongated body extending from the head"@en-US .

fst:ScrewThread
    a owl:Class ;
    rdfs:subClassOf bfo:BFO_0000024 ,
        [ a owl:Restriction ;
          owl:onProperty iof:hasQuality ;
          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass fst:ThreadMajorDiameter ] ,
        [ a owl:Restriction ;
          owl:onProperty iof:hasQuality ;
          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass fst:ThreadPitch ] ;
    rdfs:label "screw thread"@en-US ;
    iof-av:naturalLanguageDefinition "fiat object part of a material artifact that is a helical ridge formed on a cylindrical or conical surface"@en-US .

fst:ExternalThread
    a owl:Class ;
    rdfs:subClassOf fst:ScrewThread ;
    rdfs:label "external thread"@en-US ;
    iof-av:naturalLanguageDefinition "screw thread formed on the outside surface of a cylinder or cone"@en-US ;
    iof-av:synonym "male thread"@en-US .

fst:InternalThread
    a owl:Class ;
    rdfs:subClassOf fst:ScrewThread ;
    rdfs:label "internal thread"@en-US ;
    iof-av:naturalLanguageDefinition "screw thread formed on the inside surface of a hole"@en-US ;
    iof-av:synonym "female thread"@en-US .

[ a owl:AllDisjointClasses ;
  owl:members ( fst:FastenerHead fst:Shank fst:ScrewThread ) ] .

[ a owl:AllDisjointClasses ;
  owl:members ( fst:ExternalThread fst:InternalThread ) ] .

# --- Drive recess ----------------------------------------------------------

fst:DriveRecess
    a owl:Class ;
    rdfs:subClassOf bfo:BFO_0000029 ,
        [ a owl:Restriction ;
          owl:onProperty iof:hasQuality ;
          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass fst:DriveSize ] ;
    rdfs:label "drive recess"@en-US ;
    iof-av:naturalLanguageDefinition "site in the head of a fastener, shaped to receive a driving tool that transmits torque to the fastener"@en-US ;
    iof-av:explanatoryNote "A recess is a hole, so it is modeled as a BFO site (an immaterial entity bounded by the head), not as a material part."@en-US .

fst:HexSocketRecess
    a owl:Class ;
    rdfs:subClassOf fst:DriveRecess ;
    rdfs:label "hex socket recess"@en-US ;
    iof-av:naturalLanguageDefinition "drive recess with a hexagonal cross-section, designed to receive a hex key"@en-US ;
    iof-av:synonym "hex socket"@en-US , "Allen socket"@en-US .

# --- Coating ---------------------------------------------------------------

fst:Coating
    a owl:Class ;
    rdfs:subClassOf bfo:BFO_0000040 ;
    rdfs:label "coating"@en-US ;
    iof-av:naturalLanguageDefinition "material entity that is a thin layer bonded to the surface of a material artifact to protect it or change its surface properties"@en-US .

fst:BlackOxideCoating
    a owl:Class ;
    rdfs:subClassOf fst:Coating ;
    rdfs:label "black oxide coating"@en-US ;
    iof-av:naturalLanguageDefinition "coating of magnetite (Fe3O4) formed by chemical conversion of the surface of a ferrous material artifact"@en-US ;
    iof-av:synonym "black oxide finish"@en-US , "blackening"@en-US .

# ===========================================================================
# Fasteners
# ===========================================================================

fst:Fastener
    a owl:Class ;
    rdfs:subClassOf iof:MaterialArtifact ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            iof:MaterialArtifact
            [ a owl:Restriction ;
              owl:onProperty iof:hasFunction ;
              owl:someValuesFrom fst:FasteningFunction ]
        )
    ] ;
    rdfs:label "fastener"@en-US ;
    iof-av:naturalLanguageDefinition "material artifact that has a fastening function"@en-US ;
    iof-av:semiFormalNaturalLanguageDefinition "every instance of 'fastener' is defined as exactly an instance of 'material artifact' that 'has function' some 'fastening function'"@en-US ;
    iof-av:firstOrderLogicDefinition "Fastener(x) ↔ MaterialArtifact(x) ∧ ∃f(FasteningFunction(f) ∧ hasFunction(x,f))" ;
    skos:example "a bolt, a nut, a screw, a rivet"@en-US .

fst:ThreadedFastener
    a owl:Class ;
    rdfs:subClassOf fst:Fastener ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            fst:Fastener
            [ a owl:Restriction ;
              owl:onProperty bfo:BFO_0000111 ;
              owl:someValuesFrom fst:ScrewThread ]
        )
    ] ;
    rdfs:label "threaded fastener"@en-US ;
    iof-av:naturalLanguageDefinition "fastener that has a screw thread as a part"@en-US ;
    iof-av:semiFormalNaturalLanguageDefinition "every instance of 'threaded fastener' is defined as exactly an instance of 'fastener' that 'has proper continuant part at all times' some 'screw thread'"@en-US ;
    skos:example "a bolt, a nut, a wood screw, a threaded rod"@en-US .

fst:Bolt
    a owl:Class ;
    rdfs:subClassOf fst:ThreadedFastener ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            fst:Fastener
            [ a owl:Restriction ;
              owl:onProperty bfo:BFO_0000111 ;
              owl:someValuesFrom fst:FastenerHead ]
            [ a owl:Restriction ;
              owl:onProperty bfo:BFO_0000111 ;
              owl:someValuesFrom [
                  a owl:Class ;
                  owl:intersectionOf (
                      fst:Shank
                      [ a owl:Restriction ;
                        owl:onProperty bfo:BFO_0000111 ;
                        owl:someValuesFrom fst:ExternalThread ]
                  )
              ] ]
        )
    ] ;
    rdfs:label "bolt"@en-US ;
    iof-av:naturalLanguageDefinition "fastener that has a head and a shank with an external thread"@en-US ;
    iof-av:semiFormalNaturalLanguageDefinition "every instance of 'bolt' is defined as exactly an instance of 'fastener' that 'has proper continuant part at all times' some 'fastener head' and 'has proper continuant part at all times' some ('shank' that 'has proper continuant part at all times' some 'external thread')"@en-US ;
    iof-av:explanatoryNote "ASME B18.2.1 distinguishes a bolt (tightened by turning a nut) from a cap screw (tightened by turning the head into a tapped hole). In catalog and trade usage the terms are used interchangeably, so this ontology uses 'bolt' broadly and records 'screw' names as synonyms."@en-US .

# ---------------------------------------------------------------------------
# Bolts by head and drive
# ---------------------------------------------------------------------------

fst:HexHeadBolt
    a owl:Class ;
    rdfs:subClassOf fst:Bolt ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            fst:Bolt
            [ a owl:Restriction ;
              owl:onProperty bfo:BFO_0000111 ;
              owl:someValuesFrom fst:HexagonalHead ]
        )
    ] ;
    rdfs:label "hex head bolt"@en-US ;
    iof-av:naturalLanguageDefinition "bolt that has a hexagonal head"@en-US ;
    iof-av:synonym "hex cap screw"@en-US .

fst:CarriageBolt
    a owl:Class ;
    rdfs:subClassOf fst:Bolt ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            fst:Bolt
            [ a owl:Restriction ;
              owl:onProperty bfo:BFO_0000111 ;
              owl:someValuesFrom fst:DomedHead ]
        )
    ] ;
    rdfs:label "carriage bolt"@en-US ;
    iof-av:naturalLanguageDefinition "bolt that has a domed head"@en-US ;
    iof-av:explanatoryNote "Carriage bolts also have a square neck under the head that keeps them from turning; the neck is not yet modeled."@en-US .

fst:SocketHeadBolt
    a owl:Class ;
    rdfs:subClassOf fst:Bolt ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            fst:Bolt
            [ a owl:Restriction ;
              owl:onProperty bfo:BFO_0000111 ;
              owl:someValuesFrom [
                  a owl:Class ;
                  owl:intersectionOf (
                      fst:FastenerHead
                      [ a owl:Restriction ;
                        owl:onProperty fst:hasRecess ;
                        owl:someValuesFrom fst:HexSocketRecess ]
                  )
              ] ]
        )
    ] ;
    rdfs:label "hex socket bolt"@en-US ;
    iof-av:naturalLanguageDefinition "bolt whose head has a hex socket recess"@en-US ;
    iof-av:semiFormalNaturalLanguageDefinition "every instance of 'hex socket bolt' is defined as exactly an instance of 'bolt' that 'has proper continuant part at all times' some ('fastener head' that 'has recess' some 'hex socket recess')"@en-US ;
    iof-av:synonym "hex socket screw"@en-US , "Allen bolt"@en-US .

[ a owl:AllDisjointClasses ;
  owl:members ( fst:HexHeadBolt fst:CarriageBolt fst:SocketHeadBolt ) ] .

fst:SocketHeadCapBolt
    a owl:Class ;
    rdfs:subClassOf fst:SocketHeadBolt ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            fst:SocketHeadBolt
            [ a owl:Restriction ;
              owl:onProperty bfo:BFO_0000111 ;
              owl:someValuesFrom fst:CylindricalHead ]
        )
    ] ;
    rdfs:label "hex socket head cap bolt"@en-US ;
    iof-av:naturalLanguageDefinition "hex socket bolt that has a cylindrical head"@en-US ;
    iof-av:synonym "socket head cap screw"@en-US ;
    iof-av:explanatoryNote "Metric dimensions are specified in ISO 4762 (formerly DIN 912)."@en-US .

fst:ButtonHeadSocketCapBolt
    a owl:Class ;
    rdfs:subClassOf fst:SocketHeadBolt ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            fst:SocketHeadBolt
            [ a owl:Restriction ;
              owl:onProperty bfo:BFO_0000111 ;
              owl:someValuesFrom fst:ButtonHead ]
        )
    ] ;
    rdfs:label "button head hex socket cap bolt"@en-US ;
    iof-av:naturalLanguageDefinition "hex socket bolt that has a button head"@en-US ;
    iof-av:synonym "button head socket cap screw"@en-US ;
    iof-av:explanatoryNote "Metric dimensions are specified in ISO 7380. Low, wide button head bolts used in furniture are often sold as 'flat head' bolts; their length is measured from under the head, which shows the head is not countersunk."@en-US ;
    skos:example "an M6 x 25 mm alloy steel button head hex socket cap bolt used to join a crib rail to a crib post"@en-US .

fst:FlatHeadSocketCapBolt
    a owl:Class ;
    rdfs:subClassOf fst:SocketHeadBolt ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            fst:SocketHeadBolt
            [ a owl:Restriction ;
              owl:onProperty bfo:BFO_0000111 ;
              owl:someValuesFrom fst:CountersunkHead ]
        )
    ] ;
    rdfs:label "flat head hex socket cap bolt"@en-US ;
    iof-av:naturalLanguageDefinition "hex socket bolt that has a countersunk head"@en-US ;
    iof-av:semiFormalNaturalLanguageDefinition "every instance of 'flat head hex socket cap bolt' is defined as exactly an instance of 'hex socket bolt' that 'has proper continuant part at all times' some 'countersunk head'"@en-US ;
    iof-av:synonym "flat head socket cap screw"@en-US , "countersunk hex socket screw"@en-US ;
    iof-av:explanatoryNote "Metric dimensions are specified in ISO 10642 (formerly DIN 7991); the head has a 90° countersink angle. The length of a countersunk bolt is measured from the top of the head."@en-US .

[ a owl:AllDisjointClasses ;
  owl:members ( fst:SocketHeadCapBolt fst:ButtonHeadSocketCapBolt fst:FlatHeadSocketCapBolt ) ] .

# ===========================================================================
# Tools packaged with fasteners
# ===========================================================================

fst:HexKey
    a owl:Class ;
    rdfs:subClassOf iof:MaterialArtifact ,
        [ a owl:Restriction ;
          owl:onProperty iof:hasFunction ;
          owl:someValuesFrom fst:DrivingFunction ] ,
        [ a owl:Restriction ;
          owl:onProperty iof:hasQuality ;
          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass fst:HexKeySize ] ;
    rdfs:label "hex key"@en-US ;
    iof-av:naturalLanguageDefinition "material artifact with a hexagonal cross-section designed to engage a hex socket recess and transmit torque to the fastener"@en-US ;
    iof-av:synonym "Allen key"@en-US , "hex spanner"@en-US .

[ a owl:AllDisjointClasses ;
  owl:members ( fst:Fastener fst:HexKey ) ] .

# ===========================================================================
# Fastener sets
# ===========================================================================

fst:BoltSet
    a owl:Class ;
    rdfs:subClassOf bfo:BFO_0000027 ,               # object aggregate
        [ a owl:Restriction ;
          owl:onProperty bfo:BFO_0000115 ;          # has member part at some time
          owl:someValuesFrom fst:Bolt ] ;
    rdfs:label "bolt set"@en-US ;
    iof-av:naturalLanguageDefinition "object aggregate of bolts that are sold together, with or without the tool for installing them"@en-US ;
    iof-av:explanatoryNote "Members are related 'at some time' because a bolt stops being a member of the set once it is taken out and installed."@en-US ;
    skos:example "a box of ten M6 x 25 mm hex socket bolts and a 4 mm hex key"@en-US .

# ===========================================================================
# Materials
# ===========================================================================

fst:PortionOfAlloySteel
    a owl:Class ;
    rdfs:subClassOf iof:ChemicalSubstanceMaterial ;
    rdfs:label "portion of alloy steel"@en-US ;
    iof-av:naturalLanguageDefinition "chemical substance material that is a portion of steel alloyed with elements other than carbon (such as chromium, molybdenum, or nickel) to improve its mechanical properties"@en-US .

# ===========================================================================
# Dimensional qualities
# Specializations of 'length' and 'diameter' from the IOF Biopharma
# Reference Ontology Attributes (morphological quality > physical size).
# ===========================================================================

fst:LengthCharacteristic
    a owl:Class ;
    rdfs:subClassOf iof:Length ,
        [ a owl:Restriction ;
          owl:onProperty iof:hasValueExpressionAtAllTimes ;
          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass iof:ValueExpression ] ,
        [ a owl:Restriction ;
          owl:onProperty iof:hasValueExpressionAtAllTimes ;
          owl:allValuesFrom [
              a owl:Restriction ;
              owl:onProperty iof:hasSimpleExpressionValue ;
              owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ] ;
    rdfs:label "length characteristic"@en-US ;
    iof-av:naturalLanguageDefinition "length of a fastener, of a part of a fastener, or of a fastening tool that is stated by a single value expression with a single value"@en-US ;
    iof-av:explanatoryNote "The cardinality axioms keep each length characteristic to a single value expression with a single value, so it is stated in one unit only. Whether that value matches the value slot of the quality specification the characteristic is prescribed by is checked with SpecConformance.rq, not by the reasoner."@en-US .

fst:ShankLength
    a owl:Class ;
    rdfs:subClassOf fst:LengthCharacteristic ;
    rdfs:label "shank length"@en-US ;
    iof-av:naturalLanguageDefinition "length of the shank of a fastener measured along its axis, from the bearing face of the head to the end of the shank"@en-US ;
    iof-av:synonym "nominal length"@en-US , "L"@en-US ;
    iof-av:explanatoryNote "Bearer: the shank. This is the nominal length L in a bolt's designation (the 25 in M6 x 25). The head has its own head height (K) and head diameter (DK); they are not part of the shank length."@en-US .

fst:ThreadMajorDiameter
    a owl:Class ;
    rdfs:subClassOf iof:Diameter ,
        # same value-expression cardinality axioms as fst:LengthCharacteristic, repeated here
        # because IOF allows a single named parent class
        [ a owl:Restriction ;
          owl:onProperty iof:hasValueExpressionAtAllTimes ;
          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass iof:ValueExpression ] ,
        [ a owl:Restriction ;
          owl:onProperty iof:hasValueExpressionAtAllTimes ;
          owl:allValuesFrom [
              a owl:Restriction ;
              owl:onProperty iof:hasSimpleExpressionValue ;
              owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ] ,
        # every thread major diameter relates to itself; used by the hasThreadMajorDiameter chain
        [ a owl:Restriction ;
          owl:onProperty fst:isThreadMajorDiameter ;
          owl:hasSelf true ] ;
    rdfs:label "thread major diameter"@en-US ;
    iof-av:naturalLanguageDefinition "diameter of a screw thread measured at the crests of an external thread or the roots of an internal thread"@en-US ;
    iof-av:synonym "nominal thread diameter"@en-US ;
    iof-av:explanatoryNote "Bearer: the screw thread."@en-US .

fst:ThreadPitch
    a owl:Class ;
    rdfs:subClassOf fst:LengthCharacteristic ;
    rdfs:label "thread pitch"@en-US ;
    iof-av:naturalLanguageDefinition "length between corresponding points on adjacent threads, measured parallel to the thread axis"@en-US ;
    iof-av:explanatoryNote "Bearer: the screw thread."@en-US .

fst:HeadHeight
    a owl:Class ;
    rdfs:subClassOf fst:LengthCharacteristic ;
    rdfs:label "head height"@en-US ;
    iof-av:naturalLanguageDefinition "length of the head of a fastener measured along its axis"@en-US ;
    iof-av:synonym "K"@en-US ;
    iof-av:explanatoryNote "Bearer: the fastener head."@en-US .

fst:HeadDiameter
    a owl:Class ;
    rdfs:subClassOf iof:Diameter ,
        # same value-expression cardinality axioms as fst:LengthCharacteristic, repeated here
        # because IOF allows a single named parent class
        [ a owl:Restriction ;
          owl:onProperty iof:hasValueExpressionAtAllTimes ;
          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass iof:ValueExpression ] ,
        [ a owl:Restriction ;
          owl:onProperty iof:hasValueExpressionAtAllTimes ;
          owl:allValuesFrom [
              a owl:Restriction ;
              owl:onProperty iof:hasSimpleExpressionValue ;
              owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ] ;
    rdfs:label "head diameter"@en-US ;
    iof-av:naturalLanguageDefinition "diameter of the head of a fastener, measured across its widest part"@en-US ;
    iof-av:synonym "DK"@en-US ;
    iof-av:explanatoryNote "Bearer: the fastener head."@en-US .

fst:DriveSize
    a owl:Class ;
    rdfs:subClassOf fst:LengthCharacteristic ;
    rdfs:label "drive size"@en-US ;
    iof-av:naturalLanguageDefinition "length across the flats of a hexagonal drive recess"@en-US ;
    iof-av:explanatoryNote "Bearer: the drive recess (a site). BFO 2020 permits qualities of immaterial independent continuants."@en-US .

fst:HexKeySize
    a owl:Class ;
    rdfs:subClassOf fst:LengthCharacteristic ;
    rdfs:label "hex key size"@en-US ;
    iof-av:naturalLanguageDefinition "length across the flats of the hexagonal cross-section of a hex key"@en-US ;
    iof-av:explanatoryNote "Bearer: the hex key. A hex key fits a hex socket recess whose drive size equals the hex key size."@en-US .

# ===========================================================================
# IOF InformationSlot module terms used here
#
# The IOF InformationSlot module is not imported: it is still under review,
# and its definitions (value, count, time, location and participant slots, and
# the rules that infer them) make HermiT check every slot and take about ten
# times longer. The terms used here are declared with their parent class only.
# SlotModule.ttl imports the module for its full definitions.
# ===========================================================================

iof:ValueSlot
    a owl:Class ;
    rdfs:subClassOf iof:InformationSlot ;
    rdfs:label "value slot"@en-US ;
    iof-av:explanatoryNote "Declared here with its parent only, so this ontology does not import the IOF InformationSlot module, which is under review and makes HermiT much slower. Load SlotModule.ttl for the module's full definitions."@en-US .

iof:ComponentParthoodSlot
    a owl:Class ;
    rdfs:subClassOf iof:InformationSlot ;
    rdfs:label "component parthood slot"@en-US ;
    iof-av:explanatoryNote "Declared here with its parent only, so this ontology does not import the IOF InformationSlot module, which is under review and makes HermiT much slower. Load SlotModule.ttl for the module's full definitions."@en-US .

iof:FastenerSlot
    a owl:Class ;
    rdfs:subClassOf iof:InformationSlot ;
    rdfs:label "fastener slot"@en-US ;
    iof-av:explanatoryNote "Declared here with its parent only, so this ontology does not import the IOF InformationSlot module, which is under review and makes HermiT much slower. Load SlotModule.ttl for the module's full definitions."@en-US .

iof:CountSlot
    a owl:Class ;
    rdfs:subClassOf iof:InformationSlot ;
    rdfs:label "count slot"@en-US ;
    iof-av:explanatoryNote "Declared here with its parent only, so this ontology does not import the IOF InformationSlot module, which is under review and makes HermiT much slower. Load SlotModule.ttl for the module's full definitions."@en-US .

iof:CountExpression
    a owl:Class ;
    rdfs:subClassOf iof:ValueExpression ;
    rdfs:label "count expression"@en-US ;
    iof-av:explanatoryNote "Declared here with its parent only, so this ontology does not import the IOF InformationSlot module, which is under review and makes HermiT much slower. Load SlotModule.ttl for the module's full definitions."@en-US .

iof:AssemblySpecification
    a owl:Class ;
    rdfs:subClassOf iof:DesignSpecification ;
    rdfs:label "assembly specification"@en-US ;
    iof-av:explanatoryNote "Declared here with its parent only, so this ontology does not import the IOF InformationSlot module, which is under review and makes HermiT much slower. Load SlotModule.ttl for the module's full definitions."@en-US .

iof:FastenedJointSpecification
    a owl:Class ;
    rdfs:subClassOf iof:DesignSpecification ;
    rdfs:label "fastened joint specification"@en-US ;
    iof-av:explanatoryNote "Declared here with its parent only, so this ontology does not import the IOF InformationSlot module, which is under review and makes HermiT much slower. Load SlotModule.ttl for the module's full definitions."@en-US .

# ===========================================================================
# Information slots for design specifications
#
# Each slot type mirrors a physical relation. A specification's slot is filled
# by the specification of the related entity, so the specification graph has
# the same shape as the graph of a conforming fastener:
#
#   bolt spec ──quality slot──▶ length spec ──value slot──▶ 25 mm
#   bolt     ──has quality───▶ length     ──has value────▶ 25 mm
#
# Following slot/Hex_Bolt_Information_Slots.rdf, each slot type restricts what
# its filler and its owner (the information content entity it is a slot of)
# can be about. Only the 'isAbout only' half of the example's restrictions is
# used: the 'isAbout some' half would make a reasoner create an anonymous
# referent for every specification that is not about a particular entity.
# 'isAbout' rather than 'prescribes' lets a description (such as an inspection
# report) fill or own a slot as well as a specification.
#
# The restrictions type the fillers and owners only. Whether a fastener matches
# its specification's values is checked outside OWL (SpecConformance.rq).
# ===========================================================================

fst:QualitySlot
    a owl:Class ;
    rdfs:subClassOf iof:InformationSlot ,
        # filler
        [ a owl:Restriction ;
          owl:onProperty iof:hasFiller ;
          owl:allValuesFrom [ a owl:Class ;
                owl:intersectionOf ( iof:InformationContentEntity
                    [ a owl:Restriction ;
                      owl:onProperty iof:isAbout ;
                      owl:allValuesFrom bfo:BFO_0000019 ] ) ] ] ,
        # owner
        [ a owl:Restriction ;
          owl:onProperty iof:isSlotOf ;
          owl:allValuesFrom [ a owl:Class ;
                owl:intersectionOf ( iof:InformationContentEntity
                    [ a owl:Restriction ;
                      owl:onProperty iof:isAbout ;
                      owl:allValuesFrom [ a owl:Class ; owl:intersectionOf ( bfo:BFO_0000004 [ a owl:Class ; owl:complementOf bfo:BFO_0000006 ] ) ] ] ) ] ] ;
    rdfs:label "quality slot"@en-US ;
    iof-av:naturalLanguageDefinition "information slot whose filler is an information content entity about only qualities, and whose owner is an information content entity about only independent continuants that are not spatial regions; when filled, it prescribes or reports that the entity the owner is about has a quality ('has quality') that the filler is about"@en-US ;
    iof-av:explanatoryNote "Restrictions follow 'quality slot' in slot/Hex_Bolt_Information_Slots.rdf, without its 'isAbout some' parts."@en-US .

fst:ProperPartSlot
    a owl:Class ;
    rdfs:subClassOf iof:InformationSlot ,
        # filler
        [ a owl:Restriction ;
          owl:onProperty iof:hasFiller ;
          owl:allValuesFrom [ a owl:Class ;
                owl:intersectionOf ( iof:InformationContentEntity
                    [ a owl:Restriction ;
                      owl:onProperty iof:isAbout ;
                      owl:allValuesFrom [ a owl:Class ; owl:intersectionOf ( bfo:BFO_0000004 [ a owl:Class ; owl:complementOf bfo:BFO_0000006 ] ) ] ] ) ] ] ,
        # owner
        [ a owl:Restriction ;
          owl:onProperty iof:isSlotOf ;
          owl:allValuesFrom [ a owl:Class ;
                owl:intersectionOf ( iof:InformationContentEntity
                    [ a owl:Restriction ;
                      owl:onProperty iof:isAbout ;
                      owl:allValuesFrom [ a owl:Class ; owl:intersectionOf ( bfo:BFO_0000004 [ a owl:Class ; owl:complementOf bfo:BFO_0000006 ] ) ] ] ) ] ] ;
    rdfs:label "proper part slot"@en-US ;
    iof-av:naturalLanguageDefinition "information slot whose filler and owner are information content entities about only independent continuants that are not spatial regions; when filled, it prescribes or reports that the entity the owner is about has a proper continuant part at all times (BFO_0000111) that the filler is about"@en-US ;
    iof-av:explanatoryNote "Used for fiat object parts such as a shank or a thread, which are not material components and so do not fit 'component parthood slot'. Corresponds to 'fiat part slot' in slot/Hex_Bolt_Information_Slots.rdf, widened so that the owner can be about a fiat object part (a shank specification owns the thread slot) and not only about an object, since BFO object and fiat object part are disjoint."@en-US .

fst:MemberPartSlot
    a owl:Class ;
    rdfs:subClassOf iof:InformationSlot ,
        # filler
        [ a owl:Restriction ;
          owl:onProperty iof:hasFiller ;
          owl:allValuesFrom [ a owl:Class ;
                owl:intersectionOf ( iof:InformationContentEntity
                    [ a owl:Restriction ;
                      owl:onProperty iof:isAbout ;
                      owl:allValuesFrom [ a owl:Class ; owl:intersectionOf ( bfo:BFO_0000004 [ a owl:Class ; owl:complementOf bfo:BFO_0000006 ] ) ] ] ) ] ] ,
        # owner: about only object aggregates
        [ a owl:Restriction ;
          owl:onProperty iof:isSlotOf ;
          owl:allValuesFrom [ a owl:Class ;
                owl:intersectionOf ( iof:InformationContentEntity
                    [ a owl:Restriction ;
                      owl:onProperty iof:isAbout ;
                      owl:allValuesFrom bfo:BFO_0000027 ] ) ] ] ;
    rdfs:label "member part slot"@en-US ;
    iof-av:naturalLanguageDefinition "information slot whose filler is an information content entity about only independent continuants that are not spatial regions, and whose owner is an information content entity about only object aggregates; when filled, it prescribes or reports that the object aggregate the owner is about has a member part at some time (BFO_0000115) that the filler is about"@en-US ;
    iof-av:explanatoryNote "One slot per member. Several slots can be filled by the same specification, so a set of ten identical bolts has ten member part slots filled by one bolt specification. This states the count without a qualified cardinality restriction."@en-US .

fst:MaterialSlot
    a owl:Class ;
    rdfs:subClassOf iof:InformationSlot ,
        # filler
        [ a owl:Restriction ;
          owl:onProperty iof:hasFiller ;
          owl:allValuesFrom [ a owl:Class ;
                owl:intersectionOf ( iof:InformationContentEntity
                    [ a owl:Restriction ;
                      owl:onProperty iof:isAbout ;
                      owl:allValuesFrom bfo:BFO_0000040 ] ) ] ] ,
        # owner
        [ a owl:Restriction ;
          owl:onProperty iof:isSlotOf ;
          owl:allValuesFrom [ a owl:Class ;
                owl:intersectionOf ( iof:InformationContentEntity
                    [ a owl:Restriction ;
                      owl:onProperty iof:isAbout ;
                      owl:allValuesFrom [ a owl:Class ; owl:intersectionOf ( bfo:BFO_0000004 [ a owl:Class ; owl:complementOf bfo:BFO_0000006 ] ) ] ] ) ] ] ;
    rdfs:label "material slot"@en-US ;
    iof-av:naturalLanguageDefinition "information slot whose filler is an information content entity about only material entities, and whose owner is an information content entity about only independent continuants that are not spatial regions; when filled, it prescribes or reports that the entity the owner is about is made of at all times ('is made of at all times') the material the filler is about"@en-US ;
    iof-av:explanatoryNote "Fills the material type of a part or fastener with a material specification, such as an alloy steel specification. A coating is a part, not the material something is made of, so it goes in a proper part slot."@en-US .

fst:AggregatePartSlot
    a owl:Class ;
    rdfs:subClassOf iof:InformationSlot ,
        # filler: about only object aggregates
        [ a owl:Restriction ;
          owl:onProperty iof:hasFiller ;
          owl:allValuesFrom [ a owl:Class ;
                owl:intersectionOf ( iof:InformationContentEntity
                    [ a owl:Restriction ;
                      owl:onProperty iof:isAbout ;
                      owl:allValuesFrom bfo:BFO_0000027 ] ) ] ] ,
        # owner: about only object aggregates
        [ a owl:Restriction ;
          owl:onProperty iof:isSlotOf ;
          owl:allValuesFrom [ a owl:Class ;
                owl:intersectionOf ( iof:InformationContentEntity
                    [ a owl:Restriction ;
                      owl:onProperty iof:isAbout ;
                      owl:allValuesFrom bfo:BFO_0000027 ] ) ] ] ;
    rdfs:label "aggregate part slot"@en-US ;
    iof-av:naturalLanguageDefinition "information slot whose filler and owner are information content entities about only object aggregates; when filled, it prescribes or reports that the object aggregate the owner is about has, as a continuant part at some time (BFO_0000178), an object aggregate that the filler is about"@en-US ;
    iof-av:explanatoryNote "Used to group identical members: a bolt set specification's aggregate part slot is filled by a fastener quantity specification for its ten bolts, instead of having ten member part slots."@en-US .

fst:FastenedJointSlot
    a owl:Class ;
    rdfs:subClassOf iof:InformationSlot ,
        # filler
        [ a owl:Restriction ;
          owl:onProperty iof:hasFiller ;
          owl:allValuesFrom iof:FastenedJointSpecification ] ,
        # owner
        [ a owl:Restriction ;
          owl:onProperty iof:isSlotOf ;
          owl:allValuesFrom [ a owl:Class ;
                owl:intersectionOf ( iof:InformationContentEntity
                    [ a owl:Restriction ;
                      owl:onProperty iof:isAbout ;
                      owl:allValuesFrom [ a owl:Class ; owl:intersectionOf ( bfo:BFO_0000004 [ a owl:Class ; owl:complementOf bfo:BFO_0000006 ] ) ] ] ) ] ] ;
    rdfs:label "fastened joint slot"@en-US ;
    iof-av:naturalLanguageDefinition "information slot whose filler is a fastened joint specification, and whose owner is an information content entity about only independent continuants that are not spatial regions; when filled, it prescribes a joint in the assembly the owner is about, made with the fasteners that the joint specification's fastener slots prescribe"@en-US .

# ===========================================================================
# Design specifications
#
# One class per kind of prescribed entity, each with a single 'prescribes
# only' restriction, so a reasoner can type a fastener, part or quality from
# the specification it is prescribed by.
# ===========================================================================

fst:ButtonHeadSocketCapBoltSpecification
    a owl:Class ;
    rdfs:subClassOf iof:DesignSpecification ,
        [ a owl:Restriction ;
          owl:onProperty iof:prescribes ;
          owl:allValuesFrom fst:ButtonHeadSocketCapBolt ] ;
    rdfs:label "button head socket cap bolt specification"@en-US ;
    iof-av:naturalLanguageDefinition "design specification that prescribes only button head hex socket cap bolts"@en-US .

fst:FlatHeadSocketCapBoltSpecification
    a owl:Class ;
    rdfs:subClassOf iof:DesignSpecification ,
        [ a owl:Restriction ;
          owl:onProperty iof:prescribes ;
          owl:allValuesFrom fst:FlatHeadSocketCapBolt ] ;
    rdfs:label "flat head socket cap bolt specification"@en-US ;
    iof-av:naturalLanguageDefinition "design specification that prescribes only flat head socket cap bolts"@en-US .

fst:FastenerHeadSpecification
    a owl:Class ;
    rdfs:subClassOf iof:DesignSpecification ,
        [ a owl:Restriction ;
          owl:onProperty iof:prescribes ;
          owl:allValuesFrom fst:FastenerHead ] ;
    rdfs:label "fastener head specification"@en-US ;
    iof-av:naturalLanguageDefinition "design specification that prescribes only fastener heads"@en-US .

fst:ShankSpecification
    a owl:Class ;
    rdfs:subClassOf iof:DesignSpecification ,
        [ a owl:Restriction ;
          owl:onProperty iof:prescribes ;
          owl:allValuesFrom fst:Shank ] ;
    rdfs:label "shank specification"@en-US ;
    iof-av:naturalLanguageDefinition "design specification that prescribes only shanks"@en-US .

fst:ExternalThreadSpecification
    a owl:Class ;
    rdfs:subClassOf iof:DesignSpecification ,
        [ a owl:Restriction ;
          owl:onProperty iof:prescribes ;
          owl:allValuesFrom fst:ExternalThread ] ;
    rdfs:label "external thread specification"@en-US ;
    iof-av:naturalLanguageDefinition "design specification that prescribes only external threads"@en-US .

fst:HexKeySpecification
    a owl:Class ;
    rdfs:subClassOf iof:DesignSpecification ,
        [ a owl:Restriction ;
          owl:onProperty iof:prescribes ;
          owl:allValuesFrom fst:HexKey ] ;
    rdfs:label "hex key specification"@en-US ;
    iof-av:naturalLanguageDefinition "design specification that prescribes only hex keys"@en-US .

fst:MaterialSpecification
    a owl:Class ;
    rdfs:subClassOf iof:DesignSpecification ,
        [ a owl:Restriction ;
          owl:onProperty iof:prescribes ;
          owl:allValuesFrom bfo:BFO_0000040 ] ;      # material entity
    rdfs:label "material specification"@en-US ;
    iof-av:naturalLanguageDefinition "design specification that prescribes only material entities, used to fill a material slot or a coating slot"@en-US .

fst:AlloySteelSpecification
    a owl:Class ;
    rdfs:subClassOf fst:MaterialSpecification ,
        [ a owl:Restriction ;
          owl:onProperty iof:prescribes ;
          owl:allValuesFrom fst:PortionOfAlloySteel ] ;
    rdfs:label "alloy steel specification"@en-US ;
    iof-av:naturalLanguageDefinition "material specification that prescribes only portions of alloy steel"@en-US .

fst:BlackOxideCoatingSpecification
    a owl:Class ;
    rdfs:subClassOf fst:MaterialSpecification ,
        [ a owl:Restriction ;
          owl:onProperty iof:prescribes ;
          owl:allValuesFrom fst:BlackOxideCoating ] ;
    rdfs:label "black oxide coating specification"@en-US ;
    iof-av:naturalLanguageDefinition "material specification that prescribes only black oxide coatings"@en-US .

fst:FastenerQuantitySpecification
    a owl:Class ;
    rdfs:subClassOf iof:DesignSpecification ,
        [ a owl:Restriction ;
          owl:onProperty iof:prescribes ;
          owl:allValuesFrom bfo:BFO_0000027 ] ,      # object aggregate
        [ a owl:Restriction ;
          owl:onProperty iof:hasSlot ;
          owl:allValuesFrom [ a owl:Class ; owl:unionOf ( fst:MemberPartSlot iof:CountSlot ) ] ] ;
    rdfs:label "fastener quantity specification"@en-US ;
    iof-av:naturalLanguageDefinition "design specification that prescribes only object aggregates of identical members; its member part slot is filled by the specification every member conforms to, and its count slot by the number of members"@en-US ;
    iof-av:explanatoryNote "Follows the IOF InformationSlot module's aggregation description, which has a count slot filled by a count expression. The count is a value, not a cardinality restriction, so a reasoner neither builds the members nor checks their number; SetCount.rq checks it."@en-US ;
    skos:example "ten M6 x 25 mm bolts of one bolt specification"@en-US .

fst:FastenerSetSpecification
    a owl:Class ;
    rdfs:subClassOf iof:DesignSpecification ,
        [ a owl:Restriction ;
          owl:onProperty iof:prescribes ;
          owl:allValuesFrom bfo:BFO_0000027 ] ,      # object aggregate
        [ a owl:Restriction ;
          owl:onProperty iof:hasSlot ;
          owl:allValuesFrom [ a owl:Class ; owl:unionOf ( fst:MemberPartSlot fst:AggregatePartSlot ) ] ] ;
    rdfs:label "fastener set specification"@en-US ;
    iof-av:naturalLanguageDefinition "design specification that prescribes only object aggregates; its member part slots are filled by the specifications of single fasteners and tools sold in the set, and its aggregate part slots by fastener quantity specifications for groups of identical members"@en-US .

fst:QualitySpecification
    a owl:Class ;
    rdfs:subClassOf iof:DesignSpecification ,
        [ a owl:Restriction ;
          owl:onProperty iof:prescribes ;
          owl:allValuesFrom bfo:BFO_0000019 ] ;      # quality
    rdfs:label "quality specification"@en-US ;
    iof-av:naturalLanguageDefinition "design specification that prescribes only qualities, and whose value slot is filled by the value expression the quality is prescribed to have"@en-US .

fst:ShankLengthSpecification
    a owl:Class ;
    rdfs:subClassOf fst:QualitySpecification ,
        [ a owl:Restriction ;
          owl:onProperty iof:prescribes ;
          owl:allValuesFrom fst:ShankLength ] ;
    rdfs:label "shank length specification"@en-US ;
    iof-av:naturalLanguageDefinition "quality specification that prescribes only shank lengths"@en-US .

fst:HeadHeightSpecification
    a owl:Class ;
    rdfs:subClassOf fst:QualitySpecification ,
        [ a owl:Restriction ;
          owl:onProperty iof:prescribes ;
          owl:allValuesFrom fst:HeadHeight ] ;
    rdfs:label "head height specification"@en-US ;
    iof-av:naturalLanguageDefinition "quality specification that prescribes only head heights"@en-US .

fst:HeadDiameterSpecification
    a owl:Class ;
    rdfs:subClassOf fst:QualitySpecification ,
        [ a owl:Restriction ;
          owl:onProperty iof:prescribes ;
          owl:allValuesFrom fst:HeadDiameter ] ;
    rdfs:label "head diameter specification"@en-US ;
    iof-av:naturalLanguageDefinition "quality specification that prescribes only head diameters"@en-US .

fst:ThreadMajorDiameterSpecification
    a owl:Class ;
    rdfs:subClassOf fst:QualitySpecification ,
        [ a owl:Restriction ;
          owl:onProperty iof:prescribes ;
          owl:allValuesFrom fst:ThreadMajorDiameter ] ;
    rdfs:label "thread major diameter specification"@en-US ;
    iof-av:naturalLanguageDefinition "quality specification that prescribes only thread major diameters"@en-US .

fst:ThreadPitchSpecification
    a owl:Class ;
    rdfs:subClassOf fst:QualitySpecification ,
        [ a owl:Restriction ;
          owl:onProperty iof:prescribes ;
          owl:allValuesFrom fst:ThreadPitch ] ;
    rdfs:label "thread pitch specification"@en-US ;
    iof-av:naturalLanguageDefinition "quality specification that prescribes only thread pitches"@en-US .

fst:HexKeySizeSpecification
    a owl:Class ;
    rdfs:subClassOf fst:QualitySpecification ,
        [ a owl:Restriction ;
          owl:onProperty iof:prescribes ;
          owl:allValuesFrom fst:HexKeySize ] ;
    rdfs:label "hex key size specification"@en-US ;
    iof-av:naturalLanguageDefinition "quality specification that prescribes only hex key sizes"@en-US .

# ===========================================================================
# Assembly and disassembly processes
# ===========================================================================

fst:FasteningProcess
    a owl:Class ;
    rdfs:subClassOf iof:AssemblyProcess ,
        [ a owl:Restriction ;
          owl:onProperty iof:hasInput ;
          owl:someValuesFrom fst:Fastener ] ,
        [ a owl:Restriction ;
          owl:onProperty bfo:BFO_0000055 ;
          owl:someValuesFrom fst:FasteningFunction ] ;
    rdfs:label "fastening process"@en-US ;
    iof-av:naturalLanguageDefinition "assembly process in which material components are joined by installing one or more fasteners"@en-US ;
    iof-av:explanatoryNote "The fasteners are themselves inputs that become material components of the resulting assembly. The fastening process realizes ('realizes', BFO_0000055) the fastening function of each fastener it installs."@en-US ;
    skos:example "bolting a crib rail to a crib post; riveting two aircraft skin panels"@en-US .

fst:ThreadedFasteningProcess
    a owl:Class ;
    rdfs:subClassOf fst:FasteningProcess ,
        [ a owl:Restriction ;
          owl:onProperty iof:hasInput ;
          owl:someValuesFrom fst:ThreadedFastener ] ;
    rdfs:label "threaded fastening process"@en-US ;
    iof-av:naturalLanguageDefinition "fastening process in which a threaded fastener is turned to engage a mating thread and tightened to clamp the material components together"@en-US ;
    iof-av:synonym "bolting"@en-US , "screwing"@en-US ;
    skos:example "tightening an M6 button head socket cap bolt into a threaded insert with a 4 mm hex key"@en-US .

fst:DisassemblyProcess
    a owl:Class ;
    rdfs:subClassOf iof:PlannedProcess ,
        [ a owl:Restriction ;
          owl:onProperty iof:hasInput ;
          owl:someValuesFrom iof:Assembly ] ,
        [ a owl:Restriction ;
          owl:onProperty iof:hasOutput ;
          owl:someValuesFrom bfo:BFO_0000040 ] ;
    rdfs:label "disassembly process"@en-US ;
    iof-av:naturalLanguageDefinition "planned process in which an assembly is separated into some or all of its material components"@en-US ;
    iof-av:explanatoryNote "Modeled as a planned process rather than a manufacturing process because disassembly is often done for maintenance, repair, transport, or end-of-life recovery rather than to transform material into a product. A disassembly carried out as a manufacturing tear-down can additionally be classified as an 'iof:ManufacturingProcess'."@en-US ;
    skos:example "taking apart a crib for storage; removing a gearbox from a machine for repair"@en-US .

fst:UnfasteningProcess
    a owl:Class ;
    rdfs:subClassOf fst:DisassemblyProcess ,
        [ a owl:Restriction ;
          owl:onProperty iof:hasOutput ;
          owl:someValuesFrom fst:Fastener ] ;
    rdfs:label "unfastening process"@en-US ;
    iof-av:naturalLanguageDefinition "disassembly process in which one or more fasteners are removed so that the material components they joined are separated"@en-US ;
    skos:example "unbolting a crib rail from a crib post; drilling out a rivet"@en-US .

fst:ThreadedUnfasteningProcess
    a owl:Class ;
    rdfs:subClassOf fst:UnfasteningProcess ,
        [ a owl:Restriction ;
          owl:onProperty iof:hasOutput ;
          owl:someValuesFrom fst:ThreadedFastener ] ;
    rdfs:label "threaded unfastening process"@en-US ;
    iof-av:naturalLanguageDefinition "unfastening process in which a threaded fastener is loosened and turned out of its mating thread"@en-US ;
    iof-av:synonym "unbolting"@en-US , "unscrewing"@en-US .

[ a owl:AllDisjointClasses ;
  owl:members ( fst:FasteningProcess fst:DisassemblyProcess ) ] .
