<https://example.org/d/> a owl:Ontology .
:Top a owl:Class . :B a owl:Class ; rdfs:subClassOf :Top . :C a owl:Class . :p a owl:ObjectProperty .
:A a owl:Class ; owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :B [ a owl:Restriction ; owl:onProperty :p ; owl:someValuesFrom :C ] ) ] .
:x a owl:NamedIndividual , :B ; :p :y .
:y a owl:NamedIndividual , :C .
