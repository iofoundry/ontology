<!DOCTYPE rdf:RDF [
	<!ENTITY dc "http://purl.org/dc/elements/1.1/">
	<!ENTITY dcterms "http://purl.org/dc/terms/">
	<!ENTITY iof-av "https://spec.industrialontologies.org/ontology/annotation/">
	<!ENTITY iof-constr "https://spec.industrialontologies.org/ontology/construct/">
	<!ENTITY iof-ind "https://spec.industrialontologies.org/ontology/individual/">
	<!ENTITY owl "http://www.w3.org/2002/07/owl#">
	<!ENTITY rdf "http://www.w3.org/1999/02/22-rdf-syntax-ns#">
	<!ENTITY rdfs "http://www.w3.org/2000/01/rdf-schema#">
	<!ENTITY skos "http://www.w3.org/2004/02/skos/core#">
	<!ENTITY xsd "http://www.w3.org/2001/XMLSchema#">
]>
<rdf:RDF xml:base="https://spec.industrialontologies.org/ontology/core/informationslot/InformationSlot/"
	xmlns:dc="http://purl.org/dc/elements/1.1/"
	xmlns:dcterms="http://purl.org/dc/terms/"
	xmlns:iof-av="https://spec.industrialontologies.org/ontology/annotation/"
	xmlns:iof-constr="https://spec.industrialontologies.org/ontology/construct/"
	xmlns:iof-ind="https://spec.industrialontologies.org/ontology/individual/"
	xmlns:owl="http://www.w3.org/2002/07/owl#"
	xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
	xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
	xmlns:skos="http://www.w3.org/2004/02/skos/core#"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
	
	<owl:Ontology rdf:about="https://spec.industrialontologies.org/ontology/core/informationslot/InformationSlot/">
		<rdfs:label xml:lang="en-US">information slot ontology</rdfs:label>
		<dc:license>http://opensource.org/licenses/MIT</dc:license>
		<dcterms:abstract xml:lang="en-US">This ontology defines constructs related to representing the structure and semantic of information content entities.</dcterms:abstract>
		<dcterms:creator>Arkopaul Sarkar, Natioanl Institute of Standards and Technology</dcterms:creator>
		<dcterms:publisher>Industrial Ontology Foundry</dcterms:publisher>
		<dcterms:title xml:lang="en-US">Information Slot Ontology</dcterms:title>
		<owl:imports rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/"/>
		<owl:versionIRI rdf:resource="https://spec.industrialontologies.org/ontology/202604/core/informationslot/InformationSlot/"/>
		<iof-av:copyright>Copyright (c) 2022, 2023 Open Applications Group</iof-av:copyright>
		<iof-av:copyright>Copyright (c) 2022, 2023, 2024, 2025, 2026 Open Applications Group</iof-av:copyright>
		<iof-av:maturity rdf:resource="&iof-ind;Provisional"/>
	</owl:Ontology>
	
	<owl:Class rdf:about="&iof-constr;AggregationDescription">
		<rdfs:subClassOf rdf:resource="&iof-constr;InformationContentEntity"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&iof-constr;describes"/>
				<owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000027"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/core/informationslot/InformationSlot/</rdfs:isDefinedBy>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&iof-constr;DescriptiveInformationContentEntity">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&iof-constr;hasSlot"/>
						<owl:someValuesFrom rdf:resource="&iof-constr;CountSlot"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-constr;AssemblySpecification">
		<rdfs:subClassOf rdf:resource="&iof-constr;DesignSpecification"/>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/core/informationslot/InformationSlot/</rdfs:isDefinedBy>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-constr;ComponentParthoodSlot">
		<rdfs:subClassOf rdf:resource="&iof-constr;InformationSlot"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&iof-constr;hasFiller"/>
				<owl:allValuesFrom>
					<owl:Class>
						<owl:intersectionOf rdf:parseType="Collection">
							<rdf:Description rdf:about="&iof-constr;InformationContentEntity">
							</rdf:Description>
							<owl:Restriction>
								<owl:onProperty rdf:resource="&iof-constr;isAbout"/>
								<owl:allValuesFrom rdf:resource="&iof-constr;MaterialComponent"/>
							</owl:Restriction>
						</owl:intersectionOf>
					</owl:Class>
				</owl:allValuesFrom>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&iof-constr;isSlotOf"/>
				<owl:someValuesFrom>
					<owl:Class>
						<owl:intersectionOf rdf:parseType="Collection">
							<rdf:Description rdf:about="&iof-constr;InformationContentEntity">
							</rdf:Description>
							<owl:Restriction>
								<owl:onProperty rdf:resource="&iof-constr;isAbout"/>
								<owl:allValuesFrom>
									<owl:Class>
										<owl:intersectionOf rdf:parseType="Collection">
											<rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000004">
											</rdf:Description>
											<owl:Class>
												<owl:complementOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000006"/>
											</owl:Class>
										</owl:intersectionOf>
									</owl:Class>
								</owl:allValuesFrom>
							</owl:Restriction>
						</owl:intersectionOf>
					</owl:Class>
				</owl:someValuesFrom>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label xml:lang="en-US">component parthood slot</rdfs:label>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/core/informationslot/InformationSlot/</rdfs:isDefinedBy>
		<skos:example xml:lang="en-US">A system specification has a &apos;component parthood slot&apos; filled by a component specification, thereby prescribing that the specified system must &apos;has component part&apos; the specified component for conformance to the specification; an inspection report has a &apos;component parthood slot&apos; filled by a component description, thereby reporting that the inspected system &apos;has component part&apos; the described component</skos:example>
		<iof-av:explanatoryNote xml:lang="en-US">1) If slot of a prescriptive host, the slot specifies that conformance requires having the filled material component as a component part. If slot of a reporting host, the slot records that the host’s referent has the filled material component as a component part.
2) The LA2 axiom cant be formalized on the component parthood slot in OWL and it should be utilized instead on the ICEs that the slot &apos;is the slot of&apos;</iof-av:explanatoryNote>
		<iof-av:firstOrderLogicAxiom>LA1:ComponentParthoodSlot(x) → ( (∀y(hasFiller(x,y) → (InformationContentEntity(y) ∧ (∃m(MaterialComponent(m) ∧ isAbout(y,m)) ∨ ∀t(isAbout(y,t) → MaterialComponent(t)) )))) ∧ (∃z(isSlotOf(x,z) ∧ InformationContentEntity(z) ∧ (∃c(IndependentContinuant(c) ∧ ¬SpatialRegion(c) ∧ isAbout(z,c)) ∨ ∀u(isAbout(z,u) → (IndependentContinuant(u) ∧ ¬SpatialRegion(u)))))) ) )</iof-av:firstOrderLogicAxiom>
		<iof-av:firstOrderLogicAxiom>LA2: ComponentParthoodSlot(x) → ∀z, y, c, m ( (slotOf(x,z) ∧ hasFiller(x,y) ∧ isAbout(z,c) ∧ isAbout(y,m)) → (hasComponentPartAtSomeTime(c,m) ∨ (prescribes(z,c) ∧ (conformsTo(c,z) → hasComponentPartAtSomeTime(c,m)))) )</iof-av:firstOrderLogicAxiom>
		<iof-av:naturalLanguageDefinition xml:lang="en-US">information slot that is slot of an information content entity that is about an independent continuant, that can be filled only by an information content entity that is about a material component, and that, when filled, prescribes or reports a &apos;has component part&apos; relation between the entities the host and filler information content entities are about</iof-av:naturalLanguageDefinition>
		<iof-av:semiFormalNaturalLanguageAxiom xml:lang="en-US">LA1: if x is a &apos;component parthood slot&apos; then (i) every &apos;has filler&apos; y of x is an &apos;information content entity&apos; that either &apos;is about&apos; some &apos;material component&apos; or &apos;is about&apos; only &apos;material component&apos;, and (ii) x &apos;is slot of&apos; some &apos;information content entity&apos; that either &apos;is about&apos; some &apos;independent continuant&apos; that is not a &apos;spatial region&apos; or &apos;is about&apos; only &apos;independent continuant&apos; that is not &apos;spatial region&apos;</iof-av:semiFormalNaturalLanguageAxiom>
		<iof-av:semiFormalNaturalLanguageAxiom xml:lang="en-US">LA2: if x is a &apos;component parthood slot&apos; then for any z, y, c, and m, if x is &apos;slot of&apos; z and x &apos;has filler&apos; y, and z &apos;is about&apos; c and y &apos;is about&apos; m, then either c &apos;has component part at some time&apos; m, or z &apos;prescribes&apos; c and if c &apos;conforms to&apos; z then c &apos;has component part at some time &apos; m</iof-av:semiFormalNaturalLanguageAxiom>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-constr;ConnectionSlot">
		<rdfs:subClassOf rdf:resource="&iof-constr;InformationSlot"/>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/core/informationslot/InformationSlot/</rdfs:isDefinedBy>
		<iof-av:firstOrderLogicDefinition>ConnectionSlot(s) ↔ InformationSlot(s) ∧ ∃a&apos;, b&apos; (slotOf(s, a&apos;) ∧ fills(b&apos;, s) ∧ ∀a, b (describes(a&apos;,a) ∧ describes(b&apos;,b) → conencts(a, b)))</iof-av:firstOrderLogicDefinition>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-constr;ConnectorSlot">
		<rdfs:subClassOf rdf:resource="&iof-constr;InformationSlot"/>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/core/informationslot/InformationSlot/</rdfs:isDefinedBy>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&iof-constr;InformationSlot">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&iof-constr;hasFiller"/>
						<owl:someValuesFrom>
							<owl:Restriction>
								<owl:onProperty rdf:resource="&iof-constr;describes"/>
								<owl:someValuesFrom rdf:resource="&iof-constr;JoiningMaterial"/>
							</owl:Restriction>
						</owl:someValuesFrom>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<iof-av:firstOrderLogicDefinition>ConnectionSlot(s) ↔ InformationSlot(s) ∧ ∃a&apos;, b&apos; (slotOf(s, a&apos;) ∧ fills(b&apos;, s) ∧ ∀a, b (describes(a&apos;,a) ∧ describes(b&apos;,b) → hasConnector(a, b)))</iof-av:firstOrderLogicDefinition>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-constr;CountExpression">
		<rdfs:subClassOf rdf:resource="&iof-constr;ValueExpression"/>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/core/informationslot/InformationSlot/</rdfs:isDefinedBy>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-constr;CountSlot">
		<rdfs:subClassOf rdf:resource="&iof-constr;InformationSlot"/>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/core/informationslot/InformationSlot/</rdfs:isDefinedBy>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&iof-constr;InformationSlot">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&iof-constr;hasFiller"/>
						<owl:allValuesFrom rdf:resource="&iof-constr;CountExpression"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-constr;FastenedJointSpecification">
		<rdfs:subClassOf rdf:resource="&iof-constr;DesignSpecification"/>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/core/informationslot/InformationSlot/</rdfs:isDefinedBy>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&iof-constr;DesignSpecification">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&iof-constr;hasSlot"/>
						<owl:someValuesFrom rdf:resource="&iof-constr;FastenerSlot"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-constr;FastenerSlot">
		<rdfs:subClassOf rdf:resource="&iof-constr;InformationSlot"/>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/core/informationslot/InformationSlot/</rdfs:isDefinedBy>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-constr;InformationSlot">
	</owl:Class>
	
	<owl:Class rdf:about="&iof-constr;JoiningMaterial">
		<rdfs:subClassOf rdf:resource="&iof-constr;MaterialArtifact"/>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/core/informationslot/InformationSlot/</rdfs:isDefinedBy>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-constr;Joint">
		<rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000024"/>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/core/informationslot/InformationSlot/</rdfs:isDefinedBy>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-constr;JointSpecification">
		<rdfs:subClassOf rdf:resource="&iof-constr;DesignSpecification"/>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/core/informationslot/InformationSlot/</rdfs:isDefinedBy>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&iof-constr;DesignSpecification">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&iof-constr;hasSlot"/>
						<owl:someValuesFrom rdf:resource="&iof-constr;ConnectorSlot"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-constr;LocationSlot">
		<rdfs:subClassOf rdf:resource="&iof-constr;InformationSlot"/>
		<rdfs:label xml:lang="en-US">location slot</rdfs:label>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/core/informationslot/InformationSlot/</rdfs:isDefinedBy>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&iof-constr;InformationSlot">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&iof-constr;hasFiller"/>
						<owl:allValuesFrom rdf:resource="&iof-constr;PhysicalLocationIdentifier"/>
					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&iof-constr;isSlotOf"/>
						<owl:allValuesFrom>
							<owl:Restriction>
								<owl:onProperty rdf:resource="&iof-constr;describes"/>
								<owl:someValuesFrom>
									<owl:Class>
										<owl:intersectionOf rdf:parseType="Collection">
											<rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000004">
											</rdf:Description>
											<owl:Class>
												<owl:complementOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000006"/>
											</owl:Class>
										</owl:intersectionOf>
									</owl:Class>
								</owl:someValuesFrom>
							</owl:Restriction>
						</owl:allValuesFrom>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<iof-av:firstOrderLogicAxiom>InformationSlot(s) ∧ ∃a&apos;, b&apos; (slotOf(s, a&apos;) ∧ fills(b&apos;, s) ∧ ∀a, b (describes(a&apos;,a) ∧ describes(b&apos;,b) → locatedInAtSomeTimes(a, b))) → LocationSlot(s)</iof-av:firstOrderLogicAxiom>
		<iof-av:firstOrderLogicDefinition>LocationSlot(s) ↔ InformationSlot(s) ∧ ∃a&apos;, b&apos; (slotOf(s, a&apos;) ∧ fills(b&apos;, s) ∧ ∀a, b (describes(a&apos;,a) ∧ describes(b&apos;,b) → locatedInAtSomeTimes(a, b)))</iof-av:firstOrderLogicDefinition>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-constr;ParticipantSlot">
		<rdfs:subClassOf rdf:resource="&iof-constr;InformationSlot"/>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/core/informationslot/InformationSlot/</rdfs:isDefinedBy>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&iof-constr;InformationSlot">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&iof-constr;hasFiller"/>
						<owl:allValuesFrom>
							<owl:Restriction>
								<owl:onProperty rdf:resource="&iof-constr;describes"/>
								<owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
							</owl:Restriction>
						</owl:allValuesFrom>
					</owl:Restriction>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&iof-constr;isSlotOf"/>
						<owl:allValuesFrom>
							<owl:Restriction>
								<owl:onProperty rdf:resource="&iof-constr;describes"/>
								<owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
							</owl:Restriction>
						</owl:allValuesFrom>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-constr;TimeSlot">
		<rdfs:subClassOf rdf:resource="&iof-constr;InformationSlot"/>
		<rdfs:comment xml:lang="en-US">time slot</rdfs:comment>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/core/informationslot/InformationSlot/</rdfs:isDefinedBy>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&iof-constr;InformationSlot">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&iof-constr;hasFiller"/>
						<owl:allValuesFrom>
							<owl:Class>
								<owl:unionOf rdf:parseType="Collection">
									<rdf:Description rdf:about="&iof-constr;TemporalDurationValueExpression">
									</rdf:Description>
									<rdf:Description rdf:about="&iof-constr;TemporalInstantValueExpression">
									</rdf:Description>
								</owl:unionOf>
							</owl:Class>
						</owl:allValuesFrom>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-constr;ValueSlot">
		<rdfs:subClassOf rdf:resource="&iof-constr;InformationSlot"/>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/core/informationslot/InformationSlot/</rdfs:isDefinedBy>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&iof-constr;InformationSlot">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&iof-constr;hasFiller"/>
						<owl:allValuesFrom rdf:resource="&iof-constr;ValueExpression"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
	</owl:Class>
	
	<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/core/Core/IngredientSlot">
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/core/informationslot/InformationSlot/</rdfs:isDefinedBy>
		<iof-av:firstOrderLogicAxiom>InformationSlot(s) ∧ ∃a&apos;, b&apos; (slotOf(s, a&apos;) ∧ fills(b&apos;, s) ∧ ∀a, b (prescribes(a&apos;,a) ∧ prescribes(b&apos;,b) → isMadeOfAtAllTimes(b, a))) → IngredientSlot(s)</iof-av:firstOrderLogicAxiom>
		<iof-av:firstOrderLogicDefinition>IngredientSlot(s) ↔ InformationSlot(s) ∧ ∃a&apos;, b&apos; (slotOf(s, a&apos;) ∧ fills(b&apos;, s) ∧ ∀a, b (describes(a&apos;,a) ∧ describes(b&apos;,b) → isMadeOfAtAllTime(b,a)))</iof-av:firstOrderLogicDefinition>
	</rdf:Description>
	
	<rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/core/Core/RoleSlot">
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/core/informationslot/InformationSlot/</rdfs:isDefinedBy>
		<iof-av:firstOrderLogicAxiom>InformationSlot(s) ∧ ∃a&apos;, b&apos; (slotOf(s, a&apos;) ∧ fills(b&apos;, s) ∧ ∀a, b (describes(a&apos;,a) ∧ describes(b&apos;,b) → hasRole(a, b))) → RoleSlot(s)</iof-av:firstOrderLogicAxiom>
		<iof-av:firstOrderLogicDefinition>RoleSlot(s) ↔ InformationSlot(s) ∧ ∃a&apos;, b&apos; (slotOf(s, a&apos;) ∧ fills(b&apos;, s) ∧ ∀a, b (describes(a&apos;,a) ∧ describes(b&apos;,b) → hasRole(a, b)))</iof-av:firstOrderLogicDefinition>
	</rdf:Description>
	
	<owl:Class>
		<rdfs:subClassOf rdf:resource="&iof-constr;JointSpecification"/>
		<owl:intersectionOf rdf:parseType="Collection">
			<rdf:Description rdf:about="&iof-constr;DesignSpecification">
			</rdf:Description>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&iof-constr;hasSlot"/>
				<owl:someValuesFrom>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&iof-constr;hasFiller"/>
						<owl:someValuesFrom>
							<owl:Restriction>
								<owl:onProperty rdf:resource="&iof-constr;prescribes"/>
