<?xml version="1.0"?>
<rdf:RDF xmlns="https://spec.industrialontologies.org/ontology/productservicesystem/ProductServiceSystem/Sensor#"
     xml:base="https://spec.industrialontologies.org/ontology/productservicesystem/ProductServiceSystem/Sensor"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:bfo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:iof-av="https://spec.industrialontologies.org/ontology/annotation/"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:iof-ind="https://spec.industrialontologies.org/ontology/individual/"
     xmlns:iof-const="https://spec.industrialontologies.org/ontology/construct/"
     xmlns:CommonCoreOntologies="http://www.ontologyrepository.com/CommonCoreOntologies/">
    <owl:Ontology rdf:about="https://spec.industrialontologies.org/ontology/productservicesystem/ProductServiceSystem/Sensor">
        <owl:versionIRI rdf:resource="https://spec.industrialontologies.org/ontology/202502/productservicesystem/ProductServiceSystem/Sensor"/>
        <owl:imports rdf:resource="https://spec.industrialontologies.org/ontology/202602/core/Core/"/>
        <owl:imports rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/"/>
        <dcterms:abstract>This module contains terms and relations necessary for representing basic sensor entities.</dcterms:abstract>
        <dcterms:contributor>Ana Teresa Correia, Institut fuer angewandte Systemtechnik Bremen GmbH (ATB-Bremen)</dcterms:contributor>
        <dcterms:contributor>Dragan Stokic, Institut fuer angewandte Systemtechnik Bremen GmbH (ATB-Bremen)</dcterms:contributor>
        <dcterms:contributor>Dusan Sormaz, Ohio University</dcterms:contributor>
        <dcterms:contributor>Gabriela Henning, CONICET</dcterms:contributor>
        <dcterms:contributor>Marcela Vegetti, University of Santa Fe</dcterms:contributor>
        <dcterms:contributor>Mark Schubert, Parson Europe</dcterms:contributor>
        <dcterms:contributor>Roberto Sala, University of Bergamo</dcterms:contributor>
        <dcterms:contributor>Todd Schneider, Engineering Semantics</dcterms:contributor>
        <dcterms:creator xml:lang="en-us">Product Service System (PSS) working group</dcterms:creator>
        <dcterms:license rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://opensource.org/licenses/MIT</dcterms:license>
        <dcterms:publisher>Industrial Ontology Foundry</dcterms:publisher>
        <dcterms:title>Product Service System (PSS) Reference Ontology</dcterms:title>
        <rdfs:label xml:lang="en-us">Sensor Ontology</rdfs:label>
        <iof-av:copyright>Copyright (c) 2025 Open Applications Group</iof-av:copyright>
        <iof-av:maturity rdf:resource="https://spec.industrialontologies.org/ontology/individual/Provisional"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2002/07/owl#minQualifiedCardinality -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#minQualifiedCardinality"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://spec.industrialontologies.org/ontology/construct/owns -->

    <owl:ObjectProperty rdf:about="https://spec.industrialontologies.org/ontology/construct/owns">
        <skos:example>PSSProvider owns a PSS (inverse to PSS belongsTo PSSProvider)</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://www.omg.org/spec/Commons/Collections/isPartOf -->

    <owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/Collections/isPartOf">
        <rdfs:label xml:lang="en-us">is part of</rdfs:label>
        <iof-av:naturalLanguageDefinition>relates something to another thing that it is some component or portion of, regardless of how that whole-part relationship is manifested</iof-av:naturalLanguageDefinition>
        <iof-av:naturalLanguageDefinition xml:lang="en-us">relates something to another thing that it is some component or portion of, regardless of how that whole-part relationship is manifested</iof-av:naturalLanguageDefinition>
    </owl:ObjectProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://www.omg.org/spec/Commons/Collections/isPartOf"/>
        <owl:annotatedProperty rdf:resource="https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition"/>
        <owl:annotatedTarget>relates something to another thing that it is some component or portion of, regardless of how that whole-part relationship is manifested</owl:annotatedTarget>
        <rdfs:comment>Stanford Encyclopedia of Philosophy at http://plato.stanford.edu/entries/mereology/</rdfs:comment>
    </owl:Axiom>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://spec.industrialontologies.org/ontology/construct/DetectingFunction -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DetectingFunction">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000034"/>
        <rdfs:label xml:lang="en-us">signaling function</rdfs:label>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/DetectingProcess -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DetectingProcess">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ObservingProcess"/>
        <rdfs:label xml:lang="en-us">detecting process</rdfs:label>
        <iof-av:naturalLanguageDefinition>a process that discovers or determines the existence, presence, or fact of some entity</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/Detector -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/Detector">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasRole"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/DetectorRole"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/prescribedBy"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/DetectorSpecification"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en-us">detector</rdfs:label>
        <skos:example>litmus paper</skos:example>
        <iof-av:naturalLanguageDefinition>a device or instrument designed to detect the presence of a particular object or substance and to emit a signal in response</iof-av:naturalLanguageDefinition>
        <iof-av:semiFormalNaturalLanguageDefinition>material artifact that bears a detector role</iof-av:semiFormalNaturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/DetectorRole -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DetectorRole">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:label xml:lang="en-us">detector role</rdfs:label>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/DetectorSpecification -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/DetectorSpecification">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/prescribes"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/Detector"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en-us">detector specification</rdfs:label>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/Facility -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/Facility"/>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/MonitoringProcess -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/MonitoringProcess">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
        <rdfs:label xml:lang="en-us">monitoring process</rdfs:label>
        <iof-av:explanatoryNote>goes along a timeline, it&apos;s a tracking process, following a value along time during the process time</iof-av:explanatoryNote>
        <iof-av:naturalLanguageDefinition>check Biopharma definition</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/Observation -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/Observation">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isOutputOf"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/ObservingProcess"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en-us">observation</rdfs:label>
        <iof-av:naturalLanguageDefinition>an information content entity that represents a remark, statement, or comment based on something one has seen, heard, or noticed by an Observer</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/Observer -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/Observer">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/isSubjectOf"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/Observation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en-us">observer</rdfs:label>
        <iof-av:naturalLanguageDefinition>a person or a system that watches or notices or measures something to gain information</iof-av:naturalLanguageDefinition>
        <iof-av:naturalLanguageDefinition>an entity that can perceive (be aware) something by distinguishing it from other entities in its environment and is aware of it context</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ObservingCapability -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ObservingCapability">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/Capability"/>
        <rdfs:label xml:lang="en-us">observing capability</rdfs:label>
        <iof-av:naturalLanguageDefinition></iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/ObservingProcess -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/ObservingProcess">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasOutput"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/Observation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en-us">observing process</rdfs:label>
        <iof-av:naturalLanguageDefinition>a process executed by an observer which may produce an ‘Observation’</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/Pressure -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/Pressure">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/SensingFunction -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/SensingFunction">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000034"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/SensingProcess"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/functionOf"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/Sensor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en-us">sensing function</rdfs:label>
        <iof-av:explanatoryNote>a sensing function might inhere in different entities: a machine, in lots of different things of different kinds…</iof-av:explanatoryNote>
        <iof-av:naturalLanguageDefinition></iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/SensingProcess -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/SensingProcess">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ObservingProcess"/>
        <rdfs:label xml:lang="en-us">sensing process</rdfs:label>
        <iof-av:naturalLanguageDefinition>a process to detect especially in response to a stimulus</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/Sensor -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/Sensor">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasRole"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/SensorRole"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/prescribedBy"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/SensorSpecification"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment>From SSN: A sensor can do (implements) sensing: that is, a sensor is any entity that can follow a sensing method and thus observe some Property of a  FeatureOfInterest. Sensors may be physical devices, computational methods, a laboratory setup with a person following a method, or any other thing that can follow a Sensing Method to observe a Property.
https://www.w3.org/2005/Incubator/ssn/wiki/SSN.html#Sensor</rdfs:comment>
        <rdfs:comment>provides physical property?</rdfs:comment>
        <rdfs:label xml:lang="en-us">sensor</rdfs:label>
        <iof-av:explanatoryNote>We are thinking here about physical sensor not virtual sensors/soft sensor</iof-av:explanatoryNote>
        <iof-av:naturalLanguageDefinition>an entity that responds to changes in its environment and is not aware of its context</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/SensorMeasurementProcess -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/SensorMeasurementProcess">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MeasurementProcess"/>
        <rdfs:label xml:lang="en-us">sensor measurement process</rdfs:label>
        <iof-av:naturalLanguageDefinition>measurement of the value of an attribute of a sensor</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/SensorRole -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/SensorRole">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/roleOf"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en-us">sensor role</rdfs:label>
        <iof-av:explanatoryNote>this role may be held by entities other than sensors</iof-av:explanatoryNote>
        <iof-av:naturalLanguageDefinition>role held by an entity that responds to changes in its environment and is not aware of its context</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/SensorSpecification -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/SensorSpecification">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/prescribes"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/Sensor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en-us">specification of a sensor - are ranges and accuracy defined here as properties?</rdfs:comment>
        <rdfs:label xml:lang="en-us">sensor specification</rdfs:label>
        <iof-av:naturalLanguageDefinition></iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/Temperature -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/Temperature">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/TransducerRole -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/TransducerRole">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:label xml:lang="en-us">transducer role</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en-us">role held by an entity that responds to changes in its environment</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/TransducerSpecification -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/TransducerSpecification">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/InformationContentEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/prescribes"/>
                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/Transducer/Transducer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en-us">transducer specification</rdfs:label>
        <iof-av:naturalLanguageDefinition></iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/Vibration -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/Vibration">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/Transducer/Transducer -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/Transducer/Transducer">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasRole"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/TransducerRole"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/prescribedBy"/>
                        <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/TransducerSpecification"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en-us">transducer</rdfs:label>
        <skos:example>Any device by which variations in one physical quantity (e.g. pressure, brightness) are quantitatively converted into variations in another (e.g. voltage, position)</skos:example>
        <skos:example xml:lang="en-us">a loudspeaker that transforms electrical energy into sound energy</skos:example>
        <iof-av:naturalLanguageDefinition xml:lang="en-us">device for transforming energy between two different forms</iof-av:naturalLanguageDefinition>
        <iof-av:semiFormalNaturalLanguageDefinition>material artifact that bears a transducer role</iof-av:semiFormalNaturalLanguageDefinition>
    </owl:Class>
    <rdf:Description>
        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </rdf:Description>
</rdf:RDF>



