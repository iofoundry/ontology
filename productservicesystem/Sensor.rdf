<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE rdf:RDF [
	<!ENTITY CommonCoreOntologies "http://www.ontologyrepository.com/CommonCoreOntologies/">
	<!ENTITY bfo "http://purl.obolibrary.org/obo/">
	<!ENTITY dc "http://purl.org/dc/elements/1.1/">
	<!ENTITY dcterms "http://purl.org/dc/terms/">
	<!ENTITY iof-av "https://spec.industrialontologies.org/ontology/annotation/">
	<!ENTITY iof-const "https://spec.industrialontologies.org/ontology/construct/">
	<!ENTITY iof-ind "https://spec.industrialontologies.org/ontology/individual/">
	<!ENTITY owl "http://www.w3.org/2002/07/owl#">
	<!ENTITY rdf "http://www.w3.org/1999/02/22-rdf-syntax-ns#">
	<!ENTITY rdfs "http://www.w3.org/2000/01/rdf-schema#">
	<!ENTITY skos "http://www.w3.org/2004/02/skos/core#">
	<!ENTITY xsd "http://www.w3.org/2001/XMLSchema#">
]>
<rdf:RDF xml:base="https://spec.industrialontologies.org/ontology/productservicesystem/Sensor//"
	xmlns="https://spec.industrialontologies.org/ontology/productservicesystem/ProductServiceSystem/Sensor#"
	xmlns:CommonCoreOntologies="http://www.ontologyrepository.com/CommonCoreOntologies/"
	xmlns:bfo="http://purl.obolibrary.org/obo/"
	xmlns:dc="http://purl.org/dc/elements/1.1/"
	xmlns:dcterms="http://purl.org/dc/terms/"
	xmlns:iof-av="https://spec.industrialontologies.org/ontology/annotation/"
	xmlns:iof-const="https://spec.industrialontologies.org/ontology/construct/"
	xmlns:iof-ind="https://spec.industrialontologies.org/ontology/individual/"
	xmlns:owl="http://www.w3.org/2002/07/owl#"
	xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
	xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
	xmlns:skos="http://www.w3.org/2004/02/skos/core#"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
	
	<owl:Ontology rdf:about="https://spec.industrialontologies.org/ontology/productservicesystem/Sensor//">
		<rdfs:label xml:lang="en-US">Sensor Ontology</rdfs:label>
		<dcterms:abstract>This module contains terms and relations necessary for representing basic sensor entities.</dcterms:abstract>
		<dcterms:contributor>Ana Teresa Correia, Institut fuer angewandte Systemtechnik Bremen GmbH (ATB-Bremen)</dcterms:contributor>
		<dcterms:contributor>Dragan Stokic, Institut fuer angewandte Systemtechnik Bremen GmbH (ATB-Bremen)</dcterms:contributor>
		<dcterms:contributor>Dusan Sormaz, Ohio University</dcterms:contributor>
		<dcterms:contributor>Gabriela Henning, CONICET</dcterms:contributor>
		<dcterms:contributor>Jim Logan, Ontogenesis</dcterms:contributor>
		<dcterms:contributor>Marcela Vegetti, University of Santa Fe</dcterms:contributor>
		<dcterms:contributor>Mark Schubert, Parson Europe</dcterms:contributor>
		<dcterms:contributor>Roberto Sala, University of Bergamo</dcterms:contributor>
		<dcterms:contributor>Todd Schneider, Engineering Semantics</dcterms:contributor>
		<dcterms:creator xml:lang="en-US">Product Service System (PSS) working group</dcterms:creator>
		<dcterms:license rdf:datatype="&xsd;anyURI">http://opensource.org/licenses/MIT</dcterms:license>
		<dcterms:publisher>Industrial Ontology Foundry</dcterms:publisher>
		<dcterms:title>Sensor Module Ontology</dcterms:title>
		<owl:imports rdf:resource="https://spec.industrialontologies.org/ontology/core/Core/"/>
		<owl:imports rdf:resource="https://spec.industrialontologies.org/ontology/supplychain/SupplyChain/"/>
		<owl:versionIRI rdf:resource="https://spec.industrialontologies.org/ontology/202603/productservicesystem/Sensor/"/>
		<iof-av:copyright>Copyright (c) 2022, 2023, 2024, 2025, 2026 Open Applications Group</iof-av:copyright>
		<iof-av:maturity rdf:resource="&iof-ind;Provisional"/>
	</owl:Ontology>
	
	<owl:AnnotationProperty rdf:about="&owl;minQualifiedCardinality">
	</owl:AnnotationProperty>
	
	<owl:Class rdf:about="&iof-const;DetectingFunction">
		<rdfs:subClassOf rdf:resource="&bfo;BFO_0000034"/>
		<rdfs:label xml:lang="en-US">signaling function</rdfs:label>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/productservicesystem/Sensor/</rdfs:isDefinedBy>
		<iof-av:naturalLanguageDefinition xml:lang="en-US">signaling is the funtion that provides information</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-const;DetectingProcess">
		<rdfs:subClassOf rdf:resource="&iof-const;ObservingProcess"/>
		<rdfs:label xml:lang="en-US">detecting process</rdfs:label>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/productservicesystem/Sensor/</rdfs:isDefinedBy>
		<iof-av:naturalLanguageDefinition>a process that discovers or determines the existence, presence, or fact of some entity</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-const;Detector">
		<rdfs:label xml:lang="en-US">detector</rdfs:label>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/productservicesystem/Sensor/</rdfs:isDefinedBy>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&bfo;BFO_0000040">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&iof-const;hasRole"/>
						<owl:someValuesFrom rdf:resource="&iof-const;DetectorRole"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:example>litmus paper</skos:example>
		<iof-av:naturalLanguageDefinition>a device or instrument designed to detect the presence of a particular object or substance and to emit a signal in response</iof-av:naturalLanguageDefinition>
		<iof-av:semiFormalNaturalLanguageDefinition>material artifact that bears a detector role</iof-av:semiFormalNaturalLanguageDefinition>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-const;DetectorRole">
		<rdfs:subClassOf rdf:resource="&bfo;BFO_0000023"/>
		<rdfs:label xml:lang="en-US">detector role</rdfs:label>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/productservicesystem/Sensor/</rdfs:isDefinedBy>
		<iof-av:naturalLanguageDefinition xml:lang="en-US">role held by an entity that is designed to detect the presence of a particular object or substance and to emit a signal in response</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-const;DetectorSpecification">
		<rdfs:subClassOf rdf:resource="&iof-const;DesignSpecification"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&iof-const;prescribes"/>
				<owl:allValuesFrom rdf:resource="&iof-const;Detector"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label xml:lang="en-US">detector specification</rdfs:label>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/productservicesystem/Sensor/</rdfs:isDefinedBy>
		<iof-av:naturalLanguageDefinition>design specification that prescribes only a detector</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-const;Facility">
	</owl:Class>
	
	<owl:Class rdf:about="&iof-const;MonitoringProcess">
		<rdfs:subClassOf rdf:resource="&iof-const;PlannedProcess"/>
		<rdfs:label xml:lang="en-US">monitoring process</rdfs:label>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/biopharma/BiopharmaMonitoringAndControl/</rdfs:isDefinedBy>
		<iof-av:explanatoryNote>goes along a timeline, it&apos;s a tracking process, following a value along time during the process time</iof-av:explanatoryNote>
		<iof-av:naturalLanguageDefinition xml:lang="en-US">planned process that is a part of another planned process and that consists of one or more observation or measurement processes in which a particular attribute (specifically dependent continuant or temporal region or process characteristic or process profile) of some entity of interest is measured or observed</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-const;Observation">
		<rdfs:subClassOf rdf:resource="&iof-const;InformationContentEntity"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&iof-const;isOutputOf"/>
				<owl:someValuesFrom rdf:resource="&iof-const;ObservingProcess"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label xml:lang="en-US">observation</rdfs:label>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/productservicesystem/Sensor/</rdfs:isDefinedBy>
		<iof-av:naturalLanguageDefinition>an information content entity that represents a remark, statement, or comment based on something one has seen, heard, or noticed by an Observer</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-const;Observer">
		<rdfs:subClassOf rdf:resource="&bfo;BFO_0000040"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&iof-const;isSubjectOf"/>
				<owl:someValuesFrom rdf:resource="&iof-const;Observation"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label xml:lang="en-US">observer</rdfs:label>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/productservicesystem/Sensor/</rdfs:isDefinedBy>
		<skos:example>a person or a system that watches or notices or measures something to gain information</skos:example>
		<iof-av:naturalLanguageDefinition>an entity that can perceive (be aware) something by distinguishing it from other entities in its environment and is aware of it context</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-const;ObservingCapability">
		<rdfs:subClassOf rdf:resource="&iof-const;Capability"/>
		<rdfs:label xml:lang="en-US">observing capability</rdfs:label>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/productservicesystem/Sensor/</rdfs:isDefinedBy>
		<iof-av:naturalLanguageDefinition></iof-av:naturalLanguageDefinition>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-const;ObservingProcess">
		<rdfs:subClassOf rdf:resource="&iof-const;PlannedProcess"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&iof-const;hasOutput"/>
				<owl:someValuesFrom rdf:resource="&iof-const;Observation"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label xml:lang="en-US">observing process</rdfs:label>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/productservicesystem/Sensor/</rdfs:isDefinedBy>
		<iof-av:naturalLanguageDefinition>a process executed by an observer which may produce an ‘Observation’</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-const;SensingFunction">
		<rdfs:subClassOf rdf:resource="&bfo;BFO_0000034"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&bfo;BFO_0000054"/>
				<owl:someValuesFrom rdf:resource="&iof-const;SensingProcess"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&iof-const;functionOf"/>
				<owl:someValuesFrom rdf:resource="&iof-const;Sensor"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label xml:lang="en-US">sensing function</rdfs:label>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/productservicesystem/Sensor/</rdfs:isDefinedBy>
		<iof-av:explanatoryNote>a sensing function might inhere in different entities: a machine, in lots of different things of different kinds…</iof-av:explanatoryNote>
		<iof-av:naturalLanguageDefinition xml:lang="en-US">the function of reacting to the environment</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-const;SensingProcess">
		<rdfs:subClassOf rdf:resource="&iof-const;ObservingProcess"/>
		<rdfs:label xml:lang="en-US">sensing process</rdfs:label>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/productservicesystem/Sensor/</rdfs:isDefinedBy>
		<iof-av:naturalLanguageDefinition>a process to detect especially in response to a stimulus</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-const;Sensor">
		<rdfs:label xml:lang="en-US">sensor</rdfs:label>
		<rdfs:comment>From SSN: A sensor can do (implements) sensing: that is, a sensor is any entity that can follow a sensing method and thus observe some Property of a  FeatureOfInterest. Sensors may be physical devices, computational methods, a laboratory setup with a person following a method, or any other thing that can follow a Sensing Method to observe a Property.
https://www.w3.org/2005/Incubator/ssn/wiki/SSN.html#Sensor</rdfs:comment>
		<rdfs:comment>provides physical property?</rdfs:comment>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/productservicesystem/Sensor/</rdfs:isDefinedBy>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&bfo;BFO_0000040">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&iof-const;hasRole"/>
						<owl:someValuesFrom rdf:resource="&iof-const;SensorRole"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<iof-av:explanatoryNote>We are thinking here about physical sensor not virtual sensors/soft sensor</iof-av:explanatoryNote>
		<iof-av:naturalLanguageDefinition>an entity that responds to changes in its environment</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-const;SensorMeasurementProcess">
		<rdfs:subClassOf rdf:resource="&iof-const;MeasurementProcess"/>
		<rdfs:label xml:lang="en-US">sensor measurement process</rdfs:label>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/productservicesystem/Sensor/</rdfs:isDefinedBy>
		<iof-av:naturalLanguageDefinition>measurement of the value of an attribute of a sensor</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-const;SensorRole">
		<rdfs:subClassOf rdf:resource="&bfo;BFO_0000023"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&iof-const;roleOf"/>
				<owl:someValuesFrom rdf:resource="&bfo;BFO_0000040"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label xml:lang="en-US">sensor role</rdfs:label>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/productservicesystem/Sensor/</rdfs:isDefinedBy>
		<iof-av:explanatoryNote>this role may be held by entities other than sensors</iof-av:explanatoryNote>
		<iof-av:naturalLanguageDefinition xml:lang="en-US">role held by an entity that responds to changes in its environment</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-const;SensorSpecification">
		<rdfs:subClassOf rdf:resource="&iof-const;DesignSpecification"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&iof-const;prescribes"/>
				<owl:allValuesFrom rdf:resource="&iof-const;Sensor"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label xml:lang="en-US">sensor specification</rdfs:label>
		<rdfs:comment xml:lang="en-US">specification of a sensor - are ranges and accuracy defined here as properties?</rdfs:comment>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/productservicesystem/Sensor/</rdfs:isDefinedBy>
		<iof-av:naturalLanguageDefinition>design specification that prescribes only a sensor</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-const;Transducer">
		<rdfs:label xml:lang="en-US">transducer</rdfs:label>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/productservicesystem/Sensor/</rdfs:isDefinedBy>
		<owl:equivalentClass>
			<owl:Class>
				<owl:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="&bfo;BFO_0000040">
					</rdf:Description>
					<owl:Restriction>
						<owl:onProperty rdf:resource="&iof-const;hasRole"/>
						<owl:someValuesFrom rdf:resource="&iof-const;TransducerRole"/>
					</owl:Restriction>
				</owl:intersectionOf>
			</owl:Class>
		</owl:equivalentClass>
		<skos:example>Any device by which variations in one physical quantity (e.g. pressure, brightness) are quantitatively converted into variations in another (e.g. voltage, position)</skos:example>
		<skos:example xml:lang="en-US">a loudspeaker that transforms electrical energy into sound energy</skos:example>
		<iof-av:naturalLanguageDefinition xml:lang="en-US">device for transforming energy between two different forms</iof-av:naturalLanguageDefinition>
		<iof-av:semiFormalNaturalLanguageDefinition>material artifact that bears a transducer role</iof-av:semiFormalNaturalLanguageDefinition>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-const;TransducerRole">
		<rdfs:subClassOf rdf:resource="&bfo;BFO_0000023"/>
		<rdfs:label xml:lang="en-US">transducer role</rdfs:label>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/productservicesystem/Sensor/</rdfs:isDefinedBy>
		<iof-av:naturalLanguageDefinition xml:lang="en-US">role held by an entity that transforms energy between two different forms</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
	<owl:Class rdf:about="&iof-const;TransducerSpecification">
		<rdfs:subClassOf rdf:resource="&iof-const;DesignSpecification"/>
		<rdfs:subClassOf>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&iof-const;prescribes"/>
				<owl:allValuesFrom rdf:resource="&iof-const;Transducer"/>
			</owl:Restriction>
		</rdfs:subClassOf>
		<rdfs:label xml:lang="en-US">transducer specification</rdfs:label>
		<rdfs:isDefinedBy>https://spec.industrialontologies.org/ontology/productservicesystem/Sensor/</rdfs:isDefinedBy>
		<iof-av:naturalLanguageDefinition>design specification that prescribes only a transducer</iof-av:naturalLanguageDefinition>
	</owl:Class>
	
	<owl:ObjectProperty rdf:about="&iof-const;owns">
		<skos:example>PSSProvider owns a PSS (inverse to PSS belongsTo PSSProvider)</skos:example>
	</owl:ObjectProperty>
	
	<owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/Collections/isPartOf">
		<rdfs:label xml:lang="en-US">is part of</rdfs:label>
		<iof-av:naturalLanguageDefinition xml:lang="en-US">relates something to another thing that it is some component or portion of, regardless of how that whole-part relationship is manifested</iof-av:naturalLanguageDefinition>
		<iof-av:naturalLanguageDefinition>relates something to another thing that it is some component or portion of, regardless of how that whole-part relationship is manifested</iof-av:naturalLanguageDefinition>
	</owl:ObjectProperty>
	
	<owl:Axiom>
		<rdfs:comment>Stanford Encyclopedia of Philosophy at http://plato.stanford.edu/entries/mereology/</rdfs:comment>
		<owl:annotatedProperty rdf:resource="&iof-av;naturalLanguageDefinition"/>
		<owl:annotatedSource rdf:resource="https://www.omg.org/spec/Commons/Collections/isPartOf"/>
		<owl:annotatedTarget>relates something to another thing that it is some component or portion of, regardless of how that whole-part relationship is manifested</owl:annotatedTarget>
	</owl:Axiom>
	<owl:Class>
		<rdfs:subClassOf rdf:resource="&iof-const;Detector"/>
		<owl:intersectionOf rdf:parseType="Collection">
			<rdf:Description rdf:about="&iof-const;MaterialArtifact">
			</rdf:Description>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&iof-const;prescribedBy"/>
				<owl:someValuesFrom rdf:resource="&iof-const;DetectorSpecification"/>
			</owl:Restriction>
		</owl:intersectionOf>
	</owl:Class>
	<owl:Class>
		<rdfs:subClassOf rdf:resource="&iof-const;Sensor"/>
		<owl:intersectionOf rdf:parseType="Collection">
			<rdf:Description rdf:about="&iof-const;MaterialArtifact">
			</rdf:Description>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&iof-const;prescribedBy"/>
				<owl:someValuesFrom rdf:resource="&iof-const;SensorSpecification"/>
			</owl:Restriction>
		</owl:intersectionOf>
	</owl:Class>
	<owl:Class>
		<rdfs:subClassOf rdf:resource="&iof-const;Transducer"/>
		<owl:intersectionOf rdf:parseType="Collection">
			<rdf:Description rdf:about="&iof-const;MaterialArtifact">
			</rdf:Description>
			<owl:Restriction>
				<owl:onProperty rdf:resource="&iof-const;prescribedBy"/>
				<owl:someValuesFrom rdf:resource="&iof-const;TransducerSpecification"/>
			</owl:Restriction>
		</owl:intersectionOf>
	</owl:Class>
	<rdf:Description>
		<owl:minQualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:minQualifiedCardinality>
	</rdf:Description>
</rdf:RDF>