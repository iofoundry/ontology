                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/PredictiveMaintenanceServiceAgreement"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en-us">predictive maintenance service</rdfs:label>
    </owl:Class>
    


