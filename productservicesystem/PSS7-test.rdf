    <!-- https://spec.industrialontologies.org/ontology/construct/CorrectiveMaintenanceStrategy -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/CorrectiveMaintenanceStrategy">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaintenanceStrategy"/>
        <owl:disjointWith rdf:resource="https://spec.industrialontologies.org/ontology/construct/PreventiveMaintenanceStrategy"/>
        <rdfs:label xml:lang="en-us">corrective maintenance strategy</rdfs:label>
        <annotation:naturalLanguageDefinition>maintenance stragegy to be carried out after the detection of a failure and intended to restore an asset to a state in which it can fulfill a required function</annotation:naturalLanguageDefinition>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://spec.industrialontologies.org/ontology/construct/CorrectiveMaintenanceStrategy"/>
        <owl:annotatedProperty rdf:resource="https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition"/>
        <owl:annotatedTarget>maintenance stragegy to be carried out after the detection of a failure and intended to restore an asset to a state in which it can fulfill a required function</owl:annotatedTarget>
        <rdfs:comment>https://de.scribd.com/document/913920638/NF-EN-13306-Terminology-of-Maintenance</rdfs:comment>
    </owl:Axiom>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/PredictiveMaintenanceComputingProcess -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/PredictiveMaintenanceComputingProcess">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/ComputingProcess"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasInput"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://spec.industrialontologies.org/ontology/construct/MeasurementInformationContentEntity"/>
                            <owl:Restriction>
                                <owl:onProperty>
                                    <rdf:Description>
                                        <owl:inverseOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput"/>
                                    </rdf:Description>
                                </owl:onProperty>
                                <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MeasurementProcess"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en-us">predictive maintenance computing process</rdfs:label>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/PredictiveMaintenanceServiceAgreement -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/PredictiveMaintenanceServiceAgreement">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/CommercialServiceAgreement"/>
        <rdfs:label xml:lang="en-us">predictive maintenance service agreement</rdfs:label>
    </owl:Class>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/PredictiveMaintenanceStrategy -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/PredictiveMaintenanceStrategy">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PreventiveMaintenanceStrategy"/>
        <rdfs:label xml:lang="en-us">predictive maintenance strategy</rdfs:label>
        <skos:editorialNote>From NIST: 
A maintenance strategy that uses condition monitoring, sensor data, and analytics to predict equipment degradation and schedule maintenance tasks only when warranted (before failure occurs)</skos:editorialNote>
        <annotation:naturalLanguageDefinition>maintenance strategy where maintenance actions are forecasted and scheduled based on the calculated future condition of an asset, derived from the continuous monitoring and analysis of its degradation parameters, to optimize objectives</annotation:naturalLanguageDefinition>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://spec.industrialontologies.org/ontology/construct/PredictiveMaintenanceStrategy"/>
        <owl:annotatedProperty rdf:resource="https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition"/>
        <owl:annotatedTarget>maintenance strategy where maintenance actions are forecasted and scheduled based on the calculated future condition of an asset, derived from the continuous monitoring and analysis of its degradation parameters, to optimize objectives</owl:annotatedTarget>
        <rdfs:comment>Source: ISO 14224:2016</rdfs:comment>
        <rdfs:comment>https://www.intechopen.com/chapters/1218838</rdfs:comment>
    </owl:Axiom>
    


    <!-- https://spec.industrialontologies.org/ontology/construct/PreventiveMaintenanceStrategy -->

    <owl:Class rdf:about="https://spec.industrialontologies.org/ontology/construct/PreventiveMaintenanceStrategy">
        <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaintenanceStrategy"/>
        <rdfs:label xml:lang="en-us">preventive maintenance strategy</rdfs:label>
        <annotation:naturalLanguageDefinition>maintenance strategy to be carried out at predetermined intervals or according to prescribed criteria and aimed at reducing the probability of failure or degradation of the functioning of an asset</annotation:naturalLanguageDefinition>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://spec.industrialontologies.org/ontology/construct/PreventiveMaintenanceStrategy"/>
        <owl:annotatedProperty rdf:resource="https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition"/>
        <owl:annotatedTarget>maintenance strategy to be carried out at predetermined intervals or according to prescribed criteria and aimed at reducing the probability of failure or degradation of the functioning of an asset</owl:annotatedTarget>
        <rdfs:comment>EN 13306 Maintenance Terminology Overview
https://de.scribd.com/document/913920638/NF-EN-13306-Terminology-of-Maintenance</rdfs:comment>
    </owl:Axiom>
    


